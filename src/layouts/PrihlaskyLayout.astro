---
/**
 * Shell správy webu: novinky, akce a přihlášky. Stejná řeč jako rezervace
 * (tmavý pruh s nadpisem, lišta pod ním). V liště jsou i odkazy na správu
 * rezervací a na redakci textů, ať má stáj všechno z jednoho místa.
 */

import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  heading: string;
  lead?: string;
  /** Přihlášený správce, `null` na přihlašovací stránce. */
  spravce: { email: string; jmeno: string } | null;
  crumbs?: { label: string; href?: string }[];
  uzky?: boolean;
}

const { title, heading, lead, spravce, crumbs = [], uzky = false } = Astro.props;

const cesta = Astro.url.pathname;
const zalozky = [
  { href: '/prihlasky/sprava/novinky', label: 'Novinky', aktivni: cesta.startsWith('/prihlasky/sprava/novinky') },
  {
    href: '/prihlasky/sprava',
    label: 'Akce a přihlášky',
    aktivni: cesta.startsWith('/prihlasky/sprava') && !cesta.startsWith('/prihlasky/sprava/novinky'),
  },
  { href: '/rezervace/sprava', label: 'Rezervace jízdárny', aktivni: false },
];
---

<BaseLayout {title} description="Správa webu Stáje Manon." noindex>
  <div class="grain relative overflow-hidden bg-loden-950 text-white">
    <div class="container-x py-10 lg:py-14">
      <nav aria-label="Drobečková navigace" class="mb-5">
        <ol class="flex flex-wrap items-center gap-2 text-[0.75rem] text-white/55">
          <li><a href="/" class="link-underline hover:text-white">Úvod</a></li>
          <li aria-hidden="true">/</li>
          <li>
            <a href="/prihlasky/sprava" class="link-underline hover:text-white">
              Správa webu
            </a>
          </li>
          {
            crumbs.map((c) => (
              <>
                <li aria-hidden="true">/</li>
                <li>
                  {c.href ? (
                    <a href={c.href} class="link-underline hover:text-white">
                      {c.label}
                    </a>
                  ) : (
                    <span class="text-white/80">{c.label}</span>
                  )}
                </li>
              </>
            ))
          }
        </ol>
      </nav>

      <h1 class="t-1 max-w-3xl text-white">{heading}</h1>
      {lead && <p class="lead mt-4 max-w-2xl text-white/70">{lead}</p>}
    </div>
  </div>

  {
    spravce && (
      <div class="border-b border-ink/12 bg-paper-2">
        <div class="container-x flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-3">
          <nav aria-label="Správa webu" class="flex flex-wrap gap-x-6 gap-y-2">
            {zalozky.map((z) => (
              <a
                href={z.href}
                aria-current={z.aktivni ? 'page' : undefined}
                class:list={[
                  'text-[0.8125rem] font-semibold uppercase tracking-[0.1em] transition-colors',
                  z.aktivni ? 'text-brass-700' : 'text-ink-3 hover:text-ink',
                ]}
              >
                {z.label}
              </a>
            ))}
          </nav>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[0.8125rem]">
            <a
              href="/keystatic"
              class="text-ink-3 transition-colors hover:text-brass-700"
              title="Texty a fotky jednotlivých stránek (přihlášení e-mailem přes Keystatic Cloud)"
            >
              Texty webu
            </a>
            <span class="text-ink/20" aria-hidden="true">|</span>
            <span class="text-ink-3">{spravce.jmeno || spravce.email}</span>
            <form method="post" action="/prihlasky/odhlaseni">
              <button
                type="submit"
                class="font-semibold uppercase tracking-[0.1em] text-ink-3 transition-colors hover:text-brass-700"
              >
                Odhlásit
              </button>
            </form>
          </div>
        </div>
      </div>
    )
  }

  <div class="bg-paper py-10 lg:py-14">
    <div class:list={['container-x', uzky && 'max-w-2xl']}>
      <slot />
    </div>
  </div>
</BaseLayout>
