  plus: 'M12 5v14M5 12h14',
  minus: 'M5 12h14',
  x: 'm6 6 12 12M18 6 6 18',
} as const;

export type IconName = keyof typeof paths;

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = 'h-5 w-5', strokeWidth = 1.75 } = Astro.props;
const raw = paths[name];
const filled = raw.startsWith('FILL:');
const segments = (filled ? raw.slice(5) : raw).split('|');
---

<svg
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width={filled ? undefined : strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {
    segments.map((seg) => {
      if (seg.startsWith('circle:')) {
        const [cx, cy, r] = seg.slice(7).split(',');
        return <circle cx={cx} cy={cy} r={r} />;
      }
      return <path d={seg} />;
    })
  }
</svg>
