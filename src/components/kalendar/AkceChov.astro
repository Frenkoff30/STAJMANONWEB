---
/**
 * Chovatelské akce na stránce odchovny: nadcházející i proběhlé (ty
 * zašedlé). Server island, data z databáze jako celý kalendář.
 */

import { formatLong, isUpcoming } from '@/data/events';
import { CACHE_KALENDARE, nactiKalendar } from '@/lib/kalendar';

interface Props {
  /** Věta, když žádná chovatelská akce není naplánovaná. */
  prazdno: string;
}

Astro.response.headers.set('Cache-Control', CACHE_KALENDARE);

const chovEvents = (await nactiKalendar()).filter((e) => e.kind === 'chov');
const upcoming = chovEvents.filter((e) => isUpcoming(e));
---

<ul class="mt-10 space-y-px">
  {
    chovEvents.map((e, i) => {
      const future = isUpcoming(e);
      return (
        <li
          class:list={[
            'grid gap-3 border-t border-ink/12 py-7 last:border-b sm:grid-cols-[auto_1fr_auto] sm:items-baseline sm:gap-8',
            !future && 'opacity-50',
          ]}
          data-reveal
          style={`--reveal-delay:${i * 70}ms`}
        >
          <div>
            <h2 class="font-display text-[1.375rem] leading-snug sm:text-[1.625rem]">
              {e.title}
            </h2>
            {e.detail && <p class="mt-1.5 text-[0.875rem] text-ink-3">{e.detail}</p>}
          </div>
          <span class="text-[0.9375rem] text-brass-700 sm:text-right">
            {formatLong(e.start)}
          </span>
        </li>
      );
    })
  }
</ul>

{
  upcoming.length === 0 && (
    <p class="mt-10 border border-ink/12 bg-white p-8 text-ink-3">{Astro.props.prazdno}</p>
  )
}
