---
/**
 * Termíny prázdninových kurzů na stránce /kurzy. Server island: bere
 * nadcházející akce druhu „Tábor“ ze Správy webu, takže stáj tábor
 * založí jednou jako akci a termín se tu ukáže sám i s přihláškou.
 *
 * Volno / obsazeno se řídí přepínačem „Přihlášky otevřené“ u akce.
 */

import Icon from '@/components/Icon.astro';
import { formatRange, isUpcoming } from '@/data/events';
import { site } from '@/data/site';
import { CACHE_KALENDARE } from '@/lib/kalendar';
import { prihlaskyNastaveny, verejnyKlient } from '@/lib/prihlasky/db';

Astro.response.headers.set('Cache-Control', CACHE_KALENDARE);

interface Tabor {
  kod: string;
  nazev: string;
  podtitul: string;
  zacatek: string;
  konec: string;
  otevreno: boolean;
  prihlasovani: boolean;
}

let tabory: Tabor[] = [];
if (prihlaskyNastaveny) {
  const { data } = await verejnyKlient()
    .from('akce')
    .select('kod, nazev, podtitul, zacatek, konec, otevreno, prihlasovani')
    .eq('druh', 'tabor')
    .order('zacatek', { ascending: true });
  tabory = (data as Tabor[] | null) ?? [];
}

const udalost = (t: Tabor) => ({
  start: t.zacatek,
  end: t.konec !== t.zacatek ? t.konec : undefined,
  title: t.nazev,
  kind: 'tabor' as const,
});

const nadchazejici = tabory.filter((t) => isUpcoming(udalost(t)));

const volne = (t: Tabor) => t.prihlasovani && t.otevreno;
---

{
  nadchazejici.length === 0 ? (
    <p class="mt-10 border border-ink/12 bg-white p-8 text-ink-3">
      Termíny na další prázdniny právě připravujeme. Napište nám na{' '}
      <a href={`mailto:${site.email}`} class="link-underline text-brass-700">
        {site.email}
      </a>{' '}
      a ozveme se, jakmile budou.
    </p>
  ) : (
    <ul class="mt-10 space-y-px">
      {nadchazejici.map((t, i) => (
        <li
          class:list={[
            'grid grid-cols-[auto_1fr] items-center gap-x-5 gap-y-2 border-t border-ink/12 py-6 last:border-b sm:grid-cols-[auto_1fr_auto_auto] sm:gap-8',
            !volne(t) && 'opacity-55',
          ]}
          data-reveal
          style={`--reveal-delay:${i * 55}ms`}
        >
          <span class="text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-brass-700">
            {t.nazev}
          </span>

          <div class="min-w-0">
            <p class="font-display text-[1.25rem] leading-snug sm:text-[1.5rem]">
              {formatRange(udalost(t))}
            </p>
            {t.podtitul && <p class="mt-1 text-[0.875rem] text-ink-3">{t.podtitul}</p>}
          </div>

          <span
            class:list={[
              'col-span-2 justify-self-start px-3 py-1.5 text-[0.6875rem] font-semibold uppercase tracking-[0.12em] sm:col-span-1 sm:justify-self-end',
              volne(t) ? 'bg-loden-800 text-paper' : 'bg-ink/10 text-ink-3',
            ]}
          >
            {volne(t) ? 'Volná místa' : 'Obsazeno'}
          </span>

          <div class="col-span-2 sm:col-span-1 sm:w-40 sm:text-right">
            {volne(t) ? (
              <a href={`/prihlaska/${t.kod}`} class="link-arrow sm:justify-end">
                Vyplnit přihlášku
                <Icon name="arrow-right" class="h-3.5 w-3.5" />
              </a>
            ) : (
              <span class="text-[0.75rem] uppercase tracking-[0.12em] text-ink-3/60">·</span>
            )}
          </div>
        </li>
      ))}
    </ul>
  )
}
