---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, partners, usefulLinks } from '@/data/site';
import { footerNav } from '@/data/navigation';

const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-loden-950 text-white grain">
  <div class="container-x relative z-10 pt-20 lg:pt-28">
    <!-- Horní blok: značka + CTA -->
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5">
        <Logo />
        <p class="mt-6 max-w-sm text-[0.9375rem] leading-relaxed text-white/65">
          Sportovní stáj, jezdecká škola a penzion v moderním areálu tři kilometry
          od Litomyšle. Od roku 1992.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={site.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-11 w-11 items-center justify-center border border-white/20 transition-colors hover:border-brass-400 hover:bg-brass-600"
            aria-label="Stáj Manon na Facebooku"
          >
            <Icon name="facebook" class="h-4 w-4" />
          </a>
          <a
            href={site.social.facebookKlub}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-11 items-center justify-center gap-2 border border-white/20 px-4 text-[0.75rem] font-semibold uppercase tracking-[0.1em] transition-colors hover:border-brass-400 hover:bg-brass-600"
          >
            <Icon name="facebook" class="h-4 w-4" />
            JK Hřebčín Suchá
          </a>
          <a
            href={site.social.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-11 w-11 items-center justify-center border border-white/20 transition-colors hover:border-brass-400 hover:bg-brass-600"
            aria-label="Stáj Manon na YouTube"
          >
            <Icon name="youtube" class="h-4 w-4" />
          </a>
        </div>
      </div>

      <!-- Odkazy -->
      <nav class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-7" aria-label="Patička">
        {
          footerNav.map((col) => (
            <div>
              <p class="eyebrow eyebrow--on-dark">{col.title}</p>
              <ul class="mt-5 space-y-2.5">
                {col.links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      class="link-underline text-[0.9375rem] text-white/75 transition-colors hover:text-white"
                    >
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="rule-light mt-16"></div>

    <!-- Kontakty -->
    <div class="grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
      {
        site.contacts.map((c) => (
          <div>
            <p class="font-display text-[1.25rem]">{c.name}</p>
            <p class="mt-1 text-[0.8125rem] leading-snug text-white/55">{c.role}</p>
            <a
              href={`tel:${c.phoneHref}`}
              class="link-underline mt-4 inline-block text-[0.9375rem] text-brass-300"
            >
              {c.phone}
            </a>
            <br />
            <a
              href={`mailto:${c.email}`}
              class="link-underline text-[0.875rem] text-white/70"
            >
              {c.email}
            </a>
          </div>
        ))
      }

      <address class="not-italic">
        <p class="font-display text-[1.25rem]">Kde nás najdete</p>
        <p class="mt-1 text-[0.8125rem] leading-snug text-white/55">
          Areál Jízdárna Suchá
        </p>
        <p class="mt-4 text-[0.9375rem] leading-relaxed text-white/80">
          {site.address.street}<br />
          {site.address.zip}&nbsp;{site.address.city}
        </p>
        <a
          href={site.address.directionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="link-arrow mt-4 text-brass-300"
        >
          Navigovat
          <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
        </a>
      </address>
    </div>

    <div class="rule-light"></div>

    <!-- Partneři -->
    <div class="grid gap-8 py-12 md:grid-cols-[auto_1fr] md:gap-16">
      <div>
        <p class="eyebrow eyebrow--on-dark">Partneři</p>
        <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
          {
            partners.map((p) => (
              <li>
                <a
                  href={p.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-underline text-[0.875rem] text-white/70 hover:text-white"
                >
                  {p.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="eyebrow eyebrow--on-dark">Užitečné odkazy</p>
        <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
          {
            usefulLinks.map((p) => (
              <li>
                <a
                  href={p.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-underline text-[0.875rem] text-white/70 hover:text-white"
                >
                  {p.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="rule-light"></div>

    <div
      class="flex flex-col gap-3 py-8 text-[0.8125rem] text-white/45 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.fullName}. Všechna práva vyhrazena.</p>
      <p class="flex flex-wrap items-center gap-x-5 gap-y-1">
        <a href="/kontakt" class="link-underline hover:text-white/80">Kontakt</a>
        <a href="/galerie" class="link-underline hover:text-white/80">Fotogalerie</a>
        <a href="/akce" class="link-underline hover:text-white/80">Kalendář akcí</a>
      </p>
    </div>
  </div>

  <!-- Velký typografický podpis -->
  <div aria-hidden="true" class="relative select-none overflow-hidden">
    <p
      class="translate-y-[22%] whitespace-nowrap text-center font-display text-[18vw] leading-none text-white/[0.045]"
    >
      Stáj Manon
    </p>
  </div>
</footer>
