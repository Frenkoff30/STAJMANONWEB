---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, partners, usefulLinks } from '@/data/site';
import { footerNav } from '@/data/navigation';

const year = new Date().getFullYear();

/** Klub má vlastní web, nebo aspoň Facebook. Když ani to ne, značka neodkazuje nikam. */
const klubWeb = site.social.webKlub || site.social.facebookKlub || '';
---

<footer class="relative overflow-hidden bg-loden-950 text-white grain">
  <div class="container-x relative z-10 py-16 lg:py-20">
    <!-- Značka, navigace, adresa -->
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <Logo class="block h-11" />
        <address class="mt-6 not-italic text-[0.9375rem] leading-relaxed text-white/65">
          {site.address.street}, {site.address.zip}&nbsp;{site.address.city}<br />
          <a href={`tel:${site.phoneHref}`} class="link-underline text-white">
            {site.phone}
          </a>
          <span class="mx-1.5 text-white/30">·</span>
          <a href={`mailto:${site.email}`} class="link-underline text-white">
            {site.email}
          </a>
        </address>

        <div class="mt-6 flex flex-wrap gap-2">
          <a
            href={site.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-10 w-10 items-center justify-center border border-white/20 transition-colors hover:border-brass-400 hover:bg-brass-600"
            aria-label="Stáj Manon na Facebooku"
          >
            <Icon name="facebook" class="h-4 w-4" />
          </a>
          <a
            href={site.social.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-10 w-10 items-center justify-center border border-white/20 transition-colors hover:border-brass-400 hover:bg-brass-600"
            aria-label="Stáj Manon na YouTube"
          >
            <Icon name="youtube" class="h-4 w-4" />
          </a>
          <a
            href="/kontakt"
            class="inline-flex h-10 items-center border border-white/20 px-4 text-[0.75rem] font-semibold uppercase tracking-[0.1em] transition-colors hover:border-brass-400 hover:bg-brass-600"
          >
            Kontakt
          </a>
        </div>

        {/* Pořadatel závodů, her a soustředění. Odkaz vede na stránky klubu,
            pokud nějaké má — jinak stojí značka samostatně. */}
        <div class="mt-10 border-t border-white/12 pt-7">
          <p class="eyebrow eyebrow--on-dark">Pořadatel akcí</p>
          {
            klubWeb ? (
              <a
                href={klubWeb}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-block text-white/70 transition-colors hover:text-white"
              >
                <Logo klub class="block h-24" />
              </a>
            ) : (
              <span class="mt-4 inline-block text-white/70">
                <Logo klub class="block h-24" />
              </span>
            )
          }
        </div>
      </div>

      <nav class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-8" aria-label="Patička">
        {
          footerNav.map((col) => (
            <div>
              <p class="eyebrow eyebrow--on-dark">{col.title}</p>
              <ul class="mt-4 space-y-2">
                {col.links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      class="link-underline text-[0.9375rem] text-white/70 transition-colors hover:text-white"
                    >
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="rule-light mt-14"></div>

    <!-- Partneři a odkazy -->
    <div class="grid gap-6 py-8 md:grid-cols-[auto_1fr] md:gap-14">
      <div>
        <p class="eyebrow eyebrow--on-dark">Partneři</p>
        <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1.5">
          {
            partners.map((p) => (
              <li>
                <a
                  href={p.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-underline text-[0.8125rem] text-white/60 hover:text-white"
                >
                  {p.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="eyebrow eyebrow--on-dark">Odkazy</p>
        <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1.5">
          {
            usefulLinks.map((p) => (
              <li>
                <a
                  href={p.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-underline text-[0.8125rem] text-white/60 hover:text-white"
                >
                  {p.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="rule-light"></div>

    <div
      class="flex flex-col gap-4 pt-6 text-[0.8125rem] text-white/45 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.fullName}</p>

      {/* Vstup do redakčního systému. Nepatří do vyhledávačů ani do mapy webu —
          je to jen zkratka pro stáj, aby nemusela pamatovat adresu /keystatic. */}
      <a
        href="/sprava"
        rel="nofollow"
        class="inline-flex items-center gap-1.5 self-start text-white/35 transition-colors hover:text-white/70 sm:self-auto"
      >
        <Icon name="lock" class="h-3 w-3" />
        Správa webu
      </a>

      <a
        href="https://www.webostudio.cz/"
        target="_blank"
        rel="noopener"
        class="group inline-flex items-center gap-2 self-start transition-colors hover:text-white/70 sm:self-auto"
      >
        <span>Web vytvořilo</span>
        <span
          class="font-display text-[1rem] leading-none text-brass-300 transition-colors group-hover:text-brass-200"
        >
          Webo Studio
        </span>
        <Icon
          name="arrow-up-right"
          class="h-3 w-3 text-brass-300/70 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
        />
      </a>
    </div>
  </div>
</footer>
