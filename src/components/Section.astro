---
interface Props {
  tone?: 'paper' | 'paper-2' | 'white' | 'dark' | 'loden';
  /** Vertikální rytmus */
  space?: 'sm' | 'md' | 'lg';
  id?: string;
  class?: string;
  /** Odstraní vnitřní kontejner (pro full-bleed obsah) */
  bleed?: boolean;
  /**
   * Sekce při scrollování dojede zespodu.
   *
   * Pozor: animace používá `transform`, což vytváří containing block —
   * nezapínat na sekcích, které uvnitř mají `position: sticky`.
   */
  rise?: boolean;
}

const {
  tone = 'paper',
  space = 'md',
  id,
  class: className = '',
  bleed = false,
  rise = false,
} = Astro.props;

const tones: Record<string, string> = {
  paper: 'bg-paper text-ink',
  'paper-2': 'bg-paper-2 text-ink',
  white: 'bg-white text-ink',
  dark: 'bg-loden-950 text-white grain relative overflow-hidden',
  loden: 'bg-loden-900 text-white grain relative overflow-hidden',
};

const spaces: Record<string, string> = {
  sm: 'py-8 lg:py-10',
  md: 'py-10 lg:py-14',
  lg: 'py-12 lg:py-16',
};
---

<section
  id={id}
  class={`${tones[tone]} ${spaces[space]} ${rise ? 'reveal-rise' : ''} ${className}`}
>
  {
    bleed ? (
      <slot />
    ) : (
      <div class="container-x relative z-10">
        <slot />
      </div>
    )
  }
</section>
