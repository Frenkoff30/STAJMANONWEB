---
/**
 * Lišta pod hero na všech stránkách rezervací: kde jsem a kdo jsem.
 * Odhlášení je formulář, ne odkaz — odhlašovat se přes GET by znamenalo,
 * že mě odhlásí kdejaký předstažený odkaz nebo cizí obrázek na stránce.
 */

import type { Profil } from '@/lib/supabase';

interface Props {
  profil: Profil | null;
  email: string | null;
  aktivni?: 'kalendar' | 'moje' | 'sprava';
}

const { profil, email, aktivni } = Astro.props;

const prihlasen = Boolean(email);
const spravce = profil?.role === 'spravce';

const odkazy = [
  { klic: 'kalendar', label: 'Kalendář', href: '/rezervace' },
  ...(prihlasen
    ? [{ klic: 'moje', label: 'Moje rezervace', href: '/rezervace/moje' }]
    : []),
  ...(spravce ? [{ klic: 'sprava', label: 'Správa', href: '/rezervace/sprava' }] : []),
];
---

<div class="border-b border-ink/12 bg-paper-2">
  <div
    class="container-x flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-3"
  >
    <nav aria-label="Rezervace">
      <ul class="flex flex-wrap items-center gap-x-6 gap-y-1">
        {
          odkazy.map((o) => (
            <li>
              <a
                href={o.href}
                aria-current={aktivni === o.klic ? 'page' : undefined}
                class:list={[
                  'text-[0.8125rem] font-semibold uppercase tracking-[0.1em] transition-colors',
                  aktivni === o.klic
                    ? 'text-brass-700'
                    : 'text-ink-3 hover:text-ink',
                ]}
              >
                {o.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[0.8125rem]">
      {
        prihlasen ? (
          <>
            {/* Správce sem přichází ze Správy webu (novinky, akce), ať se má
                jak vrátit. */}
            {spravce && (
              <a
                href="/prihlasky/sprava"
                class="font-semibold uppercase tracking-[0.1em] text-brass-700 transition-colors hover:text-brass-800"
              >
                ← Správa webu
              </a>
            )}
            <span class="text-ink-3">
              {profil?.jmeno || email}
              {profil && !profil.schvaleno && (
                <span class="ml-2 border border-brass-400 bg-brass-100 px-2 py-0.5 text-[0.6875rem] font-semibold uppercase tracking-[0.08em] text-brass-900">
                  čeká na schválení
                </span>
              )}
            </span>
            <form method="post" action="/rezervace/odhlaseni">
              <button
                type="submit"
                class="font-semibold uppercase tracking-[0.1em] text-ink-3 transition-colors hover:text-brass-700"
              >
                Odhlásit
              </button>
            </form>
          </>
        ) : (
          <>
            <a
              href="/rezervace/prihlaseni"
              class="font-semibold uppercase tracking-[0.1em] text-brass-700 hover:text-brass-800"
            >
              Přihlásit se
            </a>
            <a
              href="/rezervace/registrace"
              class="font-semibold uppercase tracking-[0.1em] text-ink-3 transition-colors hover:text-ink"
            >
              Registrace
            </a>
          </>
        )
      }
    </div>
  </div>
</div>
