---
/**
 * Tři nejnovější novinky na úvodní stránce. Server island: stránka zůstává
 * statická, novinky se dotáhnou z databáze, takže nová je vidět hned.
 * Bez novinek se sekce nevykreslí vůbec.
 */

import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import Icon from '@/components/Icon.astro';
import { formatLong } from '@/data/events';
import { CACHE_NOVINEK, nactiNovinky, odstavce } from '@/lib/novinky';

Astro.response.headers.set('Cache-Control', CACHE_NOVINEK);

const latestNews = await nactiNovinky(3);
---

{
  latestNews.length > 0 && (
    <Section tone="paper-2" space="lg">
      <SectionHead
        title="Novinky"
        lead="Co se ve stáji a v areálu právě děje."
        action={{ label: 'Všechny novinky', href: '/novinky' }}
      />

      <ul class="mt-9 grid gap-px bg-ink/12 md:grid-cols-3">
        {latestNews.map((n, i) => (
          <li
            class="bg-paper-2 md:px-6 md:first:pl-0 md:last:pr-0"
            data-reveal
            style={`--reveal-delay:${i * 90}ms`}
          >
            <a href={`/novinky/${n.slug}`} class="group flex h-full flex-col py-6">
              {n.foto_url && (
                <div class="mb-5 aspect-[3/2] overflow-hidden bg-ink/5">
                  <img
                    src={n.foto_url}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  />
                </div>
              )}
              <p class="eyebrow">{formatLong(n.datum)}</p>
              <h3 class="t-3 mt-2 transition-colors group-hover:text-brass-700">{n.nadpis}</h3>
              {odstavce(n.text)[0] && (
                <p class="mt-3 line-clamp-3 text-[0.9375rem] leading-relaxed text-ink-3">
                  {odstavce(n.text)[0]}
                </p>
              )}
              <span class="link-arrow mt-auto pt-5">
                Číst dál
                <Icon name="arrow-right" class="h-3.5 w-3.5" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </Section>
  )
}
