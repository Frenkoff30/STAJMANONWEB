---
import { Image } from 'astro:assets';
import PageLayout from '@/layouts/PageLayout.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import Icon from '@/components/Icon.astro';
import Prose from '@/components/Prose.astro';
import { site } from '@/data/site';
import { horsesForSale } from '@/data/horses';

import { photo } from '@/data/images';
import page from '@/obsah/stranky/kone-na-prodej.json';

const heroImg = photo(page.hero.image)!;
---

<PageLayout
  title={page.seo.title}
  description={page.seo.description}
  heading={page.hero.heading}
  lead={page.hero.lead}
  image={heroImg}
  imageAlt={page.hero.imageAlt}
  crumbs={[{ label: 'Jezdectví' }, { label: 'Koně na prodej' }]}
>
  <Section tone="paper" space="lg">
    {
      horsesForSale.length > 0 ? (
        <>
          <SectionHead
            title={`${horsesForSale.length} koní k dispozici`}
          />
          <ul class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {horsesForSale.map((h, i) => (
              <li class="card card-hover" data-reveal style={`--reveal-delay:${i * 70}ms`}>
                {h.image && (
                  <div class="overflow-hidden">
                    <Image
                      src={h.image}
                      alt={h.name}
                      widths={[400, 800]}
                      sizes="(min-width: 1024px) 30vw, 100vw"
                      class="aspect-[4/3] w-full object-cover"
                    />
                  </div>
                )}
                <div class="p-7">
                  <h2 class="font-display text-[1.5rem]">{h.name}</h2>
                  <p class="mt-1 text-[0.8125rem] uppercase tracking-[0.12em] text-brass-700">
                    {[h.year, h.breed, h.sex].filter(Boolean).join(' · ')}
                  </p>
                  <p class="mt-4 text-[0.9375rem] leading-relaxed text-ink-3">
                    {h.description}
                  </p>
                  {h.price && (
                    <p class="mt-5 font-display text-[1.375rem] text-brass-700">{h.price}</p>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </>
      ) : (
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
          <div class="lg:col-span-7">
            <SectionHead
              title={page.sekce.praveTedNemameVolneho.title}
              lead={page.sekce.praveTedNemameVolneho.lead}
            />

            <Prose paragraphs={page.pribeh} class="prose-manon mt-8" />

            <div class="mt-10 flex flex-wrap gap-3">
              <a href={`tel:${site.phoneHref}`} class="btn btn-primary">
                <Icon name="phone" class="h-4 w-4" />
                {site.phone}
              </a>
              <a href="/kontakt" class="btn btn-outline">{page.kontaktLabel}</a>
            </div>
          </div>

          <div class="lg:col-span-5">
            <div class="card p-8">
              <h2 class="t-3">{page.ocekavani.title}</h2>
              <ul class="mt-6 space-y-4">
                {page.ocekavani.items.map((x) => (
                  <li class="border-t border-ink/12 pt-4">
                    <p class="font-display text-[1.125rem]">{x.title}</p>
                    <p class="mt-1.5 text-[0.875rem] leading-relaxed text-ink-3">{x.text}</p>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      )
    }
  </Section>

  <Section tone="loden" space="md">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <h2 class="t-2 text-white">{page.cta.heading}</h2>
        <p class="lead mt-5 text-white/70">{page.cta.lead}</p>
      </div>
      <div class="flex flex-wrap gap-3 lg:col-span-5 lg:justify-end">
        <a
          href={`mailto:${site.email}?subject=Popt%C3%A1vka%20-%20k%C5%AF%C5%88`}
          class="btn btn-brass"
        >
          <Icon name="mail" class="h-4 w-4" />
          {page.cta.primaryLabel}
        </a>
        <a href="/sluzby" class="btn btn-ghost-light">{page.cta.secondaryLabel}</a>
      </div>
    </div>
  </Section>
</PageLayout>
