---
/**
 * Potvrzení termínu: zarezervovat, nebo zrušit.
 *
 * Mezikrok je tu schválně. Rezervace se nedá vytvořit prostým kliknutím
 * v kalendáři, takže ji nezaloží omylem prst na mobilu ani prohlížeč, který
 * si dopředu stahuje odkazy. Zápis dělá vždycky POST.
 *
 * Z jednoho formuláře může vzniknout i víc řádků: několik navazujících
 * hodin a k tomu týdenní opakování. Každý řádek se zakládá zvlášť, aby
 * jeden zavřený termín uprostřed roku neshodil celou sérii — co projde,
 * to projde, a zbytek se jen spočítá.
 */

export const prerender = false;

import RezervaceLayout from '@/layouts/RezervaceLayout.astro';
import Zprava from '@/components/rezervace/Zprava.astro';
import { citelnaChyba } from '@/lib/supabase';
import {
  cas,
  dlouheDatum,
  dnesCz,
  doporuceniTextu,
  jeMinulost,
  kone,
  najdiBlokaci,
  navazujiciSloty,
  platneDatum,
  pondeliTydne,
  posunDnu,
  tydenniOpakovani,
  type Blokace,
  type Jizdarna,
  type ObsazenostSlotu,
  type Slot,
} from '@/lib/rezervace';

/** Nejvíc navazujících hodin v jednom kuse. */
const MAX_BLOKU = 6;

/** Strop na jednu sérii. Rok po týdnu je 53, zbytek je rezerva na delší bloky. */
const MAX_RADKU = 150;

/** Kolik zápisů běží naráz. Po jednom by se rok opakování vlekl. */
const DAVKA = 8;

const { supabase, profil, uzivatel } = Astro.locals;

// Sem se bez přihlášení nedostane, o to se postaralo middleware.
if (!supabase || !uzivatel) return Astro.redirect('/rezervace');

const parametry = Astro.url.searchParams;
const kodJizdarny = parametry.get('jizdarna') ?? '';
const datum = parametry.get('datum') ?? '';
const kodSlotu = parametry.get('slot') ?? '';

if (!platneDatum(datum)) return Astro.redirect('/rezervace');

const [vysledekJizdarny, vysledekSlotu, vysledekSlotu1] = await Promise.all([
  supabase.from('jizdarny').select('*').eq('kod', kodJizdarny).maybeSingle(),
  supabase.from('sloty').select('*').eq('kod', kodSlotu).maybeSingle(),
  supabase.from('sloty').select('*').eq('aktivni', true).order('poradi'),
]);

const jizdarna = vysledekJizdarny.data as Jizdarna | null;
const slot = vysledekSlotu.data as Slot | null;
const sloty = (vysledekSlotu1.data as Slot[]) ?? [];

if (!jizdarna || !slot) return Astro.redirect('/rezervace');

const zpetNaKalendar = `/rezervace?od=${pondeliTydne(datum)}&jizdarna=${jizdarna.kod}`;
const clen = Boolean(profil?.schvaleno);
const dnes = dnesCz();

/** Navazující hodiny, ze kterých jde vybírat délku. */
const rada = navazujiciSloty(sloty, slot.kod, MAX_BLOKU);

/**
 * Délka přinesená z kalendáře. Kdo tam přetáhl přes tři políčka, najde tu
 * rovnou tři hodiny; ve formuláři to jde ještě přepsat.
 */
const vychoziDelka = Math.max(
  1,
  Math.min(rada.length, Number(parametry.get('delka') ?? 1) || 1),
);

/** Konec posledního vybraného slotu — co se ukáže v záhlaví. */
const konecBloku = rada[vychoziDelka - 1]?.konec ?? slot.konec;

let chyba = '';

/* ------------------------------------------------------------------ zápis */

if (Astro.request.method === 'POST') {
  const formular = await Astro.request.formData();
  const akce = formular.get('akce');

  if (akce === 'zrusit' || akce === 'zrusit-serii') {
    let dotaz = supabase.from('rezervace').delete().eq('uzivatel', uzivatel.id);

    if (akce === 'zrusit-serii') {
      // Minulé termíny série nechat být, mazat jde jen dopředu.
      dotaz = dotaz
        .eq('serie', String(formular.get('serie') ?? ''))
        .gte('datum', dnes);
    } else {
      dotaz = dotaz
        .eq('jizdarna', jizdarna.kod)
        .eq('datum', datum)
        .eq('slot', slot.kod);
    }

    const { error } = await dotaz;

    if (error) chyba = citelnaChyba(error);
    else return Astro.redirect(`${zpetNaKalendar}&ok=zruseno`);
  }

  if (akce === 'rezervovat') {
    const poznamka = String(formular.get('poznamka') ?? '')
      .trim()
      .slice(0, 60);
    const pocetKoni = Math.max(1, Math.min(20, Number(formular.get('koni') ?? 1) || 1));
    const delka = Math.max(1, Math.min(rada.length, Number(formular.get('delka') ?? 1) || 1));

    const opakovatDo = String(formular.get('opakovat_do') ?? '');
    const data =
      formular.get('opakovat') === 'tydne' && platneDatum(opakovatDo)
        ? tydenniOpakovani(datum, opakovatDo)
        : [datum];

    // Jedno opakování = jedna série, ať se pak dá zrušit najednou.
    const serie = data.length > 1 ? crypto.randomUUID() : null;

    const radky = data
      .flatMap((den) =>
        rada.slice(0, delka).map((s) => ({
          jizdarna: jizdarna.kod,
          datum: den,
          slot: s.kod,
          // `uzivatel` se bere ze session, ne z formuláře. Poslat cizí id nejde.
          uzivatel: uzivatel.id,
          poznamka,
          pocet_koni: pocetKoni,
          serie,
        })),
      )
      .slice(0, MAX_RADKU);

    let hotovo = 0;
    let posledniChyba = '';

    for (let i = 0; i < radky.length; i += DAVKA) {
      const vysledky = await Promise.all(
        radky
          .slice(i, i + DAVKA)
          .map((radek) => supabase.from('rezervace').insert(radek)),
      );

      for (const { error } of vysledky) {
        if (error) {
          // Do logu celá hláška z databáze, na stránku jen ta čitelná.
          console.error('Rezervace se neuložila', error.message);
          posledniChyba = citelnaChyba(error);
        } else {
          hotovo += 1;
        }
      }
    }

    if (hotovo === 0) {
      chyba = posledniChyba || 'Rezervaci se nepodařilo uložit.';
    } else {
      const preskoceno = radky.length - hotovo;
      return Astro.redirect(
        `${zpetNaKalendar}&ok=rezervovano&pocet=${hotovo}` +
          (preskoceno > 0 ? `&preskoceno=${preskoceno}` : ''),
      );
    }
  }
}

/* ------------------------------------------------------------------ stav */

const [{ data: bunky }, { data: blokaceData }, { data: mojeData }] = await Promise.all([
  supabase.rpc('kalendar', { od: datum, dokdy: datum }),
  supabase.from('blokace').select('*').eq('datum', datum),
  supabase
    .from('rezervace')
    .select('id, serie')
    .eq('jizdarna', jizdarna.kod)
    .eq('datum', datum)
    .eq('slot', slot.kod)
    .eq('uzivatel', uzivatel.id)
    .maybeSingle(),
]);

const stav = ((bunky as ObsazenostSlotu[]) ?? []).find(
  (b) => b.jizdarna === jizdarna.kod && b.slot === slot.kod && b.datum === datum,
);

const zavreno = najdiBlokaci(
  (blokaceData as Blokace[]) ?? [],
  jizdarna.kod,
  datum,
  slot.kod,
);

const moje = mojeData as { id: string; serie: string | null } | null;
const mam = Boolean(moje);
const koni = stav?.koni ?? 0;
const volno = Math.max(0, jizdarna.kapacita - (stav?.obsazeno ?? 0));
const pryc = jeMinulost(datum, slot.zacatek);
const jmena = stav?.jmena ?? [];
const doporuceni = doporuceniTextu(jizdarna);

/** Nejzazší datum opakování: rok dopředu, ale ne za horizont rezervací. */
const opakovatMax = posunDnu(datum, 364);
---

<RezervaceLayout
  title={`${jizdarna.nazev} — ${dlouheDatum(datum)}`}
  description="Potvrzení rezervace jízdárny."
  heading={mam ? 'Vaše rezervace' : 'Rezervace termínu'}
  profil={profil}
  email={uzivatel.email}
  uzky
  noindex
>
  <div class="card p-7 lg:p-9">
    <p class="eyebrow text-brass-700">{jizdarna.nazev}</p>
    <p class="t-3 mt-2">{dlouheDatum(datum)}</p>
    <p class="mt-1 font-display text-[1.75rem]">
      {cas(slot.zacatek)} – {cas(konecBloku)}
    </p>

    <dl class="mt-7 space-y-px border-t border-ink/12">
      {
        doporuceni && (
          <div class="flex justify-between gap-4 border-b border-ink/12 py-3 text-[0.9375rem]">
            <dt class="text-ink-3">Doporučení</dt>
            <dd class="text-right font-semibold">
              nejvýš {kone(jizdarna.doporuceni_koni)} v jednom čase
            </dd>
          </div>
        )
      }
      <div class="flex justify-between gap-4 border-b border-ink/12 py-3 text-[0.9375rem]">
        <dt class="text-ink-3">Koní v tomhle čase</dt>
        <dd class="font-semibold">{koni}</dd>
      </div>
      {
        clen && jmena.length > 0 && (
          <div class="flex justify-between gap-4 border-b border-ink/12 py-3 text-[0.9375rem]">
            <dt class="text-ink-3">Kdo tu jezdí</dt>
            <dd class="text-right">
              {jmena.map((jmeno) => (
                <span class="block">{jmeno}</span>
              ))}
            </dd>
          </div>
        )
      }
    </dl>

    {chyba && <Zprava typ="chyba" class="mt-7">{chyba}</Zprava>}

    <div class="mt-8">
      {
        mam ? (
          <form method="post">
            <Zprava typ="ok" class="mb-6">
              Tenhle termín máte zarezervovaný.
            </Zprava>
            <div class="flex flex-wrap gap-3">
              <button type="submit" name="akce" value="zrusit" class="btn btn-outline">
                Zrušit rezervaci
              </button>
              {moje?.serie && (
                <button
                  type="submit"
                  name="akce"
                  value="zrusit-serii"
                  class="btn btn-outline"
                  onclick="return confirm('Zrušit všechny budoucí termíny tohohle opakování?')"
                >
                  Zrušit celé opakování
                </button>
              )}
              <a href={zpetNaKalendar} class="btn btn-primary">Zpět na kalendář</a>
            </div>
            {moje?.serie && <input type="hidden" name="serie" value={moje.serie} />}
          </form>
        ) : pryc ? (
          <>
            <Zprava typ="info" class="mb-6">Tenhle termín už je za námi.</Zprava>
            <a href={zpetNaKalendar} class="btn btn-primary">Zpět na kalendář</a>
          </>
        ) : zavreno ? (
          <>
            <Zprava typ="info" class="mb-6">
              Termín má stáj zavřený{zavreno.duvod ? `: ${zavreno.duvod}` : ''}.
            </Zprava>
            <a href={zpetNaKalendar} class="btn btn-primary">Zpět na kalendář</a>
          </>
        ) : !clen ? (
          <>
            <Zprava typ="dulezite" class="mb-6">
              Váš účet zatím čeká na schválení stájí. Jakmile ho potvrdí, budete
              moct rezervovat.
            </Zprava>
            <a href={zpetNaKalendar} class="btn btn-primary">Zpět na kalendář</a>
          </>
        ) : volno === 0 ? (
          <>
            <Zprava typ="info" class="mb-6">
              V tomhle termínu už je zapsaných hodně jezdců. Zkuste prosím jiný
              čas.
            </Zprava>
            <a href={zpetNaKalendar} class="btn btn-primary">Zpět na kalendář</a>
          </>
        ) : (
          <form method="post">
            <input type="hidden" name="akce" value="rezervovat" />

            {doporuceni && koni >= jizdarna.doporuceni_koni && (
              <Zprava typ="dulezite" class="mb-6">
                V tomhle čase už je {kone(koni)}. Zarezervovat se dá dál, jen
                počítejte s tím, že {doporuceni.toLowerCase()}.
              </Zprava>
            )}

            <div class="grid gap-5 sm:grid-cols-2">
              <div class="sm:col-span-2">
                <label for="poznamka" class="form-label">
                  Co budete dělat
                </label>
                <input
                  type="text"
                  id="poznamka"
                  name="poznamka"
                  maxlength="60"
                  class="form-control"
                  placeholder="Např. skoky, lonžování, výuka, drezura"
                  autocomplete="off"
                />
                <p class="mt-2 text-[0.8125rem] text-ink-3">
                  Uvidí to ostatní členové v kalendáři u vašeho jména.
                </p>
              </div>

              <div>
                <label for="koni" class="form-label">Počet koní</label>
                <input
                  type="number"
                  id="koni"
                  name="koni"
                  min="1"
                  max="20"
                  value="1"
                  class="form-control"
                />
              </div>

              <div>
                <label for="delka" class="form-label">Délka</label>
                <select id="delka" name="delka" class="form-control">
                  {rada.map((s, i) => (
                    <option value={i + 1} selected={i + 1 === vychoziDelka}>
                      {i === 0 ? '1 hodina' : `${i + 1} hodiny v kuse`} — do{' '}
                      {cas(s.konec)}
                    </option>
                  ))}
                </select>
                <p class="mt-2 text-[0.8125rem] text-ink-3">
                  Nabízí jen hodiny, které na sebe v rozvrhu navazují.
                </p>
              </div>
            </div>

            {/* Pravidelný trénink: jeden formulář místo padesáti kliknutí. */}
            <fieldset class="mt-8 border-t border-ink/12 pt-6">
              <legend class="form-label">Opakování</legend>

              <label class="mt-2 flex items-center gap-3 text-[0.9375rem]">
                <input type="radio" name="opakovat" value="ne" checked />
                Jen tenhle termín
              </label>

              <label class="mt-3 flex items-center gap-3 text-[0.9375rem]">
                <input type="radio" name="opakovat" value="tydne" />
                Každý týden ve stejný čas až do
              </label>

              <input
                type="date"
                name="opakovat_do"
                min={posunDnu(datum, 7)}
                max={opakovatMax}
                value={opakovatMax}
                class="form-control mt-3"
              />
              <p class="mt-2 text-[0.8125rem] text-ink-3">
                Termíny, které stáj mezitím zavře nebo které už budou plné, se
                přeskočí. Zrušit jde pak celé opakování najednou.
              </p>
            </fieldset>

            <div class="mt-8 flex flex-wrap gap-3">
              <button type="submit" class="btn btn-primary">
                Zarezervovat termín
              </button>
              <a href={zpetNaKalendar} class="btn btn-outline">Zpět</a>
            </div>
          </form>
        )
      }
    </div>
  </div>
</RezervaceLayout>

<script>
  /* Kliknutí do data opakování zaškrtne „každý týden", ať se nestane, že
     si někdo vybere datum a termín se mu založí jen jeden. */
  document
    .querySelector<HTMLInputElement>('input[name="opakovat_do"]')
    ?.addEventListener('input', (udalost) => {
      const pole = udalost.currentTarget as HTMLInputElement;
      const volba = pole.form?.querySelector<HTMLInputElement>(
        'input[name="opakovat"][value="tydne"]',
      );
      if (volba) volba.checked = true;
    });
</script>
