---
import { Image } from 'astro:assets';
import PageLayout from '@/layouts/PageLayout.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import Icon from '@/components/Icon.astro';
import Prose from '@/components/Prose.astro';
import { site } from '@/data/site';
import { majorTitles } from '@/data/achievements';

import { photo } from '@/data/images';
import page from '@/obsah/stranky/jiri-skrivan.json';

const heroImg = photo(page.hero.image)!;
// Stejná fotka jako v sekci „Sport" na homepage — ať je Skřivan poznat.
const portraitImg = photo(page.images.portrait)!;
const sportImg = photo(page.images.sport)!;

const family = page.family;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jiří Skřivan',
  birthDate: '1967-10-17',
  jobTitle: 'Parkurový jezdec a trenér',
  worksFor: { '@id': `${site.url}/#organizace` },
  url: `${site.url}/jiri-skrivan`,
};
---

<PageLayout
  title={page.seo.title}
  description={page.seo.description}
  heading={page.hero.heading}
  lead={page.hero.lead}
  image={heroImg}
  imageAlt={page.hero.imageAlt}
  crumbs={[{ label: 'O nás', href: '/o-nas' }, { label: 'Jiří Skřivan' }]}
  nav={[
    { id: 'zivotopis', label: 'Životopis' },
    { id: 'milniky', label: 'Milníky' },
    { id: 'rodina', label: 'Rodina' },
  ]}
  jsonLd={jsonLd}
>
  <!-- Životopis -->
  <Section tone="paper" space="lg" id="zivotopis">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-28">
          <div class="overflow-hidden" data-reveal>
            <Image
              src={portraitImg}
              alt="Jiří Skřivan na parkuru"
              widths={[400, 800, 1200]}
              sizes="(min-width: 1024px) 38vw, 100vw"
              class="aspect-[4/5] w-full object-cover"
            />
          </div>

          <dl class="mt-8 space-y-px">
            {
              page.facts.map((r) => (
                <div class="flex flex-wrap justify-between gap-3 border-t border-ink/12 py-3.5">
                  <dt class="text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-ink-3/70">
                    {r.label}
                  </dt>
                  <dd class="text-[0.9375rem]">{r.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <div class="lg:col-span-7">
        <SectionHead title={page.sekce.odJuniorskychMedailiPo.title} />

        <Prose paragraphs={page.pribeh} class="prose-manon mt-8" />
      </div>
    </div>
  </Section>

  <!-- Milníky -->
  <Section tone="dark" space="lg" id="milniky">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-7">
        <SectionHead title={page.sekce.nejvyznamnejsiTituly.title} tone="light" />
        <ul class="mt-10 space-y-px">
          {
            majorTitles.map((m, i) => (
              <li
                class="flex items-baseline gap-6 border-t border-white/12 py-5 last:border-b"
                data-reveal
                style={`--reveal-delay:${i * 70}ms`}
              >
                <span class="w-20 shrink-0 font-display text-[1.75rem] text-brass-300 tabular-nums">
                  {m.year}
                </span>
                <span class="text-[1.0625rem] text-white/85">{m.text}</span>
              </li>
            ))
          }
        </ul>
        <a href="/uspechy" class="link-arrow mt-10 text-brass-300">
          {page.milnikyLinkLabel}
          <Icon name="arrow-right" class="h-3.5 w-3.5" />
        </a>
      </div>

      <div class="lg:col-span-5">
        <div class="overflow-hidden" data-reveal>
          <Image
            src={sportImg}
            alt={page.images.sportAlt}
            widths={[320, 640]}
            sizes="(min-width: 1024px) 38vw, 100vw"
            class="aspect-[2/3] w-full object-cover"
          />
        </div>
      </div>
    </div>
  </Section>

  <!-- Rodina -->
  <Section tone="paper" space="lg" id="rodina">
    <SectionHead
      title={page.sekce.jezdeckaRodinaSkrivanova.title}
      lead={page.sekce.jezdeckaRodinaSkrivanova.lead}
    />

    <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2">
      {
        family.map((f, i) => (
          <div class="border-t border-ink/12 pt-5" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-brass-700">
              {f.role}
            </p>
            <h3 class="mt-3 font-display text-[1.5rem]">{f.name}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-3">{f.text}</p>
          </div>
        ))
      }
    </div>
  </Section>
</PageLayout>
