---
import { Image } from 'astro:assets';
import PageLayout from '@/layouts/PageLayout.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';
import { majorTitles } from '@/data/achievements';

import heroImg from '@/assets/photos/skrivan-02.jpg';
// Stejná fotka jako v sekci „Sport" na homepage — ať je Skřivan poznat.
import portraitImg from '@/assets/photos/skrivan-01.jpg';
import sportImg from '@/assets/photos/uspechy-03.jpg';

const family = [
  {
    name: 'Miroslava Skřivanová',
    role: 'Jezdecká škola',
    text: 'Vede jezdeckou školu v jezdeckém klubu Hřebčína Suchá. Licence: cvičitel, rozhodčí, stylový komisař, stavitel parkuru.',
  },
  {
    name: 'Petra Skřivanová',
    role: 'Jezdkyně',
    text: 'Mistryně ČR mladých jezdců 2010. 2. místo ve finále Dance and Jump Czech Junior Cup 2008, 4. místo ve Velké ceně Prahy a 5. místo v Grand Prix ve Wiener Neustadt (2009).',
  },
  {
    name: 'Mirka Skřivanová',
    role: 'Jezdkyně',
    text: '3. a 5. místo z MČR juniorů 2006, dvě 4. místa z MČR 2007, 3. místo ve finále DaJ Czech Junior Cup 2010.',
  },
  {
    name: 'Jiří Skřivan ml.',
    role: 'Jezdec',
    text: 'Medailista z MČR družstev z let 2015, 2016 a 2017. 3. místo ve Styl Šampionátu 2016.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jiří Skřivan',
  birthDate: '1967-10-17',
  jobTitle: 'Parkurový jezdec a trenér',
  worksFor: { '@id': `${site.url}/#organizace` },
  url: `${site.url}/jiri-skrivan`,
};
---

<PageLayout
  title="Jiří Skřivan"
  description="Jiří Skřivan — parkurový jezdec, trenér, zakladatel Stáje Manon a prezident Asociace Český skokový pohár. Mistr ČR 1993, trojnásobný vítěz ČSP."
  heading="Jiří Skřivan"
  lead="Parkurový jezdec, trenér a člověk, který v roce 2002 přišel s myšlenkou Českého skokového poháru."
  image={heroImg}
  imageAlt="Jiří Skřivan v sedle"
  crumbs={[{ label: 'O nás', href: '/o-nas' }, { label: 'Jiří Skřivan' }]}
  nav={[
    { id: 'zivotopis', label: 'Životopis' },
    { id: 'milniky', label: 'Milníky' },
    { id: 'rodina', label: 'Rodina' },
  ]}
  jsonLd={jsonLd}
>
  <!-- Životopis -->
  <Section tone="paper" space="lg" id="zivotopis">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-28">
          <div class="img-zoom overflow-hidden" data-reveal>
            <Image
              src={portraitImg}
              alt="Jiří Skřivan na parkuru"
              widths={[400, 800, 1200]}
              sizes="(min-width: 1024px) 38vw, 100vw"
              class="aspect-[4/5] w-full object-cover"
            />
          </div>

          <dl class="mt-8 space-y-px">
            {
              [
                { k: 'Narozen', v: '17. října 1967' },
                { k: 'Profesionálně', v: 'od roku 1990' },
                { k: 'První parkur', v: 've 12 letech, na klisně Manon' },
                { k: 'Funkce', v: 'prezident Asociace Český skokový pohár' },
              ].map((r) => (
                <div class="flex flex-wrap justify-between gap-3 border-t border-ink/12 py-3.5">
                  <dt class="text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-ink-3/70">
                    {r.k}
                  </dt>
                  <dd class="text-[0.9375rem]">{r.v}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <div class="lg:col-span-7">
        <SectionHead title="Od juniorských medailí po vlastní seriál." />

        <div class="prose-manon mt-8">
          <p>
            Jiří Skřivan se narodil 17. října 1967, vystudoval gymnázium a od roku
            1990 se parkurovému sportu věnuje profesionálně. Závodit začal ve dvanácti
            letech a svůj první parkur vyhrál na koni <strong>Manon</strong>, po
            kterém je pojmenovaná nynější stáj.
          </p>
          <p>
            V juniorské kategorii patřili s bratrem Rudolfem k velmi úspěšným jezdcům
            a na mistrovstvích se pravidelně řadili na stupně vítězů. Jako junior
            závodil i ve všestranné způsobilosti, kde v roce 1985 získal na MČR
            bronzovou a na MČSSR zlatou a stříbrnou medaili.
          </p>
          <h2>Zkušenosti ze zahraničí</h2>
          <p>
            V roce 1989 využil možnosti získávat nové zkušenosti v zahraničí. Nejprve
            pracoval ve Švýcarsku a poté odjel do Irska, kde absolvoval stáž
            u <strong>Paula Darragha</strong>. Po několika měsících se vrátil zpět,
            tentokrát do stáje jednoho z nejlepších světových jezdců
            <strong> Markuse Fuchse</strong>. Odtud vedly jeho kroky do privátní stáje
            H. Trauffera, kde měl možnost startovat na národní i mezinárodní úrovni
            téměř dva roky.
          </p>
          <h2>Vlastní stáj</h2>
          <p>
            Po návratu ze zahraničí, na podzim 1992, založil nedaleko Litomyšle vlastní
            stáj. Začal spolupracovat s JK Mělník a dostal do tréninku první koně —
            mezi nimi i čtyřletého <strong>Labe Jeffa</strong>, se kterým později
            dosáhl vítězství v Grand Prix na CSI-W v Maďarsku.
          </p>
          <p>
            V roce 1995 se stáj přestěhovala do nově vybudovaného areálu přímo
            v Litomyšli. S koňmi Vesta del Metz, Labe Jeff, Naracondo, Gargano, Guyane,
            Labe James, Andolph, Tora 1, Rytma a dalšími dosáhl Jiří Skřivan na
            domácích i zahraničních kolbištích nespočet sportovních úspěchů.
          </p>
          <h2>Český skokový pohár</h2>
          <p>
            V roce 2002 přichází Jiří Skřivan do jezdeckého sportu s novou myšlenkou
            celorepublikového seriálu Velkých cen — a následně vzniká nový fenomén
            posledních let, <strong>Český skokový pohár</strong>. Byl zvolen
            prezidentem Asociace Český skokový pohár a v letech 2004, 2006 a 2011 se
            stal i jeho celkovým vítězem.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Milníky -->
  <Section tone="dark" space="lg" id="milniky">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-7">
        <SectionHead title="Nejvýznamnější tituly" tone="light" />
        <ul class="mt-10 space-y-px">
          {
            majorTitles.map((m, i) => (
              <li
                class="flex items-baseline gap-6 border-t border-white/12 py-5 last:border-b"
                data-reveal
                style={`--reveal-delay:${i * 70}ms`}
              >
                <span class="w-20 shrink-0 font-display text-[1.75rem] text-brass-300 tabular-nums">
                  {m.year}
                </span>
                <span class="text-[1.0625rem] text-white/85">{m.text}</span>
              </li>
            ))
          }
        </ul>
        <a href="/uspechy" class="link-arrow mt-10 text-brass-300">
          Kompletní přehled úspěchů
          <Icon name="arrow-right" class="h-3.5 w-3.5" />
        </a>
      </div>

      <div class="lg:col-span-5">
        <div class="img-zoom overflow-hidden" data-reveal>
          <Image
            src={sportImg}
            alt="Jezdec Stáje Manon po vítězné jízdě"
            widths={[320, 640]}
            sizes="(min-width: 1024px) 38vw, 100vw"
            class="aspect-[2/3] w-full object-cover"
          />
        </div>
      </div>
    </div>
  </Section>

  <!-- Rodina -->
  <Section tone="paper" space="lg" id="rodina">
    <SectionHead
      title="Jezdecká rodina Skřivanova"
      lead="Manželka Miroslava vede jezdeckou školu, děti Petra, Mirka a Jiří ml. sbírali medaile na mistrovstvích republiky."
    />

    <div class="mt-10 grid gap-px border border-ink/12 bg-ink/12 sm:grid-cols-2">
      {
        family.map((f, i) => (
          <div class="bg-paper p-8 lg:p-10" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-brass-700">
              {f.role}
            </p>
            <h3 class="mt-3 font-display text-[1.5rem]">{f.name}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-3">{f.text}</p>
          </div>
        ))
      }
    </div>
  </Section>
</PageLayout>
