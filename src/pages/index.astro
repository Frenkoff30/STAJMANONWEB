---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import EventRow from '@/components/EventRow.astro';
import Icon from '@/components/Icon.astro';
import Lines from '@/components/Lines.astro';
import { site } from '@/data/site';
import { upcomingPublicEvents } from '@/data/events';
import { facilities } from '@/data/services';
import { turnusy } from '@/data/courses';
import { majorTitles } from '@/data/achievements';
import { pickPhotos } from '@/data/gallery';
import { photo } from '@/data/images';
import page from '@/obsah/stranky/uvod.json';

const nextEvents = upcomingPublicEvents().slice(0, 5);
const freeTurnusy = turnusy.filter(
  (t) => t.status === 'volno' || t.status === 'posledni',
).length;

const heroImg = photo(page.hero.image)!;
const restauraceImg = photo(page.penzion.image)!;
const kurzyImg = photo(page.skola.imageTall)!;
const halaImg = photo(page.skola.imageSquare)!;
const skrivanImg = photo(page.uspechy.image)!;

const pillars = page.pillars
  .map((p, i) => ({ ...p, n: String(i + 1).padStart(2, '0'), img: photo(p.image) }))
  .filter((p) => p.img);

const featuredPhotos = pickPhotos(page.galerie.featured);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.fullName,
  url: site.url,
  inLanguage: 'cs',
  publisher: { '@id': `${site.url}/#organizace` },
};
---

<BaseLayout
  title={page.seo.title}
  description={site.description}
  overlayHeader
  jsonLd={jsonLd}
>
  <!-- ================================================================ HERO -->
  <section class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden bg-loden-950">
    <Image
      src={heroImg}
      alt={page.hero.imageAlt}
      widths={[768, 1280, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div
      class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgba(10,16,13,.95)_0%,rgba(10,16,13,.86)_22%,rgba(10,16,13,.62)_45%,rgba(10,16,13,.34)_70%,rgba(10,16,13,.58)_100%)]"
    >
    </div>
    <div
      class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,rgba(10,16,13,.62)_0%,rgba(10,16,13,.2)_45%,transparent_75%)]"
    >
    </div>

    <div class="container-x relative pb-10 pt-28 lg:pb-14">
      <h1 class="t-display max-w-[16ch] text-white text-shadow-hero">
        {page.hero.headingStart}<br class="hidden sm:block" />
        <em class="font-normal italic text-brass-300">{page.hero.headingAccent}</em>
        {' '}{page.hero.headingEnd}
      </h1>

      <div class="mt-9 grid gap-10 lg:grid-cols-12 lg:items-end">
        <p class="lead max-w-xl text-white/85 lg:col-span-6">
          {page.hero.lead}
        </p>

        <div class="flex flex-wrap gap-3 lg:col-span-6 lg:justify-end">
          <a href={page.hero.primaryCta.href} class="btn btn-brass">
            {page.hero.primaryCta.label}
          </a>
          <a href={page.hero.secondaryCta.href} class="btn btn-ghost-light">
            {page.hero.secondaryCta.label}
          </a>
        </div>
      </div>
    </div>

    <!-- Spodní lišta: rychlé vstupy -->
    <div class="relative border-t border-white/15 backdrop-blur-sm">
      <div class="container-x grid divide-white/15 sm:grid-cols-3 sm:divide-x">
        {
          [
            {
              href: page.hero.quickEvents.href,
              label: page.hero.quickEvents.label,
              value: nextEvents[0]?.title ?? page.hero.quickEvents.fallback,
              icon: 'calendar' as const,
            },
            {
              href: page.hero.quickCourses.href,
              label: page.hero.quickCourses.label,
              value: `${freeTurnusy} turnusů s volnými místy`,
              icon: 'users' as const,
            },
            {
              href: `tel:${site.phoneHref}`,
              label: page.hero.quickPhone.label,
              value: site.phone,
              icon: 'phone' as const,
            },
          ].map((item) => (
            <a
              href={item.href}
              class="group flex items-center gap-4 border-t border-white/15 py-5 text-white transition-colors first:border-t-0 hover:bg-white/[0.06] sm:border-t-0 sm:px-6 sm:first:pl-0 sm:last:pr-0"
            >
              <Icon name={item.icon} class="h-5 w-5 shrink-0 text-brass-300" />
              <span class="min-w-0 flex-1">
                <span class="block text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-white/50">
                  {item.label}
                </span>
                <span class="mt-1 block truncate text-[0.9375rem]">{item.value}</span>
              </span>
              <Icon
                name="arrow-right"
                class="h-4 w-4 shrink-0 text-white/40 transition-transform duration-300 group-hover:translate-x-1 group-hover:text-brass-300"
              />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================================== PILÍŘE -->
  <Section tone="paper" space="lg">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-28">
          <h2 class="t-2">
            <Lines text={page.pillarsIntro.heading} />
          </h2>
          <p class="lead mt-6">{page.pillarsIntro.lead}</p>
          <a href={page.pillarsIntro.linkHref} class="link-arrow mt-8">
            {page.pillarsIntro.linkLabel}
            <Icon name="arrow-right" class="h-3.5 w-3.5" />
          </a>
        </div>
      </div>

      <div class="lg:col-span-8">
        <ul class="space-y-px">
          {
            pillars.map((p, i) => (
              <li
                class="group relative border-t border-ink/12 last:border-b"
                data-reveal
                style={`--reveal-delay:${i * 90}ms`}
              >
                <a href={p.href} class="grid gap-5 py-7 sm:grid-cols-[auto_1fr_auto] sm:items-start sm:gap-8">
                  <span class="index-num pt-2">{p.n}</span>

                  <div class="min-w-0">
                    <h3 class="t-3 transition-colors group-hover:text-brass-700">
                      {p.title}
                    </h3>
                    <p class="mt-3 max-w-xl text-[0.9375rem] leading-relaxed text-ink-3">
                      {p.text}
                    </p>
                    <span class="link-arrow mt-5">
                      {p.cta}
                      <Icon name="arrow-right" class="h-3.5 w-3.5" />
                    </span>
                  </div>

                  <span class="hidden w-32 shrink-0 overflow-hidden sm:block lg:w-40">
                    <Image
                      src={p.img!}
                      alt={p.alt}
                      widths={[220, 440]}
                      sizes="13rem"
                      class="aspect-[4/3] h-full w-full object-cover"
                    />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <!-- ============================================================== ČÍSLA -->
  <Section tone="dark" space="md" rise>
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-5">
        <SectionHead
          title={page.facilities.title}
          lead={page.facilities.lead}
          tone="light"
        />
        <a href={page.facilities.linkHref} class="link-arrow mt-8 text-brass-300">
          {page.facilities.linkLabel}
          <Icon name="arrow-right" class="h-3.5 w-3.5" />
        </a>
      </div>

      <div class="lg:col-span-7">
        <dl class="grid grid-cols-2 gap-px border border-white/12 bg-white/12">
          {
            facilities.map((f, i) => (
              <div
                class="bg-loden-950 p-5 lg:p-7"
                data-reveal
                style={`--reveal-delay:${i * 80}ms`}
              >
                <dt class="text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-brass-300">
                  {f.name}
                </dt>
                <dd class="mt-3 font-display text-[1.75rem] leading-none text-white lg:text-[2.25rem]">
                  {f.size}
                </dd>
                <dd class="mt-4 text-[0.875rem] leading-relaxed text-white/55">
                  {f.text}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </Section>

  <!-- =========================================================== KALENDÁŘ -->
  <Section tone="paper" space="lg">
    <SectionHead
      title={page.calendar.title}
      lead={page.calendar.lead}
      action={{ label: page.calendar.actionLabel, href: '/akce' }}
    />

    <div class="mt-9">
      {nextEvents.map((e, i) => <EventRow event={e} index={i} />)}
      <div class="border-t border-ink/12"></div>
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/akce" class="btn btn-outline">Kalendář akcí 2026</a>
      <a href="/vysledky" class="btn btn-outline">Výsledkové listiny</a>
    </div>
  </Section>

  <!-- ============================================================ PENZION -->
  <section class="relative bg-paper-2">
    <div class="grid lg:grid-cols-2">
      <div class="parallax relative min-h-[16rem] overflow-hidden lg:min-h-[30rem]">
        <Image
          src={restauraceImg}
          alt={page.penzion.imageAlt}
          widths={[640, 1024, 1600]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>

      <div class="flex items-center px-5 py-14 sm:px-8 lg:px-14 lg:py-20 xl:px-20">
        <div class="max-w-xl" data-reveal>
          <h2 class="t-2">{page.penzion.title}</h2>
          <p class="lead mt-6">{page.penzion.lead}</p>

          <dl class="mt-10 grid gap-px border border-ink/12 bg-ink/12 sm:grid-cols-2">
            {
              page.penzion.stats.map((s) => (
                <div class="bg-paper-2 p-6">
                  <dt class="text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-ink-3/70">
                    {s.label}
                  </dt>
                  <dd class="mt-2 font-display text-[2rem] leading-none">{s.value}</dd>
                  <dd class="mt-2 text-[0.8125rem] text-ink-3">{s.note}</dd>
                </div>
              ))
            }
          </dl>

          <ul class="mt-8 space-y-2.5 text-[0.9375rem] text-ink-3">
            {
              page.penzion.bullets.map((t) => (
                <li class="flex gap-3">
                  <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-brass-600" strokeWidth={2.2} />
                  {t}
                </li>
              ))
            }
          </ul>

          <div class="mt-10 flex flex-wrap gap-3">
            <a href={page.penzion.primaryCta.href} class="btn btn-primary">
              {page.penzion.primaryCta.label}
            </a>
            <a href={`mailto:${site.emailPenzion}`} class="btn btn-outline">
              {page.penzion.secondaryCtaLabel}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================== ŠKOLA -->
  <Section tone="white" space="lg">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-14">
      <div class="lg:col-span-5" data-reveal>
        <h2 class="t-2">{page.skola.title}</h2>
        <p class="lead mt-6">{page.skola.lead}</p>

        <div class="mt-8 space-y-5">
          {
            page.skola.items.map((x) => (
              <a href={x.href} class="group block border-t border-ink/12 pt-6">
                <h3 class="flex items-center gap-3 font-display text-[1.375rem] transition-colors group-hover:text-brass-700">
                  {x.title}
                  <Icon
                    name="arrow-right"
                    class="h-4 w-4 text-brass-600 opacity-0 transition-all duration-300 group-hover:translate-x-1 group-hover:opacity-100"
                  />
                </h3>
                <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-3">{x.text}</p>
              </a>
            ))
          }
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="grid grid-cols-2 gap-4" data-reveal>
          <div class="overflow-hidden">
            <Image
              src={kurzyImg}
              alt={page.skola.imageTallAlt}
              widths={[400, 800]}
              sizes="(min-width: 1024px) 28vw, 45vw"
              class="aspect-[3/4] h-full w-full object-cover"
            />
          </div>
          <div class="mt-10 grid gap-4">
            <div class="overflow-hidden">
              <Image
                src={halaImg}
                alt={page.skola.imageSquareAlt}
                widths={[400, 800]}
                sizes="(min-width: 1024px) 28vw, 45vw"
                class="aspect-square h-full w-full object-cover"
              />
            </div>
            <div class="bg-loden-900 p-6 text-white">
              <p class="font-display text-[2.5rem] leading-none text-brass-300">
                {page.skola.yearValue}
              </p>
              <p class="mt-3 text-[0.875rem] leading-relaxed text-white/65">
                {page.skola.yearText}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- ============================================================ ÚSPĚCHY -->
  <Section tone="loden" space="lg">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-5">
        <div class="overflow-hidden" data-reveal>
          <Image
            src={skrivanImg}
            alt={page.uspechy.imageAlt}
            widths={[400, 800, 1200]}
            sizes="(min-width: 1024px) 38vw, 100vw"
            class="aspect-[4/5] w-full object-cover"
          />
        </div>
      </div>

      <div class="lg:col-span-7">
        <SectionHead title={page.uspechy.title} tone="light" />

        <p class="lead mt-6 text-white/70">{page.uspechy.text}</p>

        <ul class="mt-9 space-y-px">
          {
            majorTitles.map((m, i) => (
              <li
                class="flex items-baseline gap-6 border-t border-white/12 py-4 last:border-b"
                data-reveal
                style={`--reveal-delay:${i * 70}ms`}
              >
                <span class="w-16 shrink-0 font-display text-[1.5rem] text-brass-300 tabular-nums">
                  {m.year}
                </span>
                <span class="text-[0.9375rem] text-white/80">{m.text}</span>
              </li>
            ))
          }
        </ul>

        <div class="mt-10 flex flex-wrap gap-3">
          <a href="/uspechy" class="btn btn-ghost-light">
            {page.uspechy.primaryCtaLabel}
          </a>
          <a href="/jiri-skrivan" class="btn btn-ghost-light">
            {page.uspechy.secondaryCtaLabel}
          </a>
        </div>
      </div>
    </div>
  </Section>

  <!-- ============================================================ GALERIE -->
  <Section tone="paper" space="md" bleed>
    <div class="container-x">
      <SectionHead
        title={page.galerie.title}
        action={{ label: page.galerie.actionLabel, href: '/galerie' }}
      />
    </div>

    <div class="mt-9 overflow-hidden" aria-hidden="true">
      <div class="flex w-max animate-marquee gap-4 hover:[animation-play-state:paused]">
        {
          [...featuredPhotos, ...featuredPhotos].map((p) => (
            <div class="w-[13rem] shrink-0 overflow-hidden sm:w-[17rem]">
              <Image
                src={p.src}
                alt=""
                widths={[352, 704]}
                sizes="22rem"
                loading="lazy"
                class="aspect-[4/3] h-full w-full object-cover"
              />
            </div>
          ))
        }
      </div>
    </div>

    <div class="container-x mt-10">
      <a href="/galerie" class="btn btn-outline">{page.galerie.buttonLabel}</a>
    </div>
  </Section>

  <!-- ================================================================ CTA -->
  <Section tone="loden" space="lg">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <h2 class="t-1 text-white">
          <Lines text={page.cta.heading} />
        </h2>
        <p class="lead mt-5 max-w-2xl text-white/70">{page.cta.lead}</p>
      </div>

      <div class="flex flex-wrap gap-3 lg:col-span-5 lg:justify-end">
        <a href={`tel:${site.phoneHref}`} class="btn btn-brass">
          <Icon name="phone" class="h-4 w-4" />
          {site.phone}
        </a>
        <a href="/kontakt" class="btn btn-ghost-light">{page.cta.buttonLabel}</a>
      </div>
    </div>
  </Section>
</BaseLayout>
