---
import PageLayout from '@/layouts/PageLayout.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import Lightbox from '@/components/Lightbox.astro';
import Icon from '@/components/Icon.astro';
import { photos, galleryTagLabels, type GalleryTag } from '@/data/gallery';
import { site } from '@/data/site';

import { photo } from '@/data/images';
import page from '@/obsah/stranky/galerie.json';

const heroImg = photo(page.hero.image)!;

const usedTags = [...new Set(photos.map((p) => p.tag))] as GalleryTag[];
const counts = Object.fromEntries(
  usedTags.map((t) => [t, photos.filter((p) => p.tag === t).length]),
) as Record<GalleryTag, number>;
---

<PageLayout
  title={page.seo.title}
  description={page.seo.description}
  heading={page.hero.heading}
  lead={`${photos.length} ${page.hero.leadSuffix}`}
  image={heroImg}
  imageAlt={page.hero.imageAlt}
  crumbs={[{ label: 'O nás', href: '/o-nas' }, { label: 'Fotogalerie' }]}
>
  <Section tone="paper" space="lg">
    <SectionHead
      title={page.sekce.prohledneteSiAreal.title}
      lead={page.sekce.prohledneteSiAreal.lead}
    />

    <div class="mt-10 flex flex-wrap gap-2" role="group" aria-label="Filtr fotogalerie">
      <button type="button" class="filter-chip is-active" data-gallery-filter="all">
        Vše <span class="ml-1.5 opacity-60">{photos.length}</span>
      </button>
      {
        usedTags.map((t) => (
          <button type="button" class="filter-chip" data-gallery-filter={t}>
            {galleryTagLabels[t]}
            <span class="ml-1.5 opacity-60">{counts[t]}</span>
          </button>
        ))
      }
    </div>

    <Lightbox photos={photos} cols={4} class="mt-10" />
  </Section>

  <Section tone="paper-2" space="md">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-8">
        <h2 class="t-3">{page.cta.heading}</h2>
        <p class="mt-3 text-ink-3">{page.cta.lead}</p>
      </div>
      <div class="flex flex-wrap gap-3 lg:col-span-4 lg:justify-end">
        <a
          href={site.social.facebook}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
        >
          <Icon name="facebook" class="h-4 w-4" />
          Facebook
        </a>
        <a
          href={site.social.youtube}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
        >
          <Icon name="youtube" class="h-4 w-4" />
          YouTube
        </a>
      </div>
    </div>
  </Section>
</PageLayout>

<style>
  .filter-chip {
    cursor: pointer;
    border: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    font-weight: 500;
    min-height: 2.75rem;
    transition: background-color 200ms var(--ease-out-natural),
      color 200ms var(--ease-out-natural),
      border-color 200ms var(--ease-out-natural);
  }
  .filter-chip:hover {
    border-color: var(--color-brass-600);
    color: var(--color-brass-700);
  }
  .filter-chip.is-active {
    background: var(--color-loden-800);
    border-color: var(--color-loden-800);
    color: var(--color-paper);
  }
</style>

<script>
  const buttons = Array.from(
    document.querySelectorAll<HTMLElement>('[data-gallery-filter]'),
  );
  const items = Array.from(
    document.querySelectorAll<HTMLElement>('[data-lightbox-grid] > li'),
  );

  for (const btn of buttons) {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.galleryFilter ?? 'all';
      buttons.forEach((b) => b.classList.toggle('is-active', b === btn));
      for (const li of items) {
        li.hidden = filter !== 'all' && li.dataset.photoTag !== filter;
      }
    });
  }
</script>
