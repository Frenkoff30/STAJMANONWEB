---
import { Image } from 'astro:assets';
import PageLayout from '@/layouts/PageLayout.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';
import {
  turnusy,
  turnusLabel,
  turnusStatusLabels,
  kurzCena,
  kurzProgram,
  kurzIncluded,
  kurzPacking,
  stornoPodminky,
} from '@/data/courses';
import { formatRange } from '@/data/events';

import { photo } from '@/data/images';
import page from '@/obsah/stranky/kurzy.json';

const heroImg = photo(page.hero.image)!;
const programImg = photo(page.images.program)!;
const pokojImg = photo(page.images.pokoj)!;

const statusStyle: Record<string, string> = {
  volno: 'bg-loden-800 text-paper',
  posledni: 'bg-brass-600 text-white',
  obsazeno: 'bg-ink/10 text-ink-3',
  uzavreno: 'bg-ink/10 text-ink-3',
};

const bookable = (s: string) => s === 'volno' || s === 'posledni';
const freeCount = turnusy.filter((t) => bookable(t.status)).length;
const volnoLead =
  freeCount === turnusy.length
    ? 'Přihlásit se jde rovnou přes formulář, potvrzení i platební údaje přijdou e-mailem.'
    : `Volná místa má ${freeCount} z ${turnusy.length} vypsaných termínů.`;
---

<PageLayout
  title={page.seo.title}
  heading={page.hero.heading}
  description={page.seo.description}
  lead={page.hero.lead}
  image={heroImg}
  imageAlt={page.hero.imageAlt}
  crumbs={[{ label: 'Jezdectví' }, { label: 'Prázdninové kurzy' }]}
  nav={[
    { id: 'turnusy', label: 'Termíny' },
    { id: 'program', label: 'Program' },
    { id: 'cena', label: 'Cena a platba' },
    { id: 'zabalit', label: 'Co s sebou' },
  ]}
  navAction={{ label: 'Přihlásit', href: '#turnusy' }}
  heroSize="tall"
>
  <!-- Turnusy -->
  <Section tone="paper" space="lg" id="turnusy">
    <SectionHead
      title={page.sekce.terminy.title}
      lead={`${volnoLead} U týdenních turnusů je nástup v neděli do 10.00, ukončení s vyhodnocením v sobotu ve 12.00 a odjezd zhruba ve 13.30.`}
      action={{ label: 'Poptat termín', href: `mailto:${site.email}` }}
    />

    <ul class="mt-10 space-y-px">
      {
        turnusy.map((t, i) => (
          <li
            class:list={[
              'grid grid-cols-[auto_1fr] items-center gap-x-5 gap-y-2 border-t border-ink/12 py-6 last:border-b sm:grid-cols-[auto_1fr_auto_auto] sm:gap-8',
              !bookable(t.status) && 'opacity-55',
            ]}
            data-reveal
            style={`--reveal-delay:${i * 55}ms`}
          >
            <span class="text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-brass-700">
              {turnusLabel(t)}
            </span>

            <div class="min-w-0">
              <p class="font-display text-[1.25rem] leading-snug sm:text-[1.5rem]">
                {formatRange({ start: t.start, end: t.end, title: '', kind: 'pobyt' })}
              </p>
              {t.note && (
                <p class="mt-1 text-[0.875rem] text-ink-3">{t.note}</p>
              )}
            </div>

            <span
              class:list={[
                'col-span-2 justify-self-start px-3 py-1.5 text-[0.6875rem] font-semibold uppercase tracking-[0.12em] sm:col-span-1 sm:justify-self-end',
                statusStyle[t.status],
              ]}
            >
              {turnusStatusLabels[t.status]}
            </span>

            <div class="col-span-2 sm:col-span-1 sm:w-40 sm:text-right">
              {bookable(t.status) ? (
                <a
                  href={
                    t.prihlaska
                      ? `/prihlaska/${t.prihlaska}`
                      : `mailto:${site.email}?subject=${encodeURIComponent(`Přihláška: ${turnusLabel(t)}`)}`
                  }
                  class="link-arrow sm:justify-end"
                >
                  {t.prihlaska ? 'Vyplnit přihlášku' : 'Poptat místo'}
                  <Icon name="arrow-right" class="h-3.5 w-3.5" />
                </a>
              ) : (
                <span class="text-[0.75rem] uppercase tracking-[0.12em] text-ink-3/60">
                  ·
                </span>
              )}
            </div>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 text-[0.9375rem] text-ink-3">
      {page.terminyNote.before}
      <a href={`mailto:${site.email}`} class="link-underline font-semibold text-brass-700">
        {site.email}
      </a>. {page.terminyNote.after}
    </p>
  </Section>

  <!-- Program -->
  <Section tone="dark" space="lg" id="program" rise>
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-5">
        <SectionHead
          title={page.sekce.tydenZeKterehoSi.title}
          lead={page.sekce.tydenZeKterehoSi.lead}
          tone="light"
        />
        <div class="mt-10 overflow-hidden" data-reveal>
          <Image
            src={programImg}
            alt={page.images.programAlt}
            widths={[400, 800, 1200, 1600]}
            sizes="(min-width: 1024px) 36vw, 100vw"
            class="aspect-[4/3] w-full object-cover"
          />
        </div>
      </div>

      <div class="lg:col-span-7">
        <dl class="space-y-px">
          {
            kurzProgram.map((p, i) => (
              <div
                class="border-t border-white/12 py-8 last:border-b"
                data-reveal
                style={`--reveal-delay:${i * 80}ms`}
              >
                <dt class="font-display text-[1.5rem] text-white">{p.title}</dt>
                <dd class="mt-3 text-[0.9375rem] leading-relaxed text-white/65">
                  {p.text}
                </dd>
              </div>
            ))
          }
        </dl>

        <p class="mt-8 border-l-2 border-brass-500 pl-5 text-[0.9375rem] text-white/65">
          {page.programNote}
        </p>
      </div>
    </div>
  </Section>

  <!-- Cena -->
  <Section tone="paper" space="lg" id="cena">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-5">
        <SectionHead title={page.sekce.kolikToStoji.title} />

        <div class="mt-10 grid gap-x-10 gap-y-6 sm:grid-cols-2">
          <div class="border-t border-ink/12 pt-4">
            <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-ink-3/70">
              {page.cenaLabels.main}
            </p>
            <p class="mt-2 font-display text-[1.5rem] leading-none">{kurzCena.main}</p>
          </div>
          <div class="border-t border-ink/12 pt-4">
            <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-brass-700">
              {page.cenaLabels.discounted}
            </p>
            <p class="mt-2 font-display text-[1.5rem] leading-none text-brass-700">
              {kurzCena.discounted}
            </p>
            <p class="mt-3 text-[0.8125rem] leading-relaxed text-ink-3">
              {kurzCena.discountNote}
            </p>
          </div>
        </div>

        <div class="mt-8 space-y-4 text-[0.9375rem] text-ink-3">
          <p>
            <strong class="text-ink">{page.cenaNotes.ownHorseLabel}</strong>{' '}
            {kurzCena.ownHorse}{page.cenaNotes.ownHorseText}
          </p>
          <p>
            <strong class="text-ink">{page.cenaNotes.paymentLabel}</strong>{' '}
            {page.cenaNotes.paymentBefore}{' '}
            <span class="whitespace-nowrap font-semibold text-ink">{kurzCena.account}</span>{' '}
            {page.cenaNotes.paymentAfter}
          </p>
          <p>
            <strong class="text-ink">{page.cenaNotes.insuranceLabel}</strong>{' '}
            {page.cenaNotes.insuranceText}
          </p>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="card p-8 lg:p-10">
          <h3 class="t-3">{page.boxTitles.included}</h3>
          <ul class="mt-6 space-y-3">
            {
              kurzIncluded.map((t) => (
                <li class="flex gap-3 text-[0.9375rem] text-ink-3">
                  <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-brass-600" strokeWidth={2.2} />
                  {t}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="card mt-4 p-8 lg:p-10">
          <h3 class="t-3">{page.boxTitles.storno}</h3>
          <dl class="mt-6 space-y-px">
            {
              stornoPodminky.map((s) => (
                <div class="flex flex-wrap items-baseline justify-between gap-3 border-t border-ink/12 py-4 first:border-t-0 first:pt-0">
                  <dt class="text-[0.9375rem] text-ink-3">{s.when}</dt>
                  <dd class="font-display text-[1.25rem] text-brass-700">{s.fee}</dd>
                </div>
              ))
            }
          </dl>
          <p class="mt-5 text-[0.8125rem] text-ink-3">{page.stornoNote}</p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Co s sebou -->
  <Section tone="paper-2" space="lg" id="zabalit">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-5">
        <SectionHead
          title={page.sekce.coSiZabalit.title}
          lead={page.sekce.coSiZabalit.lead}
        />
        <div class="mt-10 overflow-hidden" data-reveal>
          <Image
            src={pokojImg}
            alt={page.images.pokojAlt}
            widths={[400, 800, 1200, 1600]}
            sizes="(min-width: 1024px) 36vw, 100vw"
            class="aspect-[3/2] w-full object-cover"
          />
        </div>
      </div>

      <div class="lg:col-span-7">
        <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2">
          {
            kurzPacking.map((t, i) => (
              <li
                class="flex gap-3 border-b border-ink/10 pb-3 text-[0.9375rem] text-ink-3"
                data-reveal
                style={`--reveal-delay:${Math.min(i * 40, 240)}ms`}
              >
                <span class="mt-2.5 h-px w-3 shrink-0 bg-brass-600" />
                {t}
              </li>
            ))
          }
        </ul>

        <div class="mt-10 border border-ink/12 bg-white p-7">
          <p class="flex items-start gap-3 text-[0.9375rem] leading-relaxed text-ink-3">
            <Icon name="info" class="mt-0.5 h-5 w-5 shrink-0 text-brass-600" />
            <span>
              <strong class="text-ink">{page.odpovednaOsoba.label}</strong>{' '}
              {page.odpovednaOsoba.name}
              <a
                href={`tel:${page.odpovednaOsoba.phoneHref}`}
                class="link-underline text-brass-700"
              >
                {page.odpovednaOsoba.phone}
              </a>
              , <a href={`mailto:${site.email}`} class="link-underline text-brass-700">{site.email}</a>.
              {page.odpovednaOsoba.after}
            </span>
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- CTA -->
  <Section tone="loden" space="md">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <h2 class="t-2 text-white">{page.cta.heading}</h2>
        <p class="lead mt-5 text-white/70">{page.cta.lead}</p>
      </div>
      <div class="flex flex-wrap gap-3 lg:col-span-5 lg:justify-end">
        <a
          href={`mailto:${site.email}?subject=${encodeURIComponent('Dotaz k prázdninovým kurzům')}`}
          class="btn btn-brass"
        >
          <Icon name="mail" class="h-4 w-4" />
          {page.cta.primaryLabel}
        </a>
        <a href={`tel:${page.odpovednaOsoba.phoneHref}`} class="btn btn-ghost-light">
          {page.odpovednaOsoba.phone}
        </a>
      </div>
    </div>
  </Section>
</PageLayout>
