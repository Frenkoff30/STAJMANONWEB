---
import { Image } from 'astro:assets';
import PageLayout from '@/layouts/PageLayout.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import Icon from '@/components/Icon.astro';
import Prose from '@/components/Prose.astro';
import { keyFacts } from '@/data/site';

import { photo } from '@/data/images';
import page from '@/obsah/stranky/o-nas.json';

const heroImg = photo(page.hero.image)!;
const arealImg = photo(page.images.areal)!;
const stajImg = photo(page.images.staj)!;
const klubImg = photo(page.images.klub)!;
---

<PageLayout
  title={page.seo.title}
  description={page.seo.description}
  heading={page.hero.heading}
  lead={page.hero.lead}
  image={heroImg}
  imageAlt={page.hero.imageAlt}
  crumbs={[{ label: 'O nás' }]}
  nav={[
    { id: 'cisla', label: 'V číslech' },
    { id: 'pribeh', label: 'Příběh' },
    { id: 'dnes', label: 'Co děláme dnes' },
  ]}
  heroSize="tall"
>
  <!-- Čísla -->
  <Section tone="paper" space="md" id="cisla">
    <dl class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        keyFacts.map((f, i) => (
          <div class="border-t border-ink/12 pt-5" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <dd class="font-display text-[1.75rem] leading-none">{f.value}</dd>
            <dt class="mt-3 text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-brass-700">
              {f.label}
            </dt>
            <dd class="mt-2 text-[0.875rem] leading-relaxed text-ink-3">{f.note}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <!-- Příběh -->
  <Section tone="paper" space="lg" id="pribeh">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-7">
        <SectionHead title={page.sekce.statekStajAreal.title} />

        <Prose paragraphs={page.pribeh} class="prose-manon mt-8" />

        <div class="mt-10 flex flex-wrap gap-3">
          <a href="/areal" class="btn btn-primary">{page.pribehButtons.primary}</a>
          <a href="/jiri-skrivan" class="btn btn-outline">{page.pribehButtons.secondary}</a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="space-y-4 lg:sticky lg:top-28">
          <div class="overflow-hidden" data-reveal>
            <Image
              src={arealImg}
              alt={page.images.arealAlt}
              widths={[400, 800, 1200]}
              sizes="(min-width: 1024px) 38vw, 100vw"
              class="aspect-[4/3] w-full object-cover"
            />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="overflow-hidden" data-reveal style="--reveal-delay:80ms">
              <Image
                src={stajImg}
                alt={page.images.stajAlt}
                widths={[300, 600]}
                sizes="(min-width: 1024px) 19vw, 45vw"
                class="aspect-square w-full object-cover"
              />
            </div>
            <div class="overflow-hidden" data-reveal style="--reveal-delay:160ms">
              <Image
                src={klubImg}
                alt={page.images.klubAlt}
                widths={[300, 600]}
                sizes="(min-width: 1024px) 19vw, 45vw"
                class="aspect-square w-full object-cover"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- Co děláme -->
  <Section tone="dark" space="lg" id="dnes" rise>
    <SectionHead
      title={page.sekce.ctyriVeciKtereTu.title}
      tone="light"
    />

    <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2">
      {
        page.cinnosti.map((x, i) => (
          <a
            href={x.href}
            class="group border-t border-white/15 pt-5"
            data-reveal
            style={`--reveal-delay:${i * 70}ms`}
          >
            <h3 class="font-display text-[1.625rem] text-white transition-colors group-hover:text-brass-300">
              {x.title}
            </h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-white/60">{x.text}</p>
            <span class="link-arrow mt-6 text-brass-300">
              Více
              <Icon name="arrow-right" class="h-3.5 w-3.5" />
            </span>
          </a>
        ))
      }
    </div>
  </Section>

  <!-- Odkud jméno -->
  <Section tone="paper-2" space="md">
    <div class="container-prose text-center" data-reveal>
      <Icon name="sparkle" class="mx-auto h-6 w-6 text-brass-600" />
      <p class="t-3 mt-6 font-display italic">{page.citat.text}</p>
      <a href="/jiri-skrivan" class="link-arrow mt-8 justify-center">
        {page.citat.linkLabel}
        <Icon name="arrow-right" class="h-3.5 w-3.5" />
      </a>
    </div>
  </Section>
</PageLayout>
