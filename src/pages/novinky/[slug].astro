---
/**
 * Jedna novinka. Vlastní adresa kvůli sdílení na Facebooku: náhled
 * příspěvku si Facebook vezme z nadpisu, popisu a fotky téhle stránky.
 */

export const prerender = false;

import PageLayout from '@/layouts/PageLayout.astro';
import Section from '@/components/Section.astro';
import Icon from '@/components/Icon.astro';
import Prose from '@/components/Prose.astro';
import { formatLong } from '@/data/events';
import { photo } from '@/data/images';
import { site } from '@/data/site';
import { CACHE_NOVINEK, facebookShare, nactiNovinku, odstavce } from '@/lib/novinky';

const n = await nactiNovinku(Astro.params.slug ?? '');
// Smazaná nebo neexistující novinka: zpátky na přehled.
if (!n) return Astro.redirect('/novinky', 302);

Astro.response.headers.set('Cache-Control', CACHE_NOVINEK);

const paragraphs = odstavce(n.text);
const adresa = new URL(`/novinky/${n.slug}`, site.url).href;
const popis = (paragraphs[0] ?? n.nadpis).slice(0, 160);
---

<PageLayout
  title={n.nadpis}
  description={popis}
  heading={n.nadpis}
  lead={formatLong(n.datum)}
  image={photo('areal-letecky')!}
  imageAlt=""
  ogImage={n.foto_url || undefined}
  crumbs={[{ label: 'Novinky', href: '/novinky' }, { label: formatLong(n.datum) }]}
>
  <Section tone="paper" space="lg">
    <article class="mx-auto max-w-2xl">
      {paragraphs.length > 0 && <Prose paragraphs={paragraphs} />}

      {n.foto_url && <img src={n.foto_url} alt="" decoding="async" class="mt-10 w-full" />}

      {
        (n.soubor_url || n.odkaz_url) && (
          <div class="mt-10 flex flex-wrap gap-3">
            {n.soubor_url && (
              <a href={n.soubor_url} class="btn btn-primary" download>
                <Icon name="download" class="h-4 w-4" />
                {n.soubor_nazev || 'Soubor ke stažení'}
              </a>
            )}
            {n.odkaz_url && (
              <a href={n.odkaz_url} class="btn btn-outline" target="_blank" rel="noopener">
                {n.odkaz_nazev || 'Více informací'}
                <Icon name="arrow-right" class="h-4 w-4" />
              </a>
            )}
          </div>
        )
      }

      <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-ink/12 pt-6">
        <a href="/novinky" class="link-arrow">Všechny novinky</a>
        <a
          href={facebookShare(adresa)}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 text-[0.8125rem] font-semibold uppercase tracking-[0.1em] text-ink-3 transition-colors hover:text-brass-700"
        >
          <Icon name="facebook" class="h-4 w-4" />
          Sdílet na Facebooku
        </a>
      </div>
    </article>
  </Section>
</PageLayout>
