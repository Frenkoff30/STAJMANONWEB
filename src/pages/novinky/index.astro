---
/** Všechny novinky. Píšou se ve správě webu, čtou se z databáze při zobrazení. */

export const prerender = false;

import PageLayout from '@/layouts/PageLayout.astro';
import Section from '@/components/Section.astro';
import Icon from '@/components/Icon.astro';
import { formatLong } from '@/data/events';
import { photo } from '@/data/images';
import { CACHE_NOVINEK, nactiNovinky, odstavce } from '@/lib/novinky';

Astro.response.headers.set('Cache-Control', CACHE_NOVINEK);

const heroImg = photo('areal-letecky')!;
const news = await nactiNovinky();
---

<PageLayout
  title="Novinky"
  description="Novinky ze Stáje Manon a areálu Jízdárna Suchá: pozvánky na akce, změny termínů, startovní listiny."
  heading="Novinky"
  lead="Co se ve stáji a v areálu právě děje."
  image={heroImg}
  imageAlt="Areál Jízdárna Suchá z výšky"
  crumbs={[{ label: 'Novinky' }]}
>
  <Section tone="paper" space="lg">
    {
      news.length === 0 ? (
        <p class="text-ink-3">Zatím tu nic není. Novinky najdete i na našem Facebooku.</p>
      ) : (
        <ul class="mx-auto max-w-3xl">
          {news.map((n) => (
            <li class="border-t border-ink/12 last:border-b">
              <a href={`/novinky/${n.slug}`} class="group flex flex-col gap-5 py-8 sm:flex-row sm:gap-8">
                {n.foto_url && (
                  <div class="aspect-[3/2] w-full shrink-0 overflow-hidden bg-ink/5 sm:w-48">
                    <img
                      src={n.foto_url}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover"
                    />
                  </div>
                )}
                <div class="min-w-0">
                  <p class="eyebrow">{formatLong(n.datum)}</p>
                  <h2 class="t-3 mt-2 transition-colors group-hover:text-brass-700">{n.nadpis}</h2>
                  {odstavce(n.text)[0] && (
                    <p class="mt-3 line-clamp-3 text-[0.9375rem] leading-relaxed text-ink-3">
                      {odstavce(n.text)[0]}
                    </p>
                  )}
                  <span class="link-arrow mt-4">
                    Číst dál
                    <Icon name="arrow-right" class="h-3.5 w-3.5" />
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </Section>
</PageLayout>
