---
/**
 * Přihláška na akci. Adresa `/prihlaska/<kód akce>`.
 *
 * Bez registrace a bez hesla: člověk vyplní formulář a hotovo. Vede sem
 * tlačítko „Přihlásit se“ u akce v kalendáři (pole `prihlaska` u akce).
 *
 * Formulář se řídí typem akce (src/lib/prihlasky/typy.ts): tábor se ptá
 * na dítě a zákonného zástupce, jezdecké hry na klub a jeho dvojice.
 * Účastníků může být víc, každý s vlastním výběrem z ceníku.
 *
 * Funguje i bez JavaScriptu — všechny řádky účastníků jsou vykreslené
 * rovnou, skript je jen schovává. Dopočet ceny a ARES jsou taky navíc.
 */

export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import Icon from '@/components/Icon.astro';
import Zprava from '@/components/rezervace/Zprava.astro';
import Pole from '@/components/prihlasky/Pole.astro';
import PlatebniUdaje from '@/components/prihlasky/PlatebniUdaje.astro';
import { photo } from '@/data/images';
import { site } from '@/data/site';
import {
  citelnaChyba,
  prihlaskyNastaveny,
  verejnyKlient,
  type Akce,
  type Prihlaska,
  type Ucastnik,
} from '@/lib/prihlasky/db';
import {
  jsouChyby,
  nactiFormular,
  prazdnyFormular,
  prazdnyRadek,
  prazdny,
  urovne,
  zkontroluj,
  zkusenosti,
  type ChybyUcastniku,
  type Chyby,
} from '@/lib/prihlasky/formular';
import {
  cenaUcastnika,
  kc,
  polozkyUcastnika,
  spoctiCenu,
  terminAkce,
} from '@/lib/prihlasky/platba';
import { pocetUcastniku, polaUcastnika, popisTypu } from '@/lib/prihlasky/typy';
import { odeslatEmail, sestavEmail, type Email } from '@/lib/prihlasky/email';

// Odpověď může obsahovat vyplněné osobní údaje, nesmí se nikde uložit.
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');

let akce: Akce | null = null;

if (prihlaskyNastaveny && Astro.params.kod) {
  const { data } = await verejnyKlient()
    .from('akce')
    .select('*')
    .eq('kod', Astro.params.kod)
    .maybeSingle();
  akce = data as Akce | null;
}

if (prihlaskyNastaveny && !akce) Astro.response.status = 404;

const typ = popisTypu(akce?.typ);

/** Fotka v záhlaví podle typu akce — tábor má děti, závody parkur. */
const heroFotky: Record<string, string> = {
  tabor: 'kurzy-pony',
  pobyt: 'deti-kun',
  hry: 'skola-pony-parkur',
  soustredeni: 'skola-01',
  zavody: 'zavody-skok-01',
};
const heroImg = photo(heroFotky[akce?.typ ?? 'tabor'] ?? 'kurzy-pony')!;

let v = akce ? prazdnyFormular(akce) : null;
let chyby: Chyby = {};
let chybyUcastniku: ChybyUcastniku = {};
let chyba = '';
let hotovo: { prihlaska: Prihlaska; email: Email; odeslano: boolean } | null = null;

if (akce && v && Astro.request.method === 'POST') {
  const formular = await Astro.request.formData();
  v = nactiFormular(formular, akce);
  const vysledek = zkontroluj(v, akce);
  chyby = vysledek.chyby;
  chybyUcastniku = vysledek.ucastnici;

  if (String(formular.get('kontrola') ?? '')) {
    // Skryté pole vyplnil robot.
    chyba = 'Přihlášku se nepodařilo odeslat. Zkuste to prosím znovu.';
  } else if (jsouChyby(vysledek)) {
    chyba = 'V přihlášce něco chybí. Pole k doplnění jsou označená červeně.';
  } else {
    // Databázi posíláme jen to, co potřebuje: cenu si spočítá sama.
    const { data, error } = await verejnyKlient().rpc('odeslat_prihlasku', {
      p: {
        ...v,
        ucastnici: v.ucastnici.map((u) => ({
          jmeno: u.jmeno,
          narozeni: u.narozeni || undefined,
          kun: u.kun || undefined,
          zkusenosti: u.zkusenosti || undefined,
          uroven: u.uroven || undefined,
          licence: u.licence || undefined,
          pojistovna: u.pojistovna || undefined,
          zdravi: u.zdravi || undefined,
          varianty: u.varianty,
          priplatky: u.priplatky,
        })),
      },
    });

    if (error) {
      chyba = citelnaChyba(error);
    } else {
      const odpoved = data as { id: string; vs: string; cena: number; nova: boolean };

      const ucastnici: Ucastnik[] = v.ucastnici.map((u) => ({
        jmeno: u.jmeno,
        narozeni: u.narozeni || undefined,
        kun: u.kun || undefined,
        zkusenosti: u.zkusenosti || undefined,
        uroven: u.uroven || undefined,
        licence: u.licence || undefined,
        pojistovna: u.pojistovna || undefined,
        zdravi: u.zdravi || undefined,
        polozky: polozkyUcastnika(akce, u),
        cena: cenaUcastnika(akce, u),
      }));

      const prihlaska: Prihlaska = {
        ...v,
        id: odpoved.id,
        vs: odpoved.vs,
        cena: odpoved.cena,
        ucastnici,
        stav: 'nova',
        zaplaceno: null,
        faktura_cislo: '',
        poznamka_staje: '',
        vytvoreno: new Date().toISOString(),
        zmeneno: new Date().toISOString(),
      };

      const email = sestavEmail('odeslana', akce, prihlaska, Astro.url.origin);
      let odeslano = false;

      // Obnovení stránky po odeslání vrátí původní přihlášku. E-maily už
      // podruhé neposíláme.
      if (odpoved.nova) {
        [odeslano] = await Promise.all([
          odeslatEmail(email),
          odeslatEmail(sestavEmail('staji', akce, prihlaska, Astro.url.origin)),
        ]);
      }

      hotovo = { prihlaska, email, odeslano };
    }
  }
}

/* --------------------------------------------------------------- vykreslení */

const kontakt = site.contacts.find((c) => /kurzy|pobyty/i.test(c.role)) ?? site.contacts[0]!;

const cenik = akce
  ? {
      varianty: Object.fromEntries(akce.varianty.map((x) => [x.kod, x.cena])),
      priplatky: Object.fromEntries(akce.priplatky.map((x) => [x.kod, x.cena])),
    }
  : null;

const celkem = akce && v ? spoctiCenu(akce, v.ucastnici) : 0;

/** Řádky k vykreslení: vždy tolik, kolik akce dovolí. */
const radky =
  akce && v
    ? Array.from({ length: akce.max_ucastniku }, (_, i) => v!.ucastnici[i] ?? prazdnyRadek())
    : [];

/** Který řádek je vidět hned po načtení — vyplněné a první vždy. */
const viditelnych =
  akce && v
    ? Math.max(1, radky.findLastIndex((u) => !prazdny(u)) + 1, Object.keys(chybyUcastniku).length ? Math.max(...Object.keys(chybyUcastniku).map(Number)) + 1 : 1)
    : 1;

const proKoho = akce
  ? [
      akce.vek_od && `Děti od ${akce.vek_od} let`,
      akce.kapacita > 0 && `nejvýš ${akce.kapacita} účastníků`,
    ]
      .filter(Boolean)
      .join(', ')
  : '';

/** Atributy pro vstup: napojení na chybu nebo nápovědu pod ním. */
const aria = (pole: keyof Chyby) => ({
  id: pole,
  name: pole,
  'aria-invalid': chyby[pole] ? ('true' as const) : undefined,
  'aria-describedby': `${pole}-info`,
});

const volba =
  'flex cursor-pointer items-start gap-4 border border-ink/15 bg-paper p-4 transition-colors hover:border-ink/30 has-[:checked]:border-brass-600 has-[:checked]:bg-brass-100/50 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-brass-500/40';
---

<BaseLayout
  title={akce ? `Přihláška: ${akce.nazev}` : 'Přihláška na akci'}
  description={akce
    ? `Online přihláška na ${akce.nazev}, ${terminAkce(akce)}.`
    : 'Online přihláška na akci Stáje Manon.'}
  overlayHeader={Boolean(akce)}
  noindex
>
  {
    !prihlaskyNastaveny || !akce || !v || !cenik ? (
      <Section tone="paper" space="lg">
        <div class="max-w-2xl">
          <h1 class="t-1">
            {prihlaskyNastaveny ? 'Akci jsme nenašli' : 'Přihlášky se spouští'}
          </h1>
          <p class="lead mt-5">
            {prihlaskyNastaveny
              ? 'Odkaz je možná neúplný, nebo přihláška na tenhle termín už skončila.'
              : 'Online přihlášky zatím nejsou zapnuté.'}{' '}
            Napište nám na{' '}
            <a href={`mailto:${site.email}`} class="link-underline font-semibold text-brass-700">{site.email}</a>, rádi pomůžeme.
          </p>
        </div>
      </Section>
    ) : (
      <>
        <PageHero
          title={akce.nazev}
          lead={akce.podtitul || terminAkce(akce)}
          image={heroImg}
          imageAlt={`Ilustrační fotka k akci ${akce.nazev}`}
          crumbs={[{ label: 'Kalendář akcí', href: '/akce' }, { label: 'Přihláška' }]}
        />

        <Section tone="paper" space="lg">
          <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
            <!-- ------------------------------------------------- o akci -->
            <aside class="lg:col-span-4">
              <div class="lg:sticky lg:top-32">
                <dl class="space-y-px">
                  <div class="border-t border-ink/12 py-4">
                    <dt class="eyebrow">Termín</dt>
                    <dd class="mt-1 font-display text-[1.375rem] leading-snug">
                      {terminAkce(akce)}
                    </dd>
                  </div>
                  {(akce.nastup || akce.odjezd) && (
                    <div class="border-t border-ink/12 py-4">
                      <dt class="eyebrow">Program</dt>
                      <dd class="mt-1 text-[0.9375rem] text-ink-3">
                        {akce.nastup && <span class="block">{akce.nastup}</span>}
                        {akce.odjezd && <span class="block">{akce.odjezd}</span>}
                      </dd>
                    </div>
                  )}
                  {proKoho && (
                    <div class="border-t border-ink/12 py-4">
                      <dt class="eyebrow">Pro koho</dt>
                      <dd class="mt-1 text-[0.9375rem] text-ink-3">{proKoho}</dd>
                    </div>
                  )}
                  {akce.max_ucastniku > 1 && (
                    <div class="border-t border-ink/12 py-4">
                      <dt class="eyebrow">Hromadná přihláška</dt>
                      <dd class="mt-1 text-[0.9375rem] text-ink-3">
                        Na jednu přihlášku jde přidat až {pocetUcastniku(akce.max_ucastniku)}.
                        {typ.subjekt && ' Klub tak pošle celou skupinu najednou.'}
                      </dd>
                    </div>
                  )}
                  <div class="border-t border-b border-ink/12 py-4">
                    <dt class="eyebrow">Platba</dt>
                    <dd class="mt-1 text-[0.9375rem] leading-relaxed text-ink-3">
                      {akce.platba_hned
                        ? 'Převodem nebo QR kódem, platební údaje dostanete hned po odeslání přihlášky. Nebo na místě při akci.'
                        : `Převodem nejpozději ${akce.splatnost_dni} dní před začátkem, na fakturu firmě, nebo na místě při akci.`}
                    </dd>
                  </div>
                </dl>

                {akce.popis && (
                  <p class="mt-6 border-l-2 border-brass-500 pl-5 text-[0.9375rem] leading-relaxed text-ink-3">
                    {akce.popis}
                  </p>
                )}

                <p class="mt-6 flex items-start gap-3 text-[0.875rem] text-ink-3">
                  <Icon name="phone" class="mt-0.5 h-4 w-4 shrink-0 text-brass-600" />
                  <span>
                    S přihláškou poradí {kontakt.name},{' '}
                    <a href={`tel:${kontakt.phoneHref}`} class="link-underline text-brass-700">{kontakt.phone}</a>.
                  </span>
                </p>
              </div>
            </aside>

            <!-- ------------------------------------------------ formulář -->
            <div id="prihlaska" class="scroll-mt-28 lg:col-span-8">
              {hotovo ? (
                <div class="card p-7 lg:p-10" role="status">
                  <p class="eyebrow">Přihláška č. {hotovo.prihlaska.vs}</p>
                  <h2 class="t-2 mt-3">Děkujeme, přihláška dorazila.</h2>
                  <p class="lead mt-5">{typ.potvrzeni}</p>

                  <dl class="mt-8 space-y-px border-t border-ink/12">
                    {hotovo.prihlaska.ucastnici.map((u) => (
                      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-ink/12 py-3">
                        <div>
                          <span class="font-semibold">{u.jmeno}</span>
                          {u.kun && <span class="text-ink-3"> · {u.kun}</span>}
                          <span class="mt-0.5 block text-[0.875rem] text-ink-3">
                            {u.polozky.map((x) => x.nazev).join(', ')}
                          </span>
                        </div>
                        <span class="font-display text-[1.125rem]">{kc(u.cena)}</span>
                      </div>
                    ))}
                    <div class="flex items-baseline justify-between gap-6 py-3">
                      <span class="form-label mb-0">Celkem</span>
                      <span class="font-display text-[1.5rem] leading-none text-brass-700">
                        {kc(hotovo.prihlaska.cena)}
                      </span>
                    </div>
                  </dl>

                  {/* Zaplatit jde rovnou odsud, když akce platbu předem čeká. */}
                  {akce.platba_hned && (
                    <PlatebniUdaje
                      akce={akce}
                      prihlaska={hotovo.prihlaska}
                      class="mt-10"
                    />
                  )}

                  {hotovo.odeslano ? (
                    <p class="mt-8 text-[0.9375rem] text-ink-3">
                      Shrnutí jsme poslali na{' '}
                      <strong class="text-ink">{hotovo.prihlaska.kontakt_email}</strong>.
                      Když nedorazí, podívejte se prosím i do spamu.
                    </p>
                  ) : (
                    <div class="mt-8">
                      <Zprava typ="info">
                        E-maily se zatím neodesílají. Níže je ukázka potvrzení, které
                        přihlášenému přijde, až bude e-mailová služba zapnutá.
                      </Zprava>
                      <details class="mt-4 border border-ink/12 bg-paper-2">
                        <summary class="cursor-pointer px-5 py-4 text-[0.875rem] font-semibold">
                          Ukázka e-mailu: {hotovo.email.predmet}
                        </summary>
                        <iframe
                          srcdoc={hotovo.email.html}
                          sandbox=""
                          title="Ukázka potvrzovacího e-mailu"
                          class="h-[640px] w-full border-t border-ink/12 bg-white"
                        />
                      </details>
                    </div>
                  )}
                </div>
              ) : (
                <form
                  method="post"
                  action="#prihlaska"
                  class="card p-7 lg:p-10"
                  data-prihlaska
                  data-vyber={akce.vyber}
                  data-viditelnych={String(viditelnych)}
                  data-ceny={JSON.stringify(cenik)}
                >
                  <input type="hidden" name="token" value={v.token} />
                  <div class="absolute left-[-9999px]" aria-hidden="true">
                    <label for="kontrola">Nevyplňujte</label>
                    <input type="text" id="kontrola" name="kontrola" tabindex="-1" autocomplete="off" />
                  </div>

                  <h2 class="t-3">Přihláška</h2>
                  <p class="mt-2 text-[0.9375rem] text-ink-3">
                    Žádný účet ani registrace nejsou potřeba — stačí vyplnit formulář.
                    Pole označená <span class="text-brass-700">*</span> jsou povinná.
                    {akce.platba_hned
                      ? ' Po odeslání rovnou dostanete platební údaje.'
                      : ' Přihláška je nezávazná, dokud vám místo nepotvrdíme.'}
                  </p>

                  {chyba && (
                    <Zprava typ="chyba" class="mt-6">
                      {chyba}
                    </Zprava>
                  )}

                  <!-- 1. Za koho -->
                  {typ.subjekt && (
                    <fieldset class="mt-10">
                      <legend class="flex items-baseline gap-3">
                        <span class="eyebrow">01</span>
                        <span class="t-3">Za koho</span>
                      </legend>

                      <Pole
                        pole="subjekt"
                        label={typ.subjekt}
                        povinne={typ.subjektPovinny}
                        napoveda={typ.subjektPopis}
                        chyba={chyby.subjekt}
                        class="mt-5 sm:max-w-md"
                      >
                        <input
                          type="text"
                          {...aria('subjekt')}
                          value={v.subjekt}
                          maxlength="120"
                          autocomplete="organization"
                          required={typ.subjektPovinny}
                          class="form-control"
                        />
                      </Pole>
                    </fieldset>
                  )}

                  <!-- 2. Účastníci -->
                  <fieldset class="mt-12" data-ucastnici>
                    <legend class="flex items-baseline gap-3">
                      <span class="eyebrow">{typ.subjekt ? '02' : '01'}</span>
                      <span class="t-3">
                        {akce.max_ucastniku > 1 ? typ.ucastnici : typ.ucastnik}
                      </span>
                    </legend>

                    {chyby.ucastnici && <p class="form-error mt-3">{chyby.ucastnici}</p>}

                    {radky.map((u, i) => {
                      const ch = chybyUcastniku[i] ?? {};
                      const n = (klic: string) => `ucastnik[${i}].${klic}`;
                      const id = (klic: string) => `ucastnik-${i}-${klic}`;
                      return (
                        <div
                          class:list={[
                            'mt-5 border-t-2 border-ink/15 pt-5',
                            akce.max_ucastniku > 1 && 'first-of-type:mt-6',
                          ]}
                          data-radek
                          data-index={String(i)}
                          hidden={i >= viditelnych}
                        >
                          {akce.max_ucastniku > 1 && (
                            <div class="mb-4 flex items-baseline justify-between gap-4">
                              <p class="eyebrow mb-0">
                                {typ.ucastnik} {i + 1}
                              </p>
                              <button
                                type="button"
                                class="text-[0.75rem] font-semibold uppercase tracking-[0.1em] text-ink-3 transition-colors hover:text-brass-700"
                                data-odebrat
                                hidden
                              >
                                Odebrat
                              </button>
                            </div>
                          )}

                          <div class="grid gap-5 sm:grid-cols-2">
                            <Pole
                              pole={id('jmeno')}
                              label={akce.typ === 'tabor' || akce.typ === 'pobyt' ? 'Jméno a příjmení dítěte' : 'Jméno a příjmení jezdce'}
                              povinne
                              chyba={ch.jmeno}
                            >
                              <input
                                type="text"
                                id={id('jmeno')}
                                name={n('jmeno')}
                                value={u.jmeno}
                                maxlength="80"
                                aria-invalid={ch.jmeno ? 'true' : undefined}
                                class="form-control"
                              />
                            </Pole>

                            {typ.pola.map((p) => {
                              const meta = polaUcastnika[p];
                              const povinne = typ.povinna.includes(p);
                              const trida = meta.sirka === 'plna' ? 'sm:col-span-2' : '';
                              return (
                                <Pole
                                  pole={id(p)}
                                  label={meta.label}
                                  napoveda={meta.napoveda}
                                  povinne={povinne}
                                  chyba={ch[p]}
                                  class={trida}
                                >
                                  {p === 'narozeni' ? (
                                    <input
                                      type="date"
                                      id={id(p)}
                                      name={n(p)}
                                      value={u.narozeni}
                                      aria-invalid={ch[p] ? 'true' : undefined}
                                      class="form-control"
                                    />
                                  ) : p === 'zkusenosti' ? (
                                    <select
                                      id={id(p)}
                                      name={n(p)}
                                      aria-invalid={ch[p] ? 'true' : undefined}
                                      class="form-control"
                                    >
                                      <option value="" selected={!u.zkusenosti}>Vyberte</option>
                                      {zkusenosti.map((z) => (
                                        <option value={z} selected={u.zkusenosti === z}>{z}</option>
                                      ))}
                                    </select>
                                  ) : p === 'uroven' ? (
                                    <select
                                      id={id(p)}
                                      name={n(p)}
                                      aria-invalid={ch[p] ? 'true' : undefined}
                                      class="form-control"
                                    >
                                      <option value="" selected={!u.uroven}>Vyberte</option>
                                      {urovne.map((z) => (
                                        <option value={z} selected={u.uroven === z}>{z}</option>
                                      ))}
                                    </select>
                                  ) : p === 'zdravi' ? (
                                    <textarea
                                      id={id(p)}
                                      name={n(p)}
                                      rows="2"
                                      maxlength="1000"
                                      aria-invalid={ch[p] ? 'true' : undefined}
                                      class="form-control resize-y"
                                    >{u.zdravi}</textarea>
                                  ) : (
                                    <input
                                      type="text"
                                      id={id(p)}
                                      name={n(p)}
                                      value={u[p]}
                                      maxlength="80"
                                      aria-invalid={ch[p] ? 'true' : undefined}
                                      class="form-control"
                                    />
                                  )}
                                </Pole>
                              );
                            })}
                          </div>

                          <!-- ceník tohohle účastníka -->
                          <p class="form-label mt-6">
                            {typ.cenik} <span class="text-brass-700" aria-hidden="true">*</span>
                          </p>
                          <div class="space-y-2">
                            {akce.varianty.map((x) => (
                              <label class={volba}>
                                <input
                                  type={akce.vyber === 'jedna' ? 'radio' : 'checkbox'}
                                  name={n('varianty')}
                                  value={x.kod}
                                  checked={u.varianty.includes(x.kod)}
                                  class="mt-1 h-4 w-4 shrink-0 accent-brass-600"
                                />
                                <span class="min-w-0 flex-1">
                                  <span class="block font-semibold">{x.nazev}</span>
                                  {x.popis && (
                                    <span class="mt-0.5 block text-[0.875rem] text-ink-3">{x.popis}</span>
                                  )}
                                </span>
                                <span class="shrink-0 font-display text-[1.125rem]">{kc(x.cena)}</span>
                              </label>
                            ))}
                          </div>
                          {ch.varianty && <p class="form-error">{ch.varianty}</p>}

                          {akce.priplatky.length > 0 && (
                            <div class="mt-3 space-y-2">
                              {akce.priplatky.map((x) => (
                                <label class={volba}>
                                  <input
                                    type="checkbox"
                                    name={n('priplatky')}
                                    value={x.kod}
                                    checked={u.priplatky.includes(x.kod)}
                                    class="mt-1 h-4 w-4 shrink-0 accent-brass-600"
                                  />
                                  <span class="min-w-0 flex-1">
                                    <span class="block font-semibold">{x.nazev}</span>
                                    {x.popis && (
                                      <span class="mt-0.5 block text-[0.875rem] text-ink-3">{x.popis}</span>
                                    )}
                                  </span>
                                  <span class="shrink-0 font-display text-[1.125rem]">+ {kc(x.cena)}</span>
                                </label>
                              ))}
                            </div>
                          )}

                          {akce.max_ucastniku > 1 && (
                            <p class="mt-3 flex items-baseline justify-between gap-4 text-[0.875rem]">
                              <span class="text-ink-3">Cena</span>
                              <output class="font-display text-[1.125rem]" data-cena-radku>
                                {kc(cenaUcastnika(akce, u))}
                              </output>
                            </p>
                          )}
                        </div>
                      );
                    })}

                    {akce.max_ucastniku > 1 && (
                      <>
                        <button
                          type="button"
                          class="btn btn-outline mt-6 min-h-0 px-5 py-3 text-[0.8125rem]"
                          data-pridat
                          hidden
                        >
                          <Icon name="plus" class="h-4 w-4" />
                          {typ.pridat}
                        </button>
                        <p class="mt-4 text-[0.875rem] text-ink-3" data-bez-js>
                          Vyplňte tolik řádků, kolik potřebujete. Prázdné se do přihlášky
                          nepočítají.
                        </p>
                      </>
                    )}

                    <p class="mt-6 flex items-baseline justify-between gap-4 border-t border-ink/12 pt-4">
                      <span class="form-label mb-0">Celkem</span>
                      <output class="font-display text-[1.5rem] text-brass-700" data-celkem>
                        {kc(celkem)}
                      </output>
                    </p>
                  </fieldset>

                  <!-- 3. Kontaktní osoba -->
                  <fieldset class="mt-12">
                    <legend class="flex items-baseline gap-3">
                      <span class="eyebrow">{typ.subjekt ? '03' : '02'}</span>
                      <span class="t-3">{typ.kontakt}</span>
                    </legend>

                    <div class="mt-5 grid gap-5 sm:grid-cols-2">
                      <Pole pole="kontakt_jmeno" label="Jméno a příjmení" povinne chyba={chyby.kontakt_jmeno}>
                        <input type="text" {...aria('kontakt_jmeno')} value={v.kontakt_jmeno} maxlength="80" autocomplete="name" class="form-control" />
                      </Pole>

                      <Pole pole="kontakt_telefon" label="Telefon" povinne chyba={chyby.kontakt_telefon}>
                        <input type="tel" {...aria('kontakt_telefon')} value={v.kontakt_telefon} maxlength="30" autocomplete="tel" placeholder="+420" class="form-control" />
                      </Pole>

                      <Pole pole="kontakt_email" label="E-mail" povinne napoveda={typ.kontaktPopis} chyba={chyby.kontakt_email}>
                        <input type="email" {...aria('kontakt_email')} value={v.kontakt_email} maxlength="120" autocomplete="email" autocapitalize="off" spellcheck="false" class="form-control" />
                      </Pole>

                      <Pole pole="kontakt_adresa" label="Adresa" chyba={chyby.kontakt_adresa}>
                        <input type="text" {...aria('kontakt_adresa')} value={v.kontakt_adresa} maxlength="200" autocomplete="street-address" class="form-control" />
                      </Pole>
                    </div>
                  </fieldset>

                  <!-- 4. Kdo platí -->
                  <fieldset class="mt-12">
                    <legend class="flex items-baseline gap-3">
                      <span class="eyebrow">{typ.subjekt ? '04' : '03'}</span>
                      <span class="t-3">Jak zaplatíte</span>
                    </legend>

                    <div class="mt-5 grid gap-2 sm:grid-cols-3">
                      <label class={volba}>
                        <input type="radio" name="platce" value="osoba" checked={v.platce === 'osoba'} class="mt-1 h-4 w-4 shrink-0 accent-brass-600" />
                        <span>
                          <span class="block font-semibold">Převodem</span>
                          <span class="mt-0.5 block text-[0.875rem] text-ink-3">
                            S QR kódem pro mobilní banku.
                          </span>
                        </span>
                      </label>
                      <label class={volba}>
                        <input type="radio" name="platce" value="misto" checked={v.platce === 'misto'} class="mt-1 h-4 w-4 shrink-0 accent-brass-600" />
                        <span>
                          <span class="block font-semibold">Na místě</span>
                          <span class="mt-0.5 block text-[0.875rem] text-ink-3">
                            Zaplatíte při akci.
                          </span>
                        </span>
                      </label>
                      <label class={volba}>
                        <input type="radio" name="platce" value="firma" checked={v.platce === 'firma'} class="mt-1 h-4 w-4 shrink-0 accent-brass-600" />
                        <span>
                          <span class="block font-semibold">Na fakturu</span>
                          <span class="mt-0.5 block text-[0.875rem] text-ink-3">
                            Platí firma nebo klub, vystavíme fakturu.
                          </span>
                        </span>
                      </label>
                    </div>

                    <div class="mt-6 border-l-2 border-brass-500 pl-5 sm:pl-6" data-firma>
                      <p class="text-[0.875rem] text-ink-3">
                        Stačí zadat IČO, název a sídlo doplníme z ARES.
                      </p>

                      <div class="mt-5 grid gap-5 sm:grid-cols-2">
                        <Pole pole="firma_ico" label="IČO" povinne chyba={chyby.firma_ico} class="sm:col-span-2">
                          <div class="flex gap-2">
                            <input
                              type="text"
                              {...aria('firma_ico')}
                              value={v.firma_ico}
                              inputmode="numeric"
                              maxlength="12"
                              autocomplete="off"
                              class="form-control max-w-[12rem]"
                              data-ico
                            />
                            <button type="button" class="btn btn-outline shrink-0 px-5" data-ares hidden>
                              Doplnit z ARES
                            </button>
                          </div>
                          <p class="mt-1.5 text-[0.8125rem] text-ink-3" data-ares-stav aria-live="polite"></p>
                        </Pole>

                        <Pole pole="firma_nazev" label="Název" povinne chyba={chyby.firma_nazev} class="sm:col-span-2">
                          <input type="text" {...aria('firma_nazev')} value={v.firma_nazev} maxlength="160" autocomplete="organization" class="form-control" data-ares-nazev />
                        </Pole>

                        <Pole pole="firma_adresa" label="Sídlo" povinne chyba={chyby.firma_adresa} class="sm:col-span-2">
                          <input type="text" {...aria('firma_adresa')} value={v.firma_adresa} maxlength="200" class="form-control" data-ares-adresa />
                        </Pole>

                        <Pole pole="firma_dic" label="DIČ" chyba={chyby.firma_dic}>
                          <input type="text" {...aria('firma_dic')} value={v.firma_dic} maxlength="14" class="form-control" data-ares-dic />
                        </Pole>

                        <Pole pole="firma_objednavka" label="Číslo objednávky" napoveda="Jen když ho firma chce mít na faktuře." chyba={chyby.firma_objednavka}>
                          <input type="text" {...aria('firma_objednavka')} value={v.firma_objednavka} maxlength="60" class="form-control" />
                        </Pole>

                        <Pole pole="firma_email" label="E-mail pro fakturu" povinne napoveda="Třeba účtárna nebo hospodář klubu." chyba={chyby.firma_email} class="sm:col-span-2">
                          <input type="email" {...aria('firma_email')} value={v.firma_email} maxlength="120" autocapitalize="off" spellcheck="false" class="form-control" />
                        </Pole>
                      </div>
                    </div>
                  </fieldset>

                  <!-- 5. Doplnění -->
                  <fieldset class="mt-12">
                    <legend class="flex items-baseline gap-3">
                      <span class="eyebrow">{typ.subjekt ? '05' : '04'}</span>
                      <span class="t-3">Něco dalšího?</span>
                    </legend>

                    <Pole pole="poznamka" label="Poznámka" napoveda="Cokoli, co bychom měli vědět předem." chyba={chyby.poznamka} class="mt-5">
                      <textarea {...aria('poznamka')} rows="3" maxlength="1000" class="form-control resize-y">{v.poznamka}</textarea>
                    </Pole>

                    <div class="mt-8 space-y-4">
                      <label class="flex cursor-pointer items-start gap-3 text-[0.9375rem]">
                        <input
                          type="checkbox"
                          id="souhlas_podminky"
                          name="souhlas_podminky"
                          value="ano"
                          checked={v.souhlas_podminky}
                          required
                          aria-invalid={chyby.souhlas_podminky ? 'true' : undefined}
                          class="mt-1 h-4 w-4 shrink-0 accent-brass-600"
                        />
                        <span>
                          Souhlasím s{' '}
                          <a href="/kurzy#cena" target="_blank" class="link-underline font-semibold text-brass-700">
                            podmínkami účasti
                          </a>{' '}
                          a se zpracováním osobních údajů pro účely akce.{' '}
                          <span class="text-brass-700" aria-hidden="true">*</span>
                        </span>
                      </label>
                      {chyby.souhlas_podminky && <p class="form-error">{chyby.souhlas_podminky}</p>}

                      <label class="flex cursor-pointer items-start gap-3 text-[0.9375rem]">
                        <input
                          type="checkbox"
                          name="souhlas_foto"
                          value="ano"
                          checked={v.souhlas_foto}
                          class="mt-1 h-4 w-4 shrink-0 accent-brass-600"
                        />
                        <span class="text-ink-3">{typ.souhlasFoto}</span>
                      </label>
                    </div>
                  </fieldset>

                  <div class="mt-10 flex flex-wrap items-center justify-between gap-5 border-t border-ink/12 pt-8">
                    <p class="text-[0.9375rem] text-ink-3">
                      Celkem{' '}
                      <output class="font-display text-[1.375rem] text-ink" data-celkem>
                        {kc(celkem)}
                      </output>
                    </p>
                    <button type="submit" class="btn btn-primary" data-odeslat>
                      Odeslat přihlášku
                      <Icon name="arrow-right" class="h-4 w-4" />
                    </button>
                  </div>
                </form>
              )}
            </div>
          </div>
        </Section>
      </>
    )
  }
</BaseLayout>

<style is:global>
  /* Firemní údaje jen když platí firma. Bez JavaScriptu, jen CSS. */
  [data-prihlaska]:has(input[name='platce'][value='osoba']:checked) [data-firma],
  [data-prihlaska]:has(input[name='platce'][value='misto']:checked) [data-firma] {
    display: none;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-prihlaska]');

  if (form) {
    const cenik = JSON.parse(form.dataset.ceny ?? '{}') as {
      varianty: Record<string, number>;
      priplatky: Record<string, number>;
    };
    const kc = (n: number) => `${n.toLocaleString('cs-CZ')} Kč`;

    /* ---- účastníci ----------------------------------------------------- */
    const radky = [...form.querySelectorAll<HTMLElement>('[data-radek]')];
    const pridat = form.querySelector<HTMLButtonElement>('[data-pridat]');
    const bezJs = form.querySelector<HTMLElement>('[data-bez-js]');
    let viditelnych = Number(form.dataset.viditelnych ?? 1);

    /** Prázdný řádek jde odebrat, poslední viditelný ne. */
    const prekreslit = () => {
      radky.forEach((r, i) => {
        r.hidden = i >= viditelnych;
        const odebrat = r.querySelector<HTMLButtonElement>('[data-odebrat]');
        if (odebrat) odebrat.hidden = i !== viditelnych - 1 || viditelnych <= 1;
      });
      if (pridat) pridat.hidden = viditelnych >= radky.length;
    };

    if (radky.length > 1) {
      bezJs?.remove();
      prekreslit();

      pridat?.addEventListener('click', () => {
        if (viditelnych >= radky.length) return;
        viditelnych += 1;
        prekreslit();
        radky[viditelnych - 1]
          ?.querySelector<HTMLInputElement>('input[type="text"]')
          ?.focus();
      });

      form.addEventListener('click', (e) => {
        const tlacitko = (e.target as HTMLElement).closest('[data-odebrat]');
        if (!tlacitko) return;
        const radek = radky[viditelnych - 1];
        // Odebraný řádek se vyprázdní, ať do přihlášky nespadne.
        radek?.querySelectorAll<HTMLInputElement>('input, select, textarea').forEach((pole) => {
          if (pole.type === 'checkbox' || pole.type === 'radio') pole.checked = false;
          else pole.value = '';
        });
        viditelnych = Math.max(1, viditelnych - 1);
        prekreslit();
        prepocitat();
      });
    }

    /* ---- cena ---------------------------------------------------------- */
    const prepocitat = () => {
      const data = new FormData(form);
      let celkem = 0;

      radky.forEach((radek, i) => {
        if (radek.hidden) {
          const vystup = radek.querySelector('[data-cena-radku]');
          if (vystup) vystup.textContent = kc(0);
          return;
        }
        const soucet = [
          ...data.getAll(`ucastnik[${i}].varianty`).map((k) => cenik.varianty[String(k)] ?? 0),
          ...data.getAll(`ucastnik[${i}].priplatky`).map((k) => cenik.priplatky[String(k)] ?? 0),
        ].reduce((s, x) => s + x, 0);

        const vystup = radek.querySelector('[data-cena-radku]');
        if (vystup) vystup.textContent = kc(soucet);
        celkem += soucet;
      });

      form.querySelectorAll('[data-celkem]').forEach((el) => {
        el.textContent = kc(celkem);
      });
    };
    form.addEventListener('change', prepocitat);
    prepocitat();

    /* ---- ARES ---------------------------------------------------------- */
    const ico = form.querySelector<HTMLInputElement>('[data-ico]');
    const tlacitko = form.querySelector<HTMLButtonElement>('[data-ares]');
    const stav = form.querySelector<HTMLElement>('[data-ares-stav]');
    const pole = {
      nazev: form.querySelector<HTMLInputElement>('[data-ares-nazev]'),
      adresa: form.querySelector<HTMLInputElement>('[data-ares-adresa]'),
      dic: form.querySelector<HTMLInputElement>('[data-ares-dic]'),
    };

    if (ico && tlacitko && stav && pole.nazev && pole.adresa && pole.dic) {
      let posledni = '';
      tlacitko.hidden = false;

      const nacist = async () => {
        const hodnota = ico.value.replace(/\s/g, '');
        if (!/^\d{8}$/.test(hodnota) || hodnota === posledni) return;
        posledni = hodnota;

        tlacitko.disabled = true;
        stav.textContent = 'Hledám firmu v ARES…';

        try {
          const odpoved = await fetch(`/prihlasky/ares?ico=${hodnota}`);
          const data = await odpoved.json();

          if (!odpoved.ok) {
            stav.textContent = data.chyba ?? 'Firmu se nepodařilo najít.';
            posledni = '';
            return;
          }

          pole.nazev!.value = data.nazev;
          pole.adresa!.value = data.adresa;
          pole.dic!.value = data.dic;
          stav.textContent = `Doplněno z ARES: ${data.nazev}`;
        } catch {
          stav.textContent = 'ARES teď neodpovídá. Údaje prosím vyplňte ručně.';
          posledni = '';
        } finally {
          tlacitko.disabled = false;
        }
      };

      tlacitko.addEventListener('click', () => {
        posledni = '';
        nacist();
      });
      ico.addEventListener('input', () => {
        if (/^\d{8}$/.test(ico.value.replace(/\s/g, ''))) nacist();
      });
    }

    /* ---- dvojklik ------------------------------------------------------ */
    form.addEventListener('submit', () => {
      const odeslat = form.querySelector<HTMLButtonElement>('[data-odeslat]');
      if (odeslat) odeslat.disabled = true;
    });
  }
</script>
