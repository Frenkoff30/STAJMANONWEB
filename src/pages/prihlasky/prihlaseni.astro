---
/**
 * Přihlášení do správy přihlášek.
 *
 * Účty zakládá vývojář v Supabase a zapisuje je do `prihlasky_spravci`
 * (viz konec `supabase/prihlasky.sql`). Registrace tu schválně není.
 */

export const prerender = false;

import PrihlaskyLayout from '@/layouts/PrihlaskyLayout.astro';
import Zprava from '@/components/rezervace/Zprava.astro';
import { citelnaChyba, klientSpravy, prihlaskyNastaveny } from '@/lib/prihlasky/db';
import { bezCache, nactiSpravce } from '@/lib/prihlasky/spravce';

bezCache(Astro.response.headers);

/** Po přihlášení jen na adresu uvnitř správy, nikam ven. */
function bezpecnyCil(hodnota: string | null): string {
  if (!hodnota || !hodnota.startsWith('/prihlasky/sprava')) return '/prihlasky/sprava';
  return hodnota;
}

const dal = bezpecnyCil(Astro.url.searchParams.get('dal'));

if (await nactiSpravce(Astro)) return Astro.redirect(dal);

let chyba = '';
let email = '';

if (Astro.request.method === 'POST' && prihlaskyNastaveny) {
  const formular = await Astro.request.formData();
  email = String(formular.get('email') ?? '').trim();
  const heslo = String(formular.get('heslo') ?? '');

  if (!email || !heslo) {
    chyba = 'Vyplňte prosím e-mail i heslo.';
  } else {
    const supabase = klientSpravy(Astro);
    const { error } = await supabase.auth.signInWithPassword({ email, password: heslo });

    if (error) {
      chyba = citelnaChyba(error);
    } else if (await nactiSpravce(Astro, supabase)) {
      return Astro.redirect(bezpecnyCil(String(formular.get('dal') ?? dal)));
    } else {
      // Heslo sedí, ale účet do správy přihlášek nepatří (třeba jezdec
      // z rezervací). Session hned zase zavřeme.
      await supabase.auth.signOut();
      chyba = 'Tenhle účet nemá přístup ke správě přihlášek.';
    }
  }
}

const odhlasen = Astro.url.searchParams.has('odhlasen');
---

<PrihlaskyLayout
  title="Přihlášení do správy přihlášek"
  heading="Správa přihlášek"
  lead="Přihlášky na tábory vyřizuje stáj. Přihlaste se účtem, který vám založil správce webu."
  spravce={null}
  uzky
>
  {
    !prihlaskyNastaveny ? (
      <Zprava typ="info">Přihlášky zatím nejsou zapnuté.</Zprava>
    ) : (
      <>
        {odhlasen && (
          <Zprava typ="ok" class="mb-6">
            Odhlášení proběhlo, na shledanou.
          </Zprava>
        )}

        <form method="post" class="card p-7 lg:p-9">
          <input type="hidden" name="dal" value={dal} />

          {chyba && <Zprava typ="chyba" class="mb-6">{chyba}</Zprava>}

          <div class="space-y-5">
            <div>
              <label for="email" class="form-label">E-mail</label>
              <input
                type="email"
                id="email"
                name="email"
                value={email}
                required
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                class="form-control"
              />
            </div>

            <div>
              <label for="heslo" class="form-label">Heslo</label>
              <input
                type="password"
                id="heslo"
                name="heslo"
                required
                autocomplete="current-password"
                class="form-control"
              />
            </div>
          </div>

          <button type="submit" class="btn btn-primary mt-8 w-full">Přihlásit se</button>
        </form>
      </>
    )
  }
</PrihlaskyLayout>
