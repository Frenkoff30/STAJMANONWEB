---
/**
 * Založení a úprava akce.
 *
 * Tohle je jediné místo, kde se akce zadávají: podle nich se plní kalendář
 * na webu, a když je zaškrtnuté přihlašování, běží na akci i online
 * přihláška. Formulář je schválně nahoře krátký (druh, název, termín),
 * ceník se ukáže až se zaškrtnutým přihlašováním a zbytek je schovaný
 * v „Dalším nastavení“.
 *
 * Adresa `/prihlasky/sprava/akce/nova` zakládá, jakýkoli jiný kód upravuje.
 * Zápis je POST a po něm přesměrování, takže obnovení stránky nic nezopakuje.
 *
 * Kód akce se po založení nemění: odkazují se na něj odeslané přihlášky.
 */

export const prerender = false;

import PrihlaskyLayout from '@/layouts/PrihlaskyLayout.astro';
import Zprava from '@/components/rezervace/Zprava.astro';
import Pole from '@/components/prihlasky/Pole.astro';
import Icon from '@/components/Icon.astro';
import { citelnaChyba, sdilenaDatabaze, type Akce } from '@/lib/prihlasky/db';
import { VSECHNY, srovnejBlokace, zrusBlokace } from '@/lib/prihlasky/zavirani';
import type { Jizdarna } from '@/lib/rezervace';
import {
  RADKU_CENIKU,
  jsouChyby,
  nactiAkci,
  prazdnaAkce,
  proDatabazi,
  radkyCeniku,
  zkontrolujAkci,
  type ChybyAkce,
  type ChybyCeniku,
  type VyplnenaAkce,
} from '@/lib/prihlasky/akce';
import { eventKindLabels, type EventKind } from '@/data/events';
import { bezCache, nactiSpravce } from '@/lib/prihlasky/spravce';
import { PRIPONY_DOKUMENTU, druhSouboru, nahratSoubor } from '@/lib/prihlasky/soubory';

bezCache(Astro.response.headers);

const kod = Astro.params.kod ?? '';
const novaAkce = kod === 'nova';
const adresa = `/prihlasky/sprava/akce/${kod}`;

const spravce = await nactiSpravce(Astro);
if (!spravce) {
  return Astro.redirect(`/prihlasky/prihlaseni?dal=${encodeURIComponent(adresa)}`);
}

if (!novaAkce && !/^[a-z0-9-]{3,60}$/.test(kod)) {
  return Astro.redirect('/prihlasky/sprava');
}

/** Načte akci z databáze. U nové vrátí `null`. */
const nacist = async (): Promise<Akce | null> => {
  if (novaAkce) return null;
  const { data } = await spravce.supabase
    .from('akce')
    .select('*')
    .eq('kod', kod)
    .maybeSingle<Akce>();
  return data;
};

const ulozena = await nacist();
if (!novaAkce && !ulozena) return Astro.redirect('/prihlasky/sprava');

/**
 * Jízdárny, které jde akcí zavřít. Když přihlášky běží v samostatné
 * databázi, žádné rezervace tam nejsou a volba se vůbec nenabídne.
 */
let jizdarny: Jizdarna[] = [];
if (sdilenaDatabaze) {
  const { data } = await spravce.supabase
    .from('jizdarny')
    .select('*')
    .eq('aktivni', true)
    .order('poradi');
  jizdarny = (data as Jizdarna[]) ?? [];
}

/** Kolik přihlášek na akci už je. Rozhoduje o tom, jestli jde smazat. */
let pocetPrihlasek = 0;
if (ulozena) {
  const { count } = await spravce.supabase
    .from('prihlasky')
    .select('id', { count: 'exact', head: true })
    .eq('akce', ulozena.kod);
  pocetPrihlasek = count ?? 0;
}

/* ------------------------------------------------------------------ zápis */

let chyba = '';
let chyby: ChybyAkce = {};
let cenikChyby: ChybyCeniku = { varianty: {}, priplatky: {} };

/** Co se vykreslí do formuláře: uložený stav, nebo to, co přišlo z POSTu. */
let akce: VyplnenaAkce = ulozena
  ? { ...ulozena, varianty: ulozena.varianty ?? [], priplatky: ulozena.priplatky ?? [] }
  : prazdnaAkce((Astro.url.searchParams.get('druh') as EventKind) ?? 'zavody');

if (Astro.request.method === 'POST') {
  const formular = await Astro.request.formData();
  const co = String(formular.get('co') ?? '');

  if (co === 'smazat' && ulozena) {
    if (pocetPrihlasek > 0) {
      chyba = 'Na akci už jsou přihlášky, proto ji nejde smazat. Zavřete ji místo toho.';
    } else {
      const { error } = await spravce.supabase.from('akce').delete().eq('kod', ulozena.kod);
      if (error) {
        chyba = citelnaChyba(error);
      } else {
        // Zrušená akce po sobě nenechá zavřené jízdárny.
        if (sdilenaDatabaze) await zrusBlokace(spravce.supabase, ulozena.kod);
        return Astro.redirect('/prihlasky/sprava?hotovo=akce-smazana');
      }
    }
  } else if (co === 'ulozit') {
    akce = nactiAkci(formular);
    // Kód je primární klíč a odkazují se na něj přihlášky, u úpravy
    // se proto bere ten uložený, ne ten z formuláře.
    if (ulozena) akce.kod = ulozena.kod;

    // Rozpis zůstává, dokud ho někdo nevymění nebo neodebere.
    akce.rozpis_url = ulozena?.rozpis_url ?? '';
    akce.rozpis_nazev = ulozena?.rozpis_nazev ?? '';
    if (formular.get('rozpis_odebrat') === 'ano') {
      akce.rozpis_url = '';
      akce.rozpis_nazev = '';
    }

    const vysledek = zkontrolujAkci(akce);
    chyby = vysledek.chyby;
    cenikChyby = vysledek.cenik;

    // Soubor se nahrává až u jinak bezchybného formuláře, ať v úložišti
    // nezůstávají rozpisy k akcím, které se nakonec neuložily.
    const soubor = formular.get('rozpis');
    if (!jsouChyby(vysledek) && soubor instanceof File && soubor.size > 0) {
      const nahrano = await nahratSoubor(
        spravce.supabase,
        soubor,
        'akce',
        akce.kod,
        PRIPONY_DOKUMENTU,
      );
      if ('chyba' in nahrano) {
        chyby.rozpis_url = nahrano.chyba;
      } else {
        akce.rozpis_url = nahrano.url;
        akce.rozpis_nazev = `Rozpis (${druhSouboru(nahrano.pripona)})`;
      }
    }

    if (!jsouChyby({ chyby, cenik: cenikChyby })) {
      if (novaAkce) {
        const { error } = await spravce.supabase.from('akce').insert(proDatabazi(akce));
        if (error) {
          chyba = /duplicate key|already exists/i.test(error.message ?? '')
            ? `Akce s adresou „${akce.kod}" už existuje. Změňte prosím název nebo v Dalším nastavení adresu přihlášky.`
            : citelnaChyba(error);
        } else {
          const potiz = sdilenaDatabaze
            ? await srovnejBlokace(spravce.supabase, akce)
            : '';
          return Astro.redirect(
            potiz
              ? `${adresa}?hotovo=ulozena&potiz=blokace`
              : '/prihlasky/sprava?hotovo=akce-zalozena',
          );
        }
      } else {
        const { error } = await spravce.supabase
          .from('akce')
          .update(proDatabazi(akce))
          .eq('kod', akce.kod);
        if (error) {
          chyba = citelnaChyba(error);
        } else {
          const potiz = sdilenaDatabaze
            ? await srovnejBlokace(spravce.supabase, akce)
            : '';
          return Astro.redirect(
            `${adresa}?hotovo=ulozena${potiz ? '&potiz=blokace' : ''}`,
          );
        }
      }
    }
  }
}

/* ---------------------------------------------------------------- render */

const hotovo = Astro.url.searchParams.get('hotovo') ?? '';

const druhy = Object.entries(eventKindLabels) as [EventKind, string][];

const varianty = radkyCeniku(akce.varianty);
const priplatky = radkyCeniku(akce.priplatky);

/** Kolik řádků ceníku ukázat rovnou: vyplněné plus jeden prázdný navrch. */
const viditelnychVariant = Math.min(Math.max(akce.varianty.length + 1, 2), RADKU_CENIKU);
const viditelnychPriplatku = Math.min(Math.max(akce.priplatky.length + 1, 1), RADKU_CENIKU);

/** „Další nastavení“ se otevře samo, když je v něm chyba. */
const chybaVeDalsim = Boolean(
  chyby.kod || chyby.vek_od || chyby.kapacita || chyby.max_ucastniku || chyby.splatnost_dni,
);

const nadpis = novaAkce ? 'Nová akce' : akce.nazev;
---

<PrihlaskyLayout
  title={novaAkce ? 'Nová akce' : `Úprava akce: ${akce.nazev}`}
  heading={nadpis}
  lead={novaAkce
    ? 'Vyplňte, co to je a kdy. Po uložení se akce hned objeví v kalendáři na webu.'
    : 'Změny se v kalendáři na webu projeví do minuty.'}
  spravce={spravce}
  crumbs={[{ label: novaAkce ? 'Nová akce' : akce.nazev }]}
>
  {hotovo === 'ulozena' && <Zprava typ="ok" class="mb-8">Změny jsou uložené.</Zprava>}
  {
    Astro.url.searchParams.get('potiz') === 'blokace' && (
      <Zprava typ="dulezite" class="mb-8">
        Akce je uložená, ale zavřít jízdárnu se nepodařilo. Zkuste to znovu,
        nebo termín zavřete ručně ve správě rezervací.
      </Zprava>
    )
  }
  {chyba && <Zprava typ="chyba" class="mb-8">{chyba}</Zprava>}
  {
    jsouChyby({ chyby, cenik: cenikChyby }) && (
      <Zprava typ="chyba" class="mb-8">
        Formulář se neuložil, projděte prosím označená pole.
      </Zprava>
    )
  }

  {
    !novaAkce && ulozena?.prihlasovani && (
      <div class="mb-8 flex flex-wrap items-center justify-between gap-4 border border-ink/12 bg-paper-2 p-5">
        <div>
          <p class="eyebrow">Přihláška na webu</p>
          <a
            href={`/prihlaska/${akce.kod}`}
            class="link-underline font-display text-[1.125rem] text-brass-700"
          >
            /prihlaska/{akce.kod}
          </a>
        </div>
        <p class="text-[0.875rem] text-ink-3">
          {pocetPrihlasek === 0
            ? 'Zatím bez přihlášek'
            : `${pocetPrihlasek} ${pocetPrihlasek === 1 ? 'přihláška' : pocetPrihlasek < 5 ? 'přihlášky' : 'přihlášek'}`}
        </p>
      </div>
    )
  }

  <form
    method="post"
    enctype="multipart/form-data"
    data-akce
    data-nova={novaAkce ? 'ano' : undefined}
    class="space-y-12"
  >
    <input type="hidden" name="co" value="ulozit" />

    <!-- ------------------------------------------------------------ akce -->
    <section>
      <div class="grid gap-6 sm:grid-cols-2">
        <Pole pole="druh" label="Druh akce" povinne>
          <select id="druh" name="druh" data-druh class="form-control">
            {
              druhy.map(([hodnota, label]) => (
                <option value={hodnota} selected={akce.druh === hodnota}>
                  {label}
                </option>
              ))
            }
          </select>
        </Pole>

        <div class="hidden sm:block"></div>

        <Pole pole="nazev" label="Název" povinne chyba={chyby.nazev} class="sm:col-span-2">
          <input
            type="text"
            id="nazev"
            name="nazev"
            value={akce.nazev}
            maxlength="120"
            required
            data-nazev
            placeholder="Například: Jarní skokové závody"
            class="form-control"
            aria-describedby={chyby.nazev ? 'nazev-info' : undefined}
            aria-invalid={chyby.nazev ? 'true' : undefined}
          />
        </Pole>

        <Pole pole="zacatek" label="Datum" povinne chyba={chyby.zacatek}>
          <input
            type="date"
            id="zacatek"
            name="zacatek"
            value={akce.zacatek}
            required
            data-zacatek
            class="form-control"
            aria-describedby={chyby.zacatek ? 'zacatek-info' : undefined}
            aria-invalid={chyby.zacatek ? 'true' : undefined}
          />
        </Pole>

        <Pole
          pole="konec"
          label="Do"
          chyba={chyby.konec}
          napoveda="Jen u vícedenní akce. Jinak nechte prázdné."
        >
          <input
            type="date"
            id="konec"
            name="konec"
            value={akce.konec && akce.konec !== akce.zacatek ? akce.konec : ''}
            class="form-control"
            aria-describedby="konec-info"
            aria-invalid={chyby.konec ? 'true' : undefined}
          />
        </Pole>

        <Pole
          pole="podtitul"
          label="Krátký popis"
          napoveda="Jeden řádek pod názvem v kalendáři. Například: halové parkury Z–L a hobby do 90 cm."
          class="sm:col-span-2"
        >
          <input
            type="text"
            id="podtitul"
            name="podtitul"
            value={akce.podtitul}
            maxlength="160"
            class="form-control"
            aria-describedby="podtitul-info"
          />
        </Pole>

        <Pole
          pole="rozpis"
          label="Rozpis ke stažení"
          chyba={chyby.rozpis_url}
          napoveda="Nepovinné. PDF, Word, Excel nebo fotka, do 4 MB."
          class="sm:col-span-2"
        >
          {
            akce.rozpis_url && (
              <p class="mb-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-[0.9375rem]">
                <a href={akce.rozpis_url} class="link-underline text-brass-700" target="_blank" rel="noopener">
                  {akce.rozpis_nazev || 'Rozpis'}
                </a>
                <label class="flex cursor-pointer items-center gap-2 text-ink-3">
                  <input
                    type="checkbox"
                    name="rozpis_odebrat"
                    value="ano"
                    class="h-4 w-4 accent-[var(--color-brass-600)]"
                  />
                  Odebrat
                </label>
              </p>
            )
          }
          <input
            type="file"
            id="rozpis"
            name="rozpis"
            accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png"
            class="form-control"
            aria-describedby="rozpis-info"
            aria-invalid={chyby.rozpis_url ? 'true' : undefined}
          />
        </Pole>
      </div>

      <label class="mt-6 flex cursor-pointer items-start gap-3">
        <input
          type="checkbox"
          name="zvyraznit"
          value="ano"
          checked={akce.zvyraznit}
          class="mt-1 h-5 w-5 shrink-0 accent-[var(--color-brass-600)]"
        />
        <span class="text-[0.9375rem]">
          <strong class="block">Vrchol sezóny</strong>
          <span class="text-ink-3">V kalendáři se akce zvýrazní a ukáže nahoře na stránce.</span>
        </span>
      </label>

      {/* Akce si může zabrat jízdárnu — na celé dny svého konání se pak
          nedá rezervovat a členové tam místo volných políček vidí její
          název. Mění se spolu s termínem akce, ručně se nic dohledávat
          nemusí. */}
      {
        jizdarny.length > 0 && (
          <div class="mt-6 border border-ink/12 bg-paper-2 p-5 sm:p-7">
            <Pole
              pole="zavrit_jizdarnu"
              label="Zavřít jízdárnu po dobu akce"
              napoveda="Na všechny dny akce. V rezervacích pak místo volných termínů svítí název akce."
            >
              <select id="zavrit_jizdarnu" name="zavrit_jizdarnu" class="form-control">
                <option value="" selected={!akce.zavrit_jizdarnu}>
                  Nezavírat, jízdárny jedou dál
                </option>
                <option value={VSECHNY} selected={akce.zavrit_jizdarnu === VSECHNY}>
                  Všechny jízdárny — celý areál na akci
                </option>
                {jizdarny.map((j) => (
                  <option value={j.kod} selected={akce.zavrit_jizdarnu === j.kod}>
                    {j.nazev}
                  </option>
                ))}
              </select>
            </Pole>
          </div>
        )
      }
    </section>

    <!-- ----------------------------------------------------- přihlašování -->
    <section class="border border-ink/12 bg-paper-2 p-5 sm:p-7">
      <label class="flex cursor-pointer items-start gap-3">
        <input
          type="checkbox"
          name="prihlasovani"
          value="ano"
          checked={akce.prihlasovani}
          data-prihlasovani
          class="mt-1 h-5 w-5 shrink-0 accent-[var(--color-brass-600)]"
        />
        <span>
          <strong class="block font-display text-[1.375rem] font-normal">
            Přihlašování přes web
          </strong>
          <span class="text-[0.9375rem] text-ink-3">
            Zaškrtněte, když se na akci mají lidé hlásit online. U akce v kalendáři pak bude
            tlačítko Vyplnit přihlášku a přihlášky vám budou chodit sem.
          </span>
        </span>
      </label>

      <div data-cast-prihlasky hidden={!akce.prihlasovani} class="mt-8 space-y-10">
        <!-- ceník -->
        <div>
          <h2 class="t-3">Cena</h2>
          <p class="mt-2 max-w-2xl text-[0.9375rem] text-ink-3">
            Napište, co si lidé vybírají a za kolik. Stačí jeden řádek, třeba
            „Startovné“ a cena. Příplatky jsou dobrovolné, třeba box pro koně.
          </p>
          {chyby.varianty && <p class="form-error mt-3">{chyby.varianty}</p>}

          {
            (['varianty', 'priplatky'] as const).map((seznam) => {
              const radky = seznam === 'varianty' ? varianty : priplatky;
              const viditelnych =
                seznam === 'varianty' ? viditelnychVariant : viditelnychPriplatku;
              const chybySeznamu = cenikChyby[seznam];

              return (
                <div class="mt-8" data-cenik={seznam} data-viditelnych={String(viditelnych)}>
                  <h3 class="text-[0.75rem] font-semibold uppercase tracking-[0.12em] text-ink-3">
                    {seznam === 'varianty' ? 'Co si vybírají' : 'Příplatky (nepovinné)'}
                  </h3>

                  <ul class="mt-3 space-y-px">
                    {radky.map((p, i) => (
                      <li
                        class="border-t border-ink/12 py-4 last:border-b"
                        data-radek
                        hidden={i >= viditelnych}
                      >
                        <div class="grid gap-4 sm:grid-cols-[1fr_9rem]">
                          <Pole
                            pole={`${seznam}-${i}-nazev`}
                            label={`${i + 1}. položka`}
                            chyba={chybySeznamu[i]}
                          >
                            <input
                              type="text"
                              id={`${seznam}-${i}-nazev`}
                              name={`${seznam}[${i}].nazev`}
                              value={p?.nazev ?? ''}
                              maxlength="120"
                              placeholder={
                                i === 0
                                  ? seznam === 'varianty'
                                    ? 'Startovné'
                                    : 'Box pro koně'
                                  : ''
                              }
                              class="form-control"
                              aria-describedby={chybySeznamu[i] ? `${seznam}-${i}-nazev-info` : undefined}
                              aria-invalid={chybySeznamu[i] ? 'true' : undefined}
                            />
                          </Pole>

                          <Pole pole={`${seznam}-${i}-cena`} label="Cena v Kč">
                            <input
                              type="number"
                              inputmode="numeric"
                              id={`${seznam}-${i}-cena`}
                              name={`${seznam}[${i}].cena`}
                              value={p ? String(p.cena) : ''}
                              min="0"
                              max="999999"
                              step="1"
                              class="form-control"
                            />
                          </Pole>
                        </div>

                        <Pole pole={`${seznam}-${i}-popis`} label="Upřesnění" class="mt-4">
                          <input
                            type="text"
                            id={`${seznam}-${i}-popis`}
                            name={`${seznam}[${i}].popis`}
                            value={p?.popis ?? ''}
                            maxlength="300"
                            placeholder="Nepovinné, ukáže se drobným pod názvem"
                            class="form-control"
                          />
                        </Pole>
                        {/* Kód položky se doplňuje sám z názvu. U uložených
                            položek ho držíme, ať se neztratí vazba na přihlášky. */}
                        <input type="hidden" name={`${seznam}[${i}].kod`} value={p?.kod ?? ''} />
                      </li>
                    ))}
                  </ul>

                  <button type="button" class="btn btn-outline mt-4" data-pridat hidden>
                    <Icon name="plus" class="h-4 w-4" />
                    Přidat řádek
                  </button>
                </div>
              );
            })
          }
        </div>

        <label class="flex cursor-pointer items-start gap-3">
          <input
            type="checkbox"
            name="otevreno"
            value="ano"
            checked={akce.otevreno}
            class="mt-1 h-5 w-5 shrink-0 accent-[var(--color-brass-600)]"
          />
          <span class="text-[0.9375rem]">
            <strong class="block">Přihlášky otevřené</strong>
            <span class="text-ink-3">
              Až bude plno, odškrtněte. Akce zůstane v kalendáři, jen se na ni nepůjde hlásit.
            </span>
          </span>
        </label>

        <!-- další nastavení -->
        <details class="border border-ink/12 bg-white" open={chybaVeDalsim}>
          <summary class="cursor-pointer px-5 py-4 text-[0.9375rem] font-semibold">
            Další nastavení přihlášky
            <span class="ml-2 font-normal text-ink-3">nepovinné, většinou není potřeba</span>
          </summary>

          <div class="grid gap-6 border-t border-ink/12 p-5 sm:grid-cols-2">
            <Pole
              pole="popis"
              label="Delší popis"
              napoveda="Ukáže se nahoře na stránce s přihláškou."
              class="sm:col-span-2"
            >
              <textarea
                id="popis"
                name="popis"
                rows="4"
                maxlength="2000"
                class="form-control"
                aria-describedby="popis-info">{akce.popis}</textarea>
            </Pole>

            <Pole
              pole="nastup"
              label="Nástup nebo prezentace"
              napoveda="Například: prezentace 8.00–9.00."
            >
              <input
                type="text"
                id="nastup"
                name="nastup"
                value={akce.nastup}
                maxlength="120"
                class="form-control"
                aria-describedby="nastup-info"
              />
            </Pole>

            <Pole pole="odjezd" label="Odjezd nebo začátek soutěží">
              <input
                type="text"
                id="odjezd"
                name="odjezd"
                value={akce.odjezd}
                maxlength="120"
                class="form-control"
              />
            </Pole>

            <Pole
              pole="kapacita"
              label="Kapacita"
              chyba={chyby.kapacita}
              napoveda="Jen pro vaši orientaci. 0 = neukazovat."
            >
              <input
                type="number"
                inputmode="numeric"
                id="kapacita"
                name="kapacita"
                value={String(akce.kapacita)}
                min="0"
                max="999"
                step="1"
                class="form-control"
                aria-describedby="kapacita-info"
                aria-invalid={chyby.kapacita ? 'true' : undefined}
              />
            </Pole>

            <Pole
              pole="vek_od"
              label="Věk od"
              chyba={chyby.vek_od}
              napoveda="Prázdné = bez omezení."
            >
              <input
                type="number"
                inputmode="numeric"
                id="vek_od"
                name="vek_od"
                value={akce.vek_od === null ? '' : String(akce.vek_od)}
                min="0"
                max="99"
                step="1"
                class="form-control"
                aria-describedby="vek_od-info"
                aria-invalid={chyby.vek_od ? 'true' : undefined}
              />
            </Pole>

            <Pole
              pole="max_ucastniku"
              label="Kolik lidí na jedné přihlášce"
              chyba={chyby.max_ucastniku}
              napoveda="1 = jedno dítě na přihlášku. Víc = klub pošle celou skupinu najednou."
            >
              <input
                type="number"
                inputmode="numeric"
                id="max_ucastniku"
                name="max_ucastniku"
                data-vychozi="max_ucastniku"
                value={String(akce.max_ucastniku)}
                min="1"
                max="40"
                step="1"
                class="form-control"
                aria-describedby="max_ucastniku-info"
                aria-invalid={chyby.max_ucastniku ? 'true' : undefined}
              />
            </Pole>

            <Pole
              pole="vyber"
              label="Z položek se vybírá"
              napoveda="Tábor má jednu cenu, na závodech jezdec startuje v několika soutěžích."
            >
              <select
                id="vyber"
                name="vyber"
                data-vychozi="vyber"
                class="form-control"
                aria-describedby="vyber-info"
              >
                <option value="jedna" selected={akce.vyber === 'jedna'}>Právě jedna</option>
                <option value="vice" selected={akce.vyber === 'vice'}>Klidně několik</option>
              </select>
            </Pole>

            <Pole
              pole="splatnost_dni"
              label="Zaplatit nejpozději dní před akcí"
              chyba={chyby.splatnost_dni}
              napoveda="0 = hned po přihlášení."
            >
              <input
                type="number"
                inputmode="numeric"
                id="splatnost_dni"
                name="splatnost_dni"
                data-vychozi="splatnost_dni"
                value={String(akce.splatnost_dni)}
                min="0"
                max="365"
                step="1"
                class="form-control"
                aria-describedby="splatnost_dni-info"
                aria-invalid={chyby.splatnost_dni ? 'true' : undefined}
              />
            </Pole>

            <Pole
              pole="kod"
              label="Adresa přihlášky"
              chyba={chyby.kod}
              napoveda={novaAkce
                ? 'Doplní se sama z názvu.'
                : 'Adresu už nejde změnit, odkazují se na ni odeslané přihlášky.'}
            >
              <input
                type="text"
                id="kod"
                name="kod"
                value={akce.kod}
                readonly={!novaAkce}
                maxlength="60"
                data-kod
                class:list={['form-control', !novaAkce && 'bg-sand-200 text-ink-3']}
                aria-describedby="kod-info"
                aria-invalid={chyby.kod ? 'true' : undefined}
              />
            </Pole>

            <label class="flex cursor-pointer items-start gap-3 sm:col-span-2">
              <input
                type="checkbox"
                name="platba_hned"
                value="ano"
                data-vychozi="platba_hned"
                checked={akce.platba_hned}
                class="mt-1 h-5 w-5 shrink-0 accent-[var(--color-brass-600)]"
              />
              <span class="text-[0.9375rem]">
                <strong class="block">Platební údaje hned po odeslání</strong>
                <span class="text-ink-3">
                  U startovného ano. U táborů a pobytů ne: platební údaje přijdou až
                  s potvrzením místa.
                </span>
              </span>
            </label>
          </div>
        </details>
      </div>
    </section>

    <!-- ------------------------------------------------------------ uložit -->
    <div class="flex flex-wrap items-center gap-4 border-t border-ink/12 pt-8">
      <button type="submit" class="btn btn-primary" data-odeslat>
        {novaAkce ? 'Uložit akci' : 'Uložit změny'}
      </button>
      <a href="/prihlasky/sprava" class="btn btn-outline">Zpět</a>
    </div>
  </form>

  {
    !novaAkce && (
      <section class="mt-16 border-t border-ink/12 pt-8">
        <h2 class="text-[0.75rem] font-semibold uppercase tracking-[0.12em] text-ink-3">
          Smazání akce
        </h2>
        {pocetPrihlasek > 0 ? (
          <p class="mt-3 max-w-2xl text-[0.9375rem] text-ink-3">
            Akci nejde smazat, protože na ni už přišly přihlášky. Když se nekoná, odškrtněte
            výš „Přihlášky otevřené".
          </p>
        ) : (
          <form method="post" class="mt-3 flex flex-wrap items-center gap-4">
            <input type="hidden" name="co" value="smazat" />
            <button
              type="submit"
              class="btn btn-outline"
              data-potvrdit={`Opravdu smazat akci „${akce.nazev}"? Zmizí i z kalendáře na webu.`}
            >
              Smazat akci
            </button>
          </form>
        )}
      </section>
    )
  }
</PrihlaskyLayout>

<script>
  import { vychoziProTyp } from '@/lib/prihlasky/akce';
  import { typProDruh } from '@/lib/prihlasky/typy';

  const form = document.querySelector<HTMLFormElement>('[data-akce]');

  if (form) {
    /* ---- přihlašování zapnout / vypnout -------------------------------- */
    const prihlasovani = form.querySelector<HTMLInputElement>('[data-prihlasovani]');
    const cast = form.querySelector<HTMLElement>('[data-cast-prihlasky]');
    if (prihlasovani && cast) {
      prihlasovani.addEventListener('change', () => {
        cast.hidden = !prihlasovani.checked;
      });
    }

    /* ---- výchozí hodnoty podle druhu ----------------------------------- */
    const druh = form.querySelector<HTMLSelectElement>('[data-druh]');
    const typ = () =>
      vychoziProTyp[typProDruh[druh?.value as keyof typeof typProDruh] ?? 'zavody'];

    // Jen u nové akce: u rozdělané by přepsání hodnot bylo překvapení.
    if (druh && form.dataset.nova === 'ano') {
      let predchozi = typ();

      druh.addEventListener('change', () => {
        const nove = typ();
        const stare = predchozi;
        if (!nove || !stare) return;

        form.querySelectorAll<HTMLElement>('[data-vychozi]').forEach((pole) => {
          const klic = pole.dataset.vychozi as keyof typeof stare;
          const puvodni = String(stare[klic]);
          const cilova = String(nove[klic]);

          if (pole instanceof HTMLInputElement && pole.type === 'checkbox') {
            // Hodnotu měníme jen tam, kam nikdo nesáhl.
            if (String(pole.checked) === puvodni) pole.checked = cilova === 'true';
          } else if (
            pole instanceof HTMLInputElement ||
            pole instanceof HTMLSelectElement
          ) {
            if (pole.value === puvodni) pole.value = cilova;
          }
        });

        predchozi = nove;
      });
    }

    /* ---- adresa se doplní z názvu ------------------------------------- */
    const nazev = form.querySelector<HTMLInputElement>('[data-nazev]');
    const zacatek = form.querySelector<HTMLInputElement>('[data-zacatek]');
    const kod = form.querySelector<HTMLInputElement>('[data-kod]');

    /** Stejný převod jako na serveru v kodZNazvu(). */
    const slug = (text: string) =>
      text
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .slice(0, 50)
        .replace(/-+$/, '');

    if (nazev && kod && !kod.readOnly) {
      // Jakmile do adresy někdo sáhne ručně, přestaneme ji přepisovat.
      let vlastni = kod.value.trim() !== '';

      const doplnit = () => {
        if (vlastni) return;
        const rok = (zacatek?.value ?? '').slice(0, 4);
        kod.value = [slug(nazev.value), rok].filter(Boolean).join('-').slice(0, 60);
      };

      kod.addEventListener('input', () => {
        vlastni = kod.value.trim() !== '';
      });
      nazev.addEventListener('input', doplnit);
      zacatek?.addEventListener('change', doplnit);
    }

    /* ---- řádky ceníku -------------------------------------------------- */
    form.querySelectorAll<HTMLElement>('[data-cenik]').forEach((blok) => {
      const radky = [...blok.querySelectorAll<HTMLElement>('[data-radek]')];
      const pridat = blok.querySelector<HTMLButtonElement>('[data-pridat]');
      let viditelnych = Number(blok.dataset.viditelnych ?? 1);

      const prekreslit = () => {
        radky.forEach((r, i) => {
          r.hidden = i >= viditelnych;
        });
        if (pridat) pridat.hidden = viditelnych >= radky.length;
      };

      if (radky.length > 1) {
        prekreslit();
        pridat?.addEventListener('click', () => {
          if (viditelnych >= radky.length) return;
          viditelnych += 1;
          prekreslit();
          radky[viditelnych - 1]?.querySelector<HTMLInputElement>('input')?.focus();
        });
      }
    });

    /* ---- dvojklik ------------------------------------------------------ */
    form.addEventListener('submit', () => {
      const odeslat = form.querySelector<HTMLButtonElement>('[data-odeslat]');
      if (odeslat) odeslat.disabled = true;
    });
  }

  /* ---- potvrzení u nevratných akcí ------------------------------------- */
  document.querySelectorAll<HTMLButtonElement>('[data-potvrdit]').forEach((tlacitko) => {
    tlacitko.addEventListener('click', (e) => {
      if (!confirm(tlacitko.dataset.potvrdit ?? 'Opravdu?')) e.preventDefault();
    });
  });
</script>
