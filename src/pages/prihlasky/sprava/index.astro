---
/**
 * Správa akcí a přihlášek: přehled akcí (podle nich se plní kalendář na
 * webu) a seznam přihlášek. Vyřizuje se v detailu přihlášky, tady se jen
 * hledá a třídí.
 */

export const prerender = false;

import PrihlaskyLayout from '@/layouts/PrihlaskyLayout.astro';
import Stitek from '@/components/prihlasky/Stitek.astro';
import Zprava from '@/components/rezervace/Zprava.astro';
import Icon from '@/components/Icon.astro';
import KartaAkce from '@/components/prihlasky/KartaAkce.astro';
import {
  jmenaUcastniku,
  stavy,
  type Akce,
  type Prihlaska,
  type StavPrihlasky,
} from '@/lib/prihlasky/db';
import { kc } from '@/lib/prihlasky/platba';
import { popisTypu } from '@/lib/prihlasky/typy';
import { isUpcoming } from '@/data/events';
import { naUdalost } from '@/lib/kalendar';
import { bezCache, datumCas, nactiSpravce } from '@/lib/prihlasky/spravce';

bezCache(Astro.response.headers);

const spravce = await nactiSpravce(Astro);
if (!spravce) {
  return Astro.redirect(
    `/prihlasky/prihlaseni?dal=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`,
  );
}

const [{ data: akceData }, { data: prihlaskyData }] = await Promise.all([
  spravce.supabase.from('akce').select('*').order('zacatek', { ascending: false }),
  spravce.supabase
    .from('prihlasky')
    .select(
      'id, vs, akce, ucastnici, cena, subjekt, kontakt_jmeno, kontakt_telefon, platce, firma_nazev, stav, zaplaceno, faktura_cislo, vytvoreno',
    )
    .order('vytvoreno', { ascending: false }),
]);

const vsechnyAkce = (akceData as Akce[]) ?? [];
/** Nadcházející nahoře od nejbližší, proběhlé schované pod nimi. */
const akce = vsechnyAkce
  .filter((a) => isUpcoming(naUdalost(a)))
  .sort((a, b) => a.zacatek.localeCompare(b.zacatek));
const probehle = vsechnyAkce.filter((a) => !isUpcoming(naUdalost(a)));
const vsechny = (prihlaskyData as Prihlaska[]) ?? [];

const filtrAkce = Astro.url.searchParams.get('akce') ?? '';
const filtrStav = Astro.url.searchParams.get('stav') ?? '';

const vAkci = vsechny.filter((p) => !filtrAkce || p.akce === filtrAkce);
const seznam = vAkci.filter((p) => {
  if (!filtrStav) return true;
  if (filtrStav === 'vyrazene') return p.stav === 'odmitnuta' || p.stav === 'zrusena';
  return p.stav === filtrStav;
});

const akcePodleKodu = new Map(vsechnyAkce.map((a) => [a.kod, a]));

/** Kolik lidí je na přihlášce — u klubů se počítají všichni jezdci. */
const pocetLidi = (p: Prihlaska) => p.ucastnici?.length ?? 0;

const souhrnAkce = (a: Akce) => {
  const jeji = vsechny.filter((p) => p.akce === a.kod);
  const prijate = jeji.filter((p) => p.stav === 'prijata');
  return {
    akce: a,
    nove: jeji.filter((p) => p.stav === 'nova').length,
    prijate: prijate.reduce((s, p) => s + pocetLidi(p), 0),
    zaplacene: prijate.filter((p) => p.zaplaceno).reduce((s, p) => s + pocetLidi(p), 0),
  };
};
const souhrn = akce.map(souhrnAkce);
const souhrnProbehlych = probehle.map(souhrnAkce);

const zalozky: { kod: string; label: string; pocet: number }[] = [
  { kod: '', label: 'Všechny', pocet: vAkci.length },
  ...(['nova', 'prijata', 'nahradnik'] as StavPrihlasky[]).map((s) => ({
    kod: s,
    label: s === 'nahradnik' ? 'Náhradníci' : stavy[s],
    pocet: vAkci.filter((p) => p.stav === s).length,
  })),
  {
    kod: 'vyrazene',
    label: 'Odmítnuté a zrušené',
    pocet: vAkci.filter((p) => p.stav === 'odmitnuta' || p.stav === 'zrusena').length,
  },
];

const hotovo = Astro.url.searchParams.get('hotovo') ?? '';

const odkaz = (zmeny: { akce?: string; stav?: string }) => {
  const parametry = new URLSearchParams();
  const kod = zmeny.akce ?? filtrAkce;
  const stav = zmeny.stav ?? filtrStav;
  if (kod) parametry.set('akce', kod);
  if (stav) parametry.set('stav', stav);
  const q = parametry.toString();
  return `/prihlasky/sprava${q ? `?${q}` : ''}`;
};
---

<PrihlaskyLayout
  title="Akce a přihlášky"
  heading="Akce a přihlášky"
  lead="Akce, které tu založíte, se hned ukážou v kalendáři na webu. Přihlášky potvrďte nebo odmítněte v detailu, přihlášeným pak automaticky odejde e-mail."
  spravce={spravce}
>
  {hotovo === 'akce-smazana' && <Zprava typ="ok" class="mb-8">Akce je smazaná.</Zprava>}
  {
    hotovo === 'akce-zalozena' && (
      <Zprava typ="ok" class="mb-8">Akce je uložená a už je v kalendáři na webu.</Zprava>
    )
  }

  <!-- -------------------------------------------------------------- akce -->
  <section>
    <div class="flex flex-wrap items-center justify-between gap-4">
      <h2 class="t-3">Akce</h2>
      <a href="/prihlasky/sprava/akce/nova" class="btn btn-primary">
        <Icon name="plus" class="h-4 w-4" />
        Nová akce
      </a>
    </div>

    {
      akce.length === 0 ? (
        <p class="mt-6 border-t border-ink/12 pt-6 text-ink-3">
          Žádná nadcházející akce. Založte ji tlačítkem Nová akce: stačí druh, název a datum.
        </p>
      ) : (
        <ul class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {souhrn.map((s) => <KartaAkce
              s={s}
              vybrana={filtrAkce === s.akce.kod}
              filtr={odkaz({ akce: filtrAkce === s.akce.kod ? '' : s.akce.kod, stav: '' })}
            />)}
        </ul>
      )
    }

    {
      souhrnProbehlych.length > 0 && (
        <details class="mt-8 border border-ink/12">
          <summary class="cursor-pointer px-5 py-4 text-[0.9375rem] font-semibold">
            Proběhlé akce <span class="font-normal text-ink-3">({souhrnProbehlych.length})</span>
          </summary>
          <ul class="grid gap-4 border-t border-ink/12 p-5 md:grid-cols-2 xl:grid-cols-3">
            {souhrnProbehlych.map((s) => <KartaAkce
              s={s}
              vybrana={filtrAkce === s.akce.kod}
              filtr={odkaz({ akce: filtrAkce === s.akce.kod ? '' : s.akce.kod, stav: '' })}
            />)}
          </ul>
        </details>
      )
    }
  </section>

  <!-- --------------------------------------------------------- přihlášky -->
  <section class="mt-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="t-3">
        Přihlášky
        {filtrAkce && akcePodleKodu.get(filtrAkce) && (
          <span class="text-ink-3">: {akcePodleKodu.get(filtrAkce)!.nazev}</span>
        )}
      </h2>
    </div>

    <nav aria-label="Filtr podle stavu" class="mt-6 border-b border-ink/12">
      <ul class="-mb-px flex flex-wrap gap-x-6">
        {
          zalozky.map((z) => (
            <li>
              <a
                href={odkaz({ stav: z.kod })}
                aria-current={filtrStav === z.kod ? 'page' : undefined}
                class:list={[
                  'inline-block border-b-2 py-3 text-[0.8125rem] font-semibold uppercase tracking-[0.1em] transition-colors',
                  filtrStav === z.kod
                    ? 'border-brass-600 text-brass-700'
                    : 'border-transparent text-ink-3 hover:text-ink',
                ]}
              >
                {z.label} <span class="font-normal">({z.pocet})</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      seznam.length === 0 ? (
        <p class="py-8 text-ink-3">Tady žádné přihlášky nejsou.</p>
      ) : (
        <ul>
          {seznam.map((p) => {
            const a = akcePodleKodu.get(p.akce);
            const typ = popisTypu(a?.typ);
            const lidi = p.ucastnici ?? [];
            return (
              <li class="border-b border-ink/12">
                <a
                  href={`/prihlasky/sprava/${p.id}`}
                  class="group grid gap-x-6 gap-y-2 py-5 transition-colors hover:bg-paper-2 sm:grid-cols-[1fr_auto] sm:px-3"
                >
                  <div class="min-w-0">
                    <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
                      <span class="font-display text-[1.25rem] group-hover:text-brass-700">
                        {p.subjekt || jmenaUcastniku(p)}
                      </span>
                      <Stitek stav={p.stav} />
                      {lidi.length > 1 && (
                        <Stitek barva="sand">{lidi.length} {typ.ucastnici.toLowerCase()}</Stitek>
                      )}
                      {p.platce === 'firma' && <Stitek barva="sand">Faktura</Stitek>}
                      {p.platce === 'misto' && <Stitek barva="sand">Na místě</Stitek>}
                      {p.stav === 'prijata' &&
                        (p.zaplaceno ? (
                          <Stitek barva="loden">Zaplaceno</Stitek>
                        ) : (
                          <Stitek barva="brass">Čeká na platbu</Stitek>
                        ))}
                    </p>
                    <p class="mt-1 text-[0.875rem] text-ink-3">
                      {lidi
                        .map((u) => [u.jmeno, u.kun].filter(Boolean).join(' — '))
                        .slice(0, 3)
                        .join(' · ')}
                      {lidi.length > 3 && ` · a ${lidi.length - 3} další`}
                    </p>
                    <p class="mt-1 text-[0.8125rem] text-ink-3/80">
                      {p.kontakt_jmeno}, {p.kontakt_telefon}
                      {!filtrAkce && a && ` · ${a.nazev}`}
                    </p>
                  </div>

                  <div class="flex items-center gap-5 sm:text-right">
                    <div>
                      <p class="font-display text-[1.125rem]">{kc(p.cena)}</p>
                      <p class="text-[0.8125rem] text-ink-3">
                        č. {p.vs} · {datumCas(p.vytvoreno)}
                      </p>
                    </div>
                    <Icon
                      name="chevron-right"
                      class="hidden h-4 w-4 text-ink-3 transition-transform group-hover:translate-x-1 sm:block"
                    />
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      )
    }
  </section>
</PrihlaskyLayout>
