---
import PageLayout from '@/layouts/PageLayout.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import Icon from '@/components/Icon.astro';
import {
  results,
  resultKind,
  resultKindLabels,
  resultYears,
  type ResultKind,
} from '@/data/results';
import { formatLong } from '@/data/events';

import heroImg from '@/assets/photos/divaci-01.jpg';

const withKind = results.map((r) => ({ ...r, kind: resultKind(r.title) }));

const byYear = resultYears.map((y) => ({
  year: y,
  items: withKind.filter((r) => r.date.startsWith(String(y))),
}));

/** Kategorie, které se v archivu skutečně vyskytují. */
const usedKinds = [...new Set(withKind.map((r) => r.kind))] as ResultKind[];

const fileExt = (f?: string) =>
  f ? (f.split('.').pop() ?? '').toUpperCase() : '';
---

<PageLayout
  title="Výsledkové listiny"
  description="Archiv výsledkových listin ze závodů, jezdeckých her pro děti, veřejných tréninků a dětských šampionátů pořádaných v areálu Jízdárna Suchá od roku 2012."
  heading="Výsledkové listiny"
  lead={`${results.length} výsledkových listin z domácích akcí — jezdecké hry, závody, veřejné tréninky i dětské šampionáty.`}
  image={heroImg}
  imageAlt="Diváci na jezdeckých závodech v Suché"
  crumbs={[{ label: 'Výsledkové listiny' }]}
>
  <Section tone="paper" space="lg">
    <SectionHead
      title="Prohledejte archiv"
      lead="Filtrujte podle roku nebo typu akce. Soubory se otevřou v Excelu, případně jako PDF."
    />

    <!-- Filtry -->
    <div class="mt-10 space-y-6" data-reveal>
      <div>
        <label
          for="results-search"
          class="text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-ink-3/70"
        >
          Hledat
        </label>
        <div class="relative mt-3 max-w-md">
          <input
            type="search"
            id="results-search"
            placeholder="Název akce nebo rok…"
            autocomplete="off"
            class="w-full border border-ink/18 bg-white py-3 pl-11 pr-4 text-[0.9375rem] outline-none transition-colors focus:border-brass-600"
          />
          <svg
            class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-3/60"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
        </div>
      </div>

      <div>
        <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-ink-3/70">
          Typ akce
        </p>
        <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Filtr podle typu akce">
          <button type="button" class="filter-chip is-active" data-filter-kind="all">
            Vše
          </button>
          {
            usedKinds.map((k) => (
              <button type="button" class="filter-chip" data-filter-kind={k}>
                {resultKindLabels[k]}
              </button>
            ))
          }
        </div>
      </div>

      <div>
        <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-ink-3/70">
          Rok
        </p>
        <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Filtr podle roku">
          <button type="button" class="filter-chip is-active" data-filter-year="all">
            Vše
          </button>
          {
            resultYears.map((y) => (
              <button type="button" class="filter-chip" data-filter-year={String(y)}>
                {y}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Výpis -->
    <div class="mt-10 space-y-3" id="results-list">
      {
        byYear.map((y, yi) => (
          <details
            class="group border border-ink/12 bg-white"
            data-year-block={String(y.year)}
            open={yi < 2}
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 transition-colors hover:bg-paper-2 sm:px-6">
              <span class="font-display text-[1.5rem] tabular-nums">{y.year}</span>
              <span class="flex items-center gap-4">
                <span
                  class="text-[0.75rem] uppercase tracking-[0.16em] text-ink-3/70"
                  data-year-count
                >
                  {y.items.length} listin
                </span>
                <Icon
                  name="chevron-down"
                  class="h-4 w-4 text-ink-3 transition-transform duration-300 group-open:rotate-180"
                />
              </span>
            </summary>

            <ul class="border-t border-ink/12 px-5 pb-2 sm:px-6">
              {y.items.map((r) => (
                <li
                  class="result-row border-t border-ink/12 first:border-t-0"
                  data-kind={r.kind}
                  data-year={String(y.year)}
                  data-search={`${r.title} ${formatLong(r.date)} ${resultKindLabels[r.kind]}`.toLowerCase()}
                >
                  {r.file ? (
                    <a
                      href={r.file}
                      class="group grid grid-cols-[auto_1fr_auto] items-center gap-4 py-5 transition-colors hover:bg-white sm:gap-8"
                      download
                    >
                      <span class="w-24 shrink-0 text-[0.8125rem] text-ink-3 tabular-nums sm:w-32">
                        {formatLong(r.date)}
                      </span>
                      <span class="min-w-0">
                        <span class="block text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-brass-700">
                          {resultKindLabels[r.kind]}
                        </span>
                        <span class="mt-1 block font-display text-[1.125rem] leading-snug transition-colors group-hover:text-brass-700 sm:text-[1.25rem]">
                          {r.title}
                        </span>
                      </span>
                      <span class="flex shrink-0 items-center gap-2 text-[0.6875rem] font-semibold uppercase tracking-[0.12em] text-ink-3 transition-colors group-hover:text-brass-700">
                        <span class="hidden sm:inline">{fileExt(r.file)}</span>
                        <Icon name="download" class="h-4 w-4" />
                      </span>
                    </a>
                  ) : (
                    <div class="grid grid-cols-[auto_1fr_auto] items-center gap-4 py-5 opacity-60 sm:gap-8">
                      <span class="w-24 shrink-0 text-[0.8125rem] text-ink-3 tabular-nums sm:w-32">
                        {formatLong(r.date)}
                      </span>
                      <span class="min-w-0">
                        <span class="block text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-ink-3/70">
                          {resultKindLabels[r.kind]}
                        </span>
                        <span class="mt-1 block font-display text-[1.125rem] leading-snug sm:text-[1.25rem]">
                          {r.title}
                        </span>
                      </span>
                      <span class="shrink-0 text-[0.6875rem] uppercase tracking-[0.12em] text-ink-3/60">
                        bez souboru
                      </span>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </div>

    <p
      id="results-empty"
      class="mt-10 hidden border border-ink/12 bg-white p-10 text-center text-ink-3"
    >
      Pro zvolenou kombinaci filtrů nemáme žádné výsledky.
    </p>
  </Section>

  <Section tone="paper-2" space="sm">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-8">
        <h2 class="t-3">Hledáte výsledky z Velké ceny Litomyšle?</h2>
        <p class="mt-3 text-ink-3">
          Oficiální výsledky seriálu najdete na stránkách Asociace Český skokový
          pohár.
        </p>
      </div>
      <div class="lg:col-span-4 lg:text-right">
        <a
          href="http://www.ceskyskokovypohar.cz/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
        >
          ceskyskokovypohar.cz
          <Icon name="arrow-up-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </Section>
</PageLayout>

<style>
  .filter-chip {
    cursor: pointer;
    border: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    font-weight: 500;
    min-height: 2.75rem;
    transition: background-color 200ms var(--ease-out-natural),
      color 200ms var(--ease-out-natural),
      border-color 200ms var(--ease-out-natural);
  }
  .filter-chip:hover {
    border-color: var(--color-brass-600);
    color: var(--color-brass-700);
  }
  .filter-chip.is-active {
    background: var(--color-loden-800);
    border-color: var(--color-loden-800);
    color: var(--color-paper);
  }
</style>

<script>
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.result-row'));
  const blocks = Array.from(
    document.querySelectorAll<HTMLDetailsElement>('[data-year-block]'),
  );
  const empty = document.getElementById('results-empty');
  const search = document.getElementById('results-search') as HTMLInputElement | null;

  let activeKind = 'all';
  let activeYear = 'all';
  let query = '';

  /** Výchozí stav: otevřené jsou dva nejnovější roky. */
  const defaultOpen = new Set(blocks.slice(0, 2).map((b) => b.dataset.yearBlock));

  function apply() {
    const filtering = activeKind !== 'all' || activeYear !== 'all' || query !== '';
    let visible = 0;

    for (const row of rows) {
      const show =
        (activeKind === 'all' || row.dataset.kind === activeKind) &&
        (activeYear === 'all' || row.dataset.year === activeYear) &&
        (query === '' || (row.dataset.search ?? '').includes(query));
      row.hidden = !show;
      if (show) visible++;
    }

    for (const block of blocks) {
      const matches = Array.from(
        block.querySelectorAll<HTMLElement>('.result-row'),
      ).filter((r) => !r.hidden);

      block.hidden = matches.length === 0;

      const counter = block.querySelector<HTMLElement>('[data-year-count]');
      if (counter) counter.textContent = `${matches.length} listin`;

      // Při filtrování rozbal roky s výsledky, jinak se vrať k výchozímu stavu
      block.open = filtering
        ? matches.length > 0
        : defaultOpen.has(block.dataset.yearBlock);
    }

    empty?.classList.toggle('hidden', visible > 0);
  }

  function wire(attr: 'filterKind' | 'filterYear', set: (v: string) => void) {
    const selector = attr === 'filterKind' ? '[data-filter-kind]' : '[data-filter-year]';
    const buttons = Array.from(document.querySelectorAll<HTMLElement>(selector));
    for (const btn of buttons) {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.classList.toggle('is-active', b === btn));
        set(btn.dataset[attr] ?? 'all');
        apply();
      });
    }
  }

  wire('filterKind', (v) => (activeKind = v));
  wire('filterYear', (v) => (activeYear = v));

  search?.addEventListener('input', () => {
    query = search.value.trim().toLowerCase();
    apply();
  });
</script>
