---
/**
 * Stránka pro dobu, kdy je web zavřený (proměnná UDRZBA=1 ve Vercelu).
 * Návštěvník se nedostane dál, ale najde tu kontakty — kdo stáj hledá,
 * ať se jí dovolá i přes zavřený web.
 *
 * Posílá sem middleware. Stránka je schválně bez navigace a patičky, aby
 * z ní nevedla cesta do zbytku webu.
 */

export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site';

const kontakty = site.contacts;
---

<BaseLayout
  title={`${site.name} — připravujeme`}
  description="Nový web Stáje Manon se připravuje. Kontakty najdete na této stránce."
  noindex
  samostatna
>
  <main class="grain relative flex min-h-screen items-center bg-loden-950 text-white">
    <div class="container-x py-16 lg:py-24">
      <div class="max-w-2xl">
        <p
          class="text-[0.6875rem] font-semibold uppercase tracking-[0.18em] text-brass-300"
        >
          {site.tagline}
        </p>

        <h1 class="t-1 mt-5 text-white">{site.fullName}</h1>

        <p class="lead mt-6 text-white/75">
          Připravujeme nový web. Než ho spustíme, ozvěte se nám prosím
          telefonicky nebo e-mailem — rádi vám poradíme s ustájením, výukou,
          kurzy i ubytováním v penzionu.
        </p>

        <ul class="mt-12 space-y-px">
          {
            kontakty.map((k) => (
              <li class="border-t border-white/15 py-5 last:border-b">
                <p class="font-display text-[1.25rem] text-white">{k.name}</p>
                <p class="mt-0.5 text-[0.875rem] text-white/60">{k.role}</p>
                <p class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-[0.9375rem]">
                  <a
                    href={`tel:${k.phoneHref}`}
                    class="font-semibold text-brass-300 transition-colors hover:text-brass-200"
                  >
                    {k.phone}
                  </a>
                  <a
                    href={`mailto:${k.email}`}
                    class="text-white/75 transition-colors hover:text-white"
                  >
                    {k.email}
                  </a>
                </p>
              </li>
            ))
          }
        </ul>

        <p class="mt-10 text-[0.9375rem] text-white/55">
          {site.address.street}, {site.address.zip} {site.address.city}
        </p>
      </div>
    </div>
  </main>
</BaseLayout>
