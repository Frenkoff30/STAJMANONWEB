---
import PageLayout from '@/layouts/PageLayout.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import Icon from '@/components/Icon.astro';
import { services, facilities } from '@/data/services';
import { site } from '@/data/site';

import heroImg from '@/assets/photos/hala-01.jpg';

const priced = services.filter((s) => s.price);
---

<PageLayout
  title="Služby a ceník"
  description="Ustájení koní, trénink, jezdecká škola, prodej a pronájem koní, pronájem haly, kolbiště a parkuru, praní dek a přeprava koní. Ceník Stáje Manon."
  heading="Služby a ceník"
  lead="Ustájení, trénink, pronájmy i přeprava. Kompletní servis pro koně i jezdce v areálu, který funguje celoročně."
  image={heroImg}
  imageAlt="Krytá jezdecká hala v areálu Jízdárna Suchá"
  crumbs={[{ label: 'Areál', href: '/areal' }, { label: 'Služby' }]}
  nav={[
    { id: 'ceny', label: 'Klíčové ceny' },
    { id: 'nabidka', label: 'Všechny služby' },
    { id: 'plochy', label: 'Tréninkové plochy' },
    { id: 'poptavka', label: 'Poptávka' },
  ]}
>
  <!-- Klíčové ceny -->
  <Section tone="paper" space="md" id="ceny">
    <div class="grid gap-px border border-ink/12 bg-ink/12 sm:grid-cols-3">
      {
        priced.map((s, i) => (
          <div class="bg-paper p-8" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-brass-700">
              {s.title}
            </p>
            <p class="mt-4 font-display text-[2.25rem] leading-none">{s.price}</p>
            <p class="mt-3 text-[0.875rem] leading-relaxed text-ink-3">{s.priceNote}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Všechny služby -->
  <Section tone="paper" space="lg" id="nabidka">
    <SectionHead
      title="Co pro vás uděláme"
      lead="Od dlouhodobého ustájení po jednorázový pronájem haly na váš trénink."
    />

    <div class="mt-10 space-y-px">
      {
        services.map((s, i) => (
          <article
            class="grid gap-5 border-t border-ink/12 py-9 last:border-b lg:grid-cols-[auto_1fr_auto] lg:gap-12"
            data-reveal
            style={`--reveal-delay:${Math.min(i * 50, 250)}ms`}
          >
            <span class="index-num lg:pt-2">{String(i + 1).padStart(2, '0')}</span>

            <div>
              <h2 class="t-3">{s.title}</h2>
              <p class="mt-3 max-w-2xl text-[1.0625rem] leading-relaxed text-ink">
                {s.summary}
              </p>
              {s.detail && (
                <p class="mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-ink-3">
                  {s.detail}
                </p>
              )}
            </div>

            {s.price && (
              <div class="lg:min-w-[10rem] lg:pt-2 lg:text-right">
                <p class="font-display text-[1.75rem] leading-none text-brass-700">
                  {s.price}
                </p>
                <p class="mt-2 text-[0.8125rem] text-ink-3">{s.priceNote}</p>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </Section>

  <!-- Tréninkové plochy -->
  <Section tone="dark" space="lg" id="plochy">
    <SectionHead
      title="Kde se pracuje"
      lead="Všechny plochy jsou k dispozici ustájeným koním i k pronájmu."
      tone="light"
    />

    <dl class="mt-10 grid gap-px border border-white/12 bg-white/12 sm:grid-cols-2 lg:grid-cols-4">
      {
        facilities.map((f, i) => (
          <div class="bg-loden-950 p-7" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <dt class="text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-brass-300">
              {f.name}
            </dt>
            <dd class="mt-3 font-display text-[1.875rem] leading-none text-white">
              {f.size}
            </dd>
            <dd class="mt-4 text-[0.875rem] leading-relaxed text-white/55">{f.text}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <!-- CTA -->
  <Section tone="paper-2" space="lg" id="poptavka">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <h2 class="t-2">Ozvěte se a domluvíme detaily.</h2>
        <p class="lead mt-5">
          Ustájení, trénink konkrétního koně nebo termín na pronájem haly —
          nejrychlejší je zavolat.
        </p>
      </div>

      <div class="lg:col-span-5">
        <div class="card p-8">
          <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-brass-700">
            {site.contacts[0]!.role}
          </p>
          <p class="mt-3 font-display text-[1.5rem]">{site.contacts[0]!.name}</p>
          <a
            href={`tel:${site.contacts[0]!.phoneHref}`}
            class="link-underline mt-3 inline-flex items-center gap-2 text-[1.125rem] text-brass-700"
          >
            <Icon name="phone" class="h-4 w-4" />
            {site.contacts[0]!.phone}
          </a>
          <a href="/kontakt" class="btn btn-primary mt-7 w-full">Kontaktní formulář</a>
        </div>
      </div>
    </div>
  </Section>
</PageLayout>
