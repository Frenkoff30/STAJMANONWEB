---
import PageLayout from '@/layouts/PageLayout.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import Icon from '@/components/Icon.astro';
import { services } from '@/data/services';
import { site } from '@/data/site';

import { photo } from '@/data/images';
import page from '@/obsah/stranky/sluzby.json';

const heroImg = photo(page.hero.image)!;

const priced = services.filter((s) => s.price);
---

<PageLayout
  title={page.seo.title}
  description={page.seo.description}
  heading={page.hero.heading}
  lead={page.hero.lead}
  image={heroImg}
  imageAlt={page.hero.imageAlt}
  crumbs={[{ label: 'Areál', href: '/areal' }, { label: 'Služby' }]}
  nav={[
    { id: 'ceny', label: 'Klíčové ceny' },
    { id: 'nabidka', label: 'Všechny služby' },
    { id: 'plochy', label: 'Tréninkové plochy' },
    { id: 'poptavka', label: 'Poptávka' },
  ]}
>
  <!-- Klíčové ceny -->
  <Section tone="paper" space="md" id="ceny">
    <div class="grid gap-x-10 gap-y-8 sm:grid-cols-3">
      {
        priced.map((s, i) => (
          <div class="border-t border-ink/12 pt-5" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-brass-700">
              {s.title}
            </p>
            <p class="mt-3 font-display text-[1.5rem] leading-none">{s.price}</p>
            <p class="mt-3 text-[0.875rem] leading-relaxed text-ink-3">{s.priceNote}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Všechny služby -->
  <Section tone="paper" space="lg" id="nabidka">
    <SectionHead
      title={page.sekce.coProVasUdelame.title}
      lead={page.sekce.coProVasUdelame.lead}
    />

    <div class="mt-10 space-y-px">
      {
        services.map((s, i) => (
          <article
            class="grid gap-5 border-t border-ink/12 py-9 last:border-b lg:grid-cols-[1fr_auto] lg:gap-12"
            data-reveal
            style={`--reveal-delay:${Math.min(i * 50, 250)}ms`}
          >
            <div>
              <h2 class="t-3">{s.title}</h2>
              <p class="mt-3 max-w-2xl text-[1.0625rem] leading-relaxed text-ink">
                {s.summary}
              </p>
              {s.detail && (
                <details class="mt-3 max-w-2xl">
                  <summary class="cursor-pointer text-[0.8125rem] font-semibold uppercase tracking-[0.1em] text-brass-700">
                    Podrobnosti
                  </summary>
                <p class="mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-ink-3">
                  {s.detail}
                </p>
                </details>
              )}
            </div>

            {s.price && (
              <div class="lg:min-w-[10rem] lg:pt-2 lg:text-right">
                <p class="font-display text-[1.75rem] leading-none text-brass-700">
                  {s.price}
                </p>
                <p class="mt-2 text-[0.8125rem] text-ink-3">{s.priceNote}</p>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </Section>

  <!-- Tréninkové plochy -->
  <Section tone="dark" space="lg" id="plochy" rise>

  <!-- CTA -->
  <Section tone="paper-2" space="lg" id="poptavka">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <h2 class="t-2">{page.cta.heading}</h2>
        <p class="lead mt-5">{page.cta.lead}</p>
      </div>

      <div class="lg:col-span-5">
        <div class="card p-8">
          <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-brass-700">
            {site.contacts[0]!.role}
          </p>
          <p class="mt-3 font-display text-[1.5rem]">{site.contacts[0]!.name}</p>
          <a
            href={`tel:${site.contacts[0]!.phoneHref}`}
            class="link-underline mt-3 inline-flex items-center gap-2 text-[1.125rem] text-brass-700"
          >
            <Icon name="phone" class="h-4 w-4" />
            {site.contacts[0]!.phone}
          </a>
          <a href="/kontakt" class="btn btn-primary mt-7 w-full">{page.cta.buttonLabel}</a>
        </div>
      </div>
    </div>
  </Section>
</PageLayout>
