---
import PageLayout from '@/layouts/PageLayout.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';
import AkceChov from '@/components/kalendar/AkceChov.astro';

import { photo } from '@/data/images';
import page from '@/obsah/stranky/odchovna.json';

const heroImg = photo(page.hero.image)!;

const requirements = page.requirements;
---

<PageLayout
  title={page.seo.title}
  description={page.seo.description}
  heading={page.hero.heading}
  lead={page.hero.lead}
  image={heroImg}
  imageAlt={page.hero.imageAlt}
  crumbs={[{ label: 'Jezdectví' }, { label: 'Testační odchovna' }]}
>
  <Section tone="paper" space="lg">
    <SectionHead
      title={page.sekce.kdyAKde.title}
      lead={page.sekce.kdyAKde.lead}
    />

    <AkceChov server:defer prazdno={page.prazdno} />
  </Section>

  <Section tone="dark" space="lg" rise>
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-5">
        <SectionHead
          title={page.sekce.coMusiHrebecMit.title}
          lead={page.sekce.coMusiHrebecMit.lead}
          tone="light"
        />
      </div>

      <dl class="grid gap-x-10 gap-y-7 sm:grid-cols-2 lg:col-span-7">
        {
          requirements.map((r, i) => (
            <div class="border-t border-white/15 pt-4" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <dt class="flex items-center gap-3 font-display text-[1.25rem] text-white">
                <Icon name="check" class="h-4 w-4 text-brass-300" strokeWidth={2.2} />
                {r.title}
              </dt>
              <dd class="mt-3 text-[0.875rem] leading-relaxed text-white/60">{r.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Section>

  <Section tone="paper-2" space="md">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <h2 class="t-3">{page.cta.heading}</h2>
        <p class="mt-3 text-ink-3">{page.cta.lead}</p>
      </div>
      <div class="flex flex-wrap gap-3 lg:col-span-5 lg:justify-end">
        <a href={`tel:${site.phoneHref}`} class="btn btn-primary">
          <Icon name="phone" class="h-4 w-4" />
          {site.phone}
        </a>
        <a href="/kontakt" class="btn btn-outline">{page.cta.secondaryLabel}</a>
      </div>
    </div>
  </Section>
</PageLayout>
