---
import PageLayout from '@/layouts/PageLayout.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';
import { events, formatLong, isUpcoming } from '@/data/events';

import { photo } from '@/data/images';
import page from '@/obsah/stranky/odchovna.json';

const heroImg = photo(page.hero.image)!;

const chovEvents = events
  .filter((e) => e.kind === 'chov')
  .sort((a, b) => a.start.localeCompare(b.start));

const upcoming = chovEvents.filter((e) => isUpcoming(e));

const requirements = page.requirements;
---

<PageLayout
  title={page.seo.title}
  description={page.seo.description}
  heading={page.hero.heading}
  lead={page.hero.lead}
  image={heroImg}
  imageAlt={page.hero.imageAlt}
  crumbs={[{ label: 'Jezdectví' }, { label: 'Testační odchovna' }]}
>
  <Section tone="paper" space="lg">
    <SectionHead
      title={page.sekce.kdyAKde.title}
      lead={page.sekce.kdyAKde.lead}
    />

    <ul class="mt-10 space-y-px">
      {
        chovEvents.map((e, i) => {
          const future = isUpcoming(e);
          return (
            <li
              class:list={[
                'grid gap-3 border-t border-ink/12 py-7 last:border-b sm:grid-cols-[auto_1fr_auto] sm:items-baseline sm:gap-8',
                !future && 'opacity-50',
              ]}
              data-reveal
              style={`--reveal-delay:${i * 70}ms`}
            >
              <div>
                <h2 class="font-display text-[1.375rem] leading-snug sm:text-[1.625rem]">
                  {e.title}
                </h2>
                {e.detail && (
                  <p class="mt-1.5 text-[0.875rem] text-ink-3">{e.detail}</p>
                )}
              </div>
              <span class="text-[0.9375rem] text-brass-700 sm:text-right">
                {formatLong(e.start)}
              </span>
            </li>
          );
        })
      }
    </ul>

    {
      upcoming.length === 0 && (
        <p class="mt-10 border border-ink/12 bg-white p-8 text-ink-3">
          {page.prazdno}
        </p>
      )
    }
  </Section>

  <Section tone="dark" space="lg" rise>
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-5">
        <SectionHead
          title={page.sekce.coMusiHrebecMit.title}
          lead={page.sekce.coMusiHrebecMit.lead}
          tone="light"
        />
      </div>

      <dl class="grid gap-x-10 gap-y-7 sm:grid-cols-2 lg:col-span-7">
        {
          requirements.map((r, i) => (
            <div class="border-t border-white/15 pt-4" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <dt class="flex items-center gap-3 font-display text-[1.25rem] text-white">
                <Icon name="check" class="h-4 w-4 text-brass-300" strokeWidth={2.2} />
                {r.title}
              </dt>
              <dd class="mt-3 text-[0.875rem] leading-relaxed text-white/60">{r.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Section>

  <Section tone="paper-2" space="md">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <h2 class="t-3">{page.cta.heading}</h2>
        <p class="mt-3 text-ink-3">{page.cta.lead}</p>
      </div>
      <div class="flex flex-wrap gap-3 lg:col-span-5 lg:justify-end">
        <a href={`tel:${site.phoneHref}`} class="btn btn-primary">
          <Icon name="phone" class="h-4 w-4" />
          {site.phone}
        </a>
        <a href="/kontakt" class="btn btn-outline">{page.cta.secondaryLabel}</a>
      </div>
    </div>
  </Section>
</PageLayout>
