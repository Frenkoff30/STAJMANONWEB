---
import PageLayout from '@/layouts/PageLayout.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';
import { events, formatLong, isUpcoming } from '@/data/events';

import heroImg from '@/assets/photos/pastvina-01.jpg';

const chovEvents = events
  .filter((e) => e.kind === 'chov')
  .sort((a, b) => a.start.localeCompare(b.start));

const upcoming = chovEvents.filter((e) => isUpcoming(e));

const requirements = [
  {
    title: 'Čip',
    text: 'Hřebeček musí být před nástupem označený čipem.',
  },
  {
    title: 'Průkaz koně',
    text: 'Vystavený průkaz koně přivezte s sebou.',
  },
  {
    title: 'Vakcinace',
    text: 'Rozvakcinování proti chřipce a tetanu. Pokud není hotové, zajistíme ho.',
  },
  {
    title: 'Odčervení',
    text: 'Provádíme hromadně pro všechny hřebečky v odchovně.',
  },
];
---

<PageLayout
  title="Testační odchovna hřebců"
  description="Testační odchovna hřebců — termíny jarního a podzimního třídění, zkoušek základního výcviku a naskladnění hřebečků. Podmínky pro nástup do odchovny."
  heading="Testační odchovna hřebců"
  lead="Termíny třídění, zkoušek a naskladnění pro rok 2026 a podmínky, které musí hřebeček před nástupem splnit."
  image={heroImg}
  imageAlt="Kůň na pastvině u areálu"
  crumbs={[{ label: 'Jezdectví' }, { label: 'Testační odchovna' }]}
>
  <Section tone="paper" space="lg">
    <SectionHead
      title="Kdy a kde"
      lead="Třídění probíhá v Pazuše, zkoušky základního výcviku v areálu JK Hřebčína Suchá."
    />

    <ul class="mt-10 space-y-px">
      {
        chovEvents.map((e, i) => {
          const future = isUpcoming(e);
          return (
            <li
              class:list={[
                'grid gap-3 border-t border-ink/12 py-7 last:border-b sm:grid-cols-[auto_1fr_auto] sm:items-baseline sm:gap-8',
                !future && 'opacity-50',
              ]}
              data-reveal
              style={`--reveal-delay:${i * 70}ms`}
            >
              <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h2 class="font-display text-[1.375rem] leading-snug sm:text-[1.625rem]">
                  {e.title}
                </h2>
                {e.detail && (
                  <p class="mt-1.5 text-[0.875rem] text-ink-3">{e.detail}</p>
                )}
              </div>
              <span class="text-[0.9375rem] text-brass-700 sm:text-right">
                {formatLong(e.start)}
              </span>
            </li>
          );
        })
      }
    </ul>

    {
      upcoming.length === 0 && (
        <p class="mt-10 border border-ink/12 bg-white p-8 text-ink-3">
          Termíny na další ročník právě připravujeme — sledujte kalendář akcí nebo se
          nám ozvěte.
        </p>
      )
    }
  </Section>

  <Section tone="dark" space="lg">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-5">
        <SectionHead
          title="Co musí hřebec mít"
          lead="Bez těchto náležitostí nelze hřebečka do testační odchovny přijmout."
          tone="light"
        />
      </div>

      <dl class="grid gap-px border border-white/12 bg-white/12 sm:grid-cols-2 lg:col-span-7">
        {
          requirements.map((r, i) => (
            <div class="bg-loden-950 p-7" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <dt class="flex items-center gap-3 font-display text-[1.25rem] text-white">
                <Icon name="check" class="h-4 w-4 text-brass-300" strokeWidth={2.2} />
                {r.title}
              </dt>
              <dd class="mt-3 text-[0.875rem] leading-relaxed text-white/60">{r.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Section>

  <Section tone="paper-2" space="md">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <h2 class="t-3">Máte dotaz k odchovně?</h2>
        <p class="mt-3 text-ink-3">
          Ozvěte se Jiřímu Skřivanovi — rád vám poradí s přípravou hřebečka i s
          termíny.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 lg:col-span-5 lg:justify-end">
        <a href={`tel:${site.phoneHref}`} class="btn btn-primary">
          <Icon name="phone" class="h-4 w-4" />
          {site.phone}
        </a>
        <a href="/kontakt" class="btn btn-outline">Kontakt</a>
      </div>
    </div>
  </Section>
</PageLayout>
