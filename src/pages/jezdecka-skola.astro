---
import { Image } from 'astro:assets';
import PageLayout from '@/layouts/PageLayout.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';
import { upcomingEvents } from '@/data/events';
import EventRow from '@/components/EventRow.astro';

import { photo } from '@/data/images';
import page from '@/obsah/stranky/jezdecka-skola.json';

const heroImg = photo(page.hero.image)!;
const lekceImg = photo(page.images.lekce)!;
const bezpecnostImg = photo(page.images.bezpecnost)!;

const nextGames = upcomingEvents()
  .filter((e) => e.kind === 'hry' || e.kind === 'zkousky')
  .slice(0, 3);

const steps = page.steps.map((x, i) => ({
  ...x,
  n: String(i + 1).padStart(2, '0'),
}));

const klubActivities = page.klubActivities;
---

<PageLayout
  title={page.seo.title}
  description={page.seo.description}
  heading={page.hero.heading}
  lead={page.hero.lead}
  image={heroImg}
  imageAlt={page.hero.imageAlt}
  crumbs={[{ label: 'Jezdectví' }, { label: 'Jezdecká škola' }]}
  nav={[
    { id: 'vyuka', label: 'Jak výuka probíhá' },
    { id: 'bezpecnost', label: 'Bezpečnost' },
    { id: 'cenik', label: 'Ceník' },
    { id: 'klub', label: 'Jezdecký klub' },
    { id: 'prihlaseni', label: 'Přihlášení' },
  ]}
>
  <!-- Jak to funguje -->
  <Section tone="paper" space="lg" id="vyuka">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-28">
          <SectionHead
            title={page.sekce.krokZaKrokemK.title}
            lead={page.sekce.krokZaKrokemK.lead}
          />
          <div class="mt-10 overflow-hidden" data-reveal>
            <Image
              src={lekceImg}
              alt={page.images.lekceAlt}
              widths={[400, 800, 1200, 1600]}
              sizes="(min-width: 1024px) 36vw, 100vw"
              class="aspect-[4/3] w-full object-cover"
            />
          </div>
        </div>
      </div>

      <ol class="lg:col-span-7">
        {
          steps.map((s, i) => (
            <li
              class="border-t border-ink/12 py-8 last:border-b"
              data-reveal
              style={`--reveal-delay:${i * 80}ms`}
            >
              <div>
                <h2 class="t-3">{s.title}</h2>
                <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-3">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <!-- Bezpečnost -->
  <Section tone="dark" space="lg" id="bezpecnost" rise>
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-14">
      <div class="lg:col-span-6">
        <div class="overflow-hidden" data-reveal>
          <Image
            src={bezpecnostImg}
            alt={page.images.bezpecnostAlt}
            widths={[640, 1024, 1600, 2000]}
            sizes="(min-width: 1024px) 45vw, 100vw"
            class="aspect-[4/3] w-full object-cover"
          />
        </div>
      </div>

      <div class="lg:col-span-6">
        <SectionHead
          title={page.sekce.naTomhleNesetrime.title}
          tone="light"
        />
        <p class="lead mt-6 text-white/70">{page.bezpecnostText}</p>

        <ul class="mt-10 space-y-3">
          {
            page.bezpecnostSeznam.map((t) => (
              <li class="flex gap-3 text-[0.9375rem] text-white/80">
                <Icon name="shield" class="mt-0.5 h-4 w-4 shrink-0 text-brass-300" />
                {t}
              </li>
            ))
          }
        </ul>

        <p class="mt-8 border-l-2 border-brass-500 pl-5 text-[0.9375rem] text-white/65">
          {page.bezpecnostNote}
        </p>
      </div>
    </div>
  </Section>

  <!-- Ceník -->
  <Section tone="paper" space="lg" id="cenik">
    <SectionHead title={page.sekce.cenik.title} lead={page.sekce.cenik.lead} />

    <ul class="mt-10 grid gap-x-10 gap-y-2 sm:grid-cols-3">
      {
        page.cenik.items.map((c, i) => (
          <li
            class="flex h-full flex-col border-t-2 border-ink/15 pt-5"
            data-reveal
            style={`--reveal-delay:${i * 80}ms`}
          >
            <h3 class="t-3">{c.title}</h3>
            <p class="mt-4 flex items-baseline gap-2">
              <span class="font-display text-[2rem] leading-none text-brass-700">{c.price}</span>
              <span class="text-[0.8125rem] text-ink-3">{c.note}</span>
            </p>
            <p class="mt-4 text-[0.9375rem] leading-relaxed text-ink-3">{c.text}</p>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 flex items-start gap-3 border-l-2 border-brass-500 pl-5 text-[0.9375rem] leading-relaxed text-ink-3">
      <Icon name="info" class="mt-0.5 h-4 w-4 shrink-0 text-brass-600" />
      <span>{page.cenik.note}</span>
    </p>
  </Section>

  <!-- Jezdecký klub -->
  <Section tone="paper-2" space="lg" id="klub">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-5">
        <SectionHead
          title={page.sekce.klubZaTimVsim.title}
          lead={page.sekce.klubZaTimVsim.lead}
        />
        {
          page.klubText.map((t, i) => (
            <p class:list={['prose-manon', i === 0 ? 'mt-8' : 'mt-4']}>{t}</p>
          ))
        }
      </div>

      <div class="lg:col-span-7">
        <ul class="grid gap-x-10 gap-y-5 sm:grid-cols-2">
          {
            klubActivities.map((a, i) => (
              <li
                class="flex items-start gap-4 border-t border-ink/12 pt-4"
                data-reveal
                style={`--reveal-delay:${Math.min(i * 50, 250)}ms`}
              >
                <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-brass-600" strokeWidth={2.2} />
                <span class="text-[0.9375rem] leading-relaxed text-ink-3">{a}</span>
              </li>
            ))
          }
        </ul>

        {
          nextGames.length > 0 && (
            <div class="mt-12">
              <div class="mt-5">
                {nextGames.map((e, i) => (
                  <EventRow event={e} index={i} />
                ))}
                <div class="border-t border-ink/12" />
              </div>
            </div>
          )
        }
      </div>
    </div>
  </Section>

  <!-- Navazující nabídka -->
  <Section tone="paper-2" space="md">
    <div class="grid gap-4 sm:grid-cols-3">
      {
        page.odkazy.map((c) => (
          <a href={c.href} class="group block border-t border-ink/12 pt-5">
            <h3 class="font-display text-[1.375rem] transition-colors group-hover:text-brass-700">
              {c.title}
            </h3>
            <p class="mt-2 text-[0.875rem] text-ink-3">{c.text}</p>
            <span class="link-arrow mt-6">
              Zobrazit
              <Icon name="arrow-right" class="h-3.5 w-3.5" />
            </span>
          </a>
        ))
      }
    </div>
  </Section>

  <!-- Kontakt -->
  <Section tone="loden" space="md" id="prihlaseni">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <h2 class="t-2 text-white">{page.cta.heading}</h2>
        <p class="lead mt-5 text-white/70">{page.cta.lead}</p>
      </div>
      <div class="lg:col-span-5 lg:text-right">
        <a href={`tel:${site.contacts[1]!.phoneHref}`} class="btn btn-brass">
          <Icon name="phone" class="h-4 w-4" />
          {site.contacts[1]!.phone}
        </a>
      </div>
    </div>
  </Section>
</PageLayout>
