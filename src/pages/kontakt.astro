---
import PageLayout from '@/layouts/PageLayout.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import ContactForm from '@/components/ContactForm.astro';
import Map from '@/components/Map.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';

import heroImg from '@/assets/photos/terasa-02.jpg';
---

<PageLayout
  title="Kontakt"
  description="Kontakt na Stáj Manon a Areál Jízdárna Suchá — Suchá 1, 570 01 Suchá u Litomyšle. Telefony, e-maily a kontaktní formulář."
  heading="Kontakt"
  lead="Suchá 1, tři kilometry od Litomyšle. Zavolejte, napište nebo přijeďte — nejlépe o víkendu, kdy se u nás závodí."
  image={heroImg}
  imageAlt="Terasa a zázemí areálu Jízdárna Suchá"
  crumbs={[{ label: 'Kontakt' }]}
  nav={[
    { id: 'kontakty', label: 'Kontakty' },
    { id: 'mapa', label: 'Kudy k nám' },
  ]}
>
  <!-- Kontakty -->
  <Section tone="paper" space="lg" id="kontakty">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-5">
        <SectionHead title="Kontakty" />

        <div class="mt-10 space-y-px">
          {
            site.contacts.map((c, i) => (
              <div
                class="border-t border-ink/12 py-7 last:border-b"
                data-reveal
                style={`--reveal-delay:${i * 70}ms`}
              >
                <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-brass-700">
                  {c.role}
                </p>
                <p class="mt-3 font-display text-[1.5rem]">{c.name}</p>
                <div class="mt-4 flex flex-col gap-2">
                  <a
                    href={`tel:${c.phoneHref}`}
                    class="inline-flex items-center gap-3 text-[1.0625rem] transition-colors hover:text-brass-700"
                  >
                    <Icon name="phone" class="h-4 w-4 text-brass-600" />
                    {c.phone}
                  </a>
                  <a
                    href={`mailto:${c.email}`}
                    class="inline-flex items-center gap-3 text-[0.9375rem] text-ink-3 transition-colors hover:text-brass-700"
                  >
                    <Icon name="mail" class="h-4 w-4 text-brass-600" />
                    {c.email}
                  </a>
                </div>
              </div>
            ))
          }
        </div>

        <address class="mt-10 not-italic" data-reveal>
          <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-brass-700">
            Adresa
          </p>
          <p class="mt-3 font-display text-[1.5rem]">Areál Jízdárna Suchá</p>
          <p class="mt-2 text-[1.0625rem] leading-relaxed text-ink-3">
            {site.address.street}<br />
            {site.address.zip}&nbsp;{site.address.city}
          </p>
          <a
            href={site.address.directionsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="link-arrow mt-5"
          >
            Navigovat
            <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
          </a>
        </address>

        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href={site.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline"
          >
            <Icon name="facebook" class="h-4 w-4" />
            Facebook
          </a>
          <a
            href={site.social.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline"
          >
            <Icon name="youtube" class="h-4 w-4" />
            YouTube
          </a>
        </div>
      </div>

      <div class="lg:col-span-7">
        <ContactForm />
      </div>
    </div>
  </Section>

  <!-- Mapa -->
  <Section tone="paper-2" space="md" id="mapa">
    <SectionHead
      title="Najdete nás tři kilometry od Litomyšle"
      lead="Parkování je přímo v areálu. Pro navigaci zadejte „Jízdárna Suchá, Suchá 1“."
    />
    <Map class="mt-10" />
  </Section>

  <!-- Rychlé odkazy -->
  <Section tone="dark" space="md">
    <div class="grid gap-px border border-white/12 bg-white/12 sm:grid-cols-2 lg:grid-cols-4">
      {
        [
          { t: 'Rezervace ubytování', d: site.emailPenzion, href: `mailto:${site.emailPenzion}` },
          { t: 'Kurzy a pobyty', d: '+420 606 836 449', href: 'tel:+420606836449' },
          { t: 'Ustájení a sport', d: '+420 602 451 918', href: 'tel:+420602451918' },
          { t: 'Kalendář akcí', d: 'Sezóna 2026', href: '/akce' },
        ].map((x, i) => (
          <a
            href={x.href}
            class="group bg-loden-950 p-7 transition-colors hover:bg-loden-900"
            data-reveal
            style={`--reveal-delay:${i * 60}ms`}
          >
            <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-brass-300">
              {x.t}
            </p>
            <p class="mt-3 break-words text-[1.0625rem] text-white transition-colors group-hover:text-brass-300">
              {x.d}
            </p>
          </a>
        ))
      }
    </div>
  </Section>
</PageLayout>
