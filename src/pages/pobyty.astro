---
/**
 * Pobyty s výukou. Jednotlivé pobyty se zakládají ve Správě webu jako akce
 * druhu „Pobyt s výukou“ (termín, popis, cena, přihláška). Texty kolem
 * stránky jsou v redakci. Stránka čte pobyty z databáze při zobrazení.
 */

export const prerender = false;

import { Image } from 'astro:assets';
import PageLayout from '@/layouts/PageLayout.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';
import { isUpcoming } from '@/data/events';
import { CACHE_KALENDARE } from '@/lib/kalendar';
import { prihlaskyNastaveny, verejnyKlient, type Akce } from '@/lib/prihlasky/db';
import { kc, terminAkce } from '@/lib/prihlasky/platba';

import { photo } from '@/data/images';
import page from '@/obsah/stranky/pobyty.json';

const heroImg = photo(page.hero.image)!;

Astro.response.headers.set('Cache-Control', CACHE_KALENDARE);

let pobyty: Akce[] = [];
if (prihlaskyNastaveny) {
  const { data } = await verejnyKlient()
    .from('akce')
    .select('*')
    .eq('druh', 'pobyt')
    .order('zacatek', { ascending: true });
  pobyty = ((data as Akce[] | null) ?? []).filter((a) =>
    isUpcoming({ start: a.zacatek, end: a.konec, title: a.nazev, kind: 'pobyt' }),
  );
}

/** Pobyt ze správy v podobě, jakou stránka vykresluje. */
const stays = pobyty.map((a) => {
  const [hlavni, ...dalsi] = a.varianty ?? [];
  return {
    slug: a.kod,
    title: a.nazev,
    subtitle: a.podtitul,
    dateLabel: terminAkce(a),
    description: a.popis || a.podtitul,
    radky: [
      { k: 'Příjezd', v: a.nastup, icon: 'clock' as const },
      { k: 'Odjezd', v: a.odjezd, icon: 'clock' as const },
      { k: 'Pro koho', v: a.vek_od ? `děti od ${a.vek_od} let` : '', icon: 'horse' as const },
    ].filter((r) => r.v),
    price: hlavni ? kc(hlavni.cena) : '',
    priceNotes: [
      ...dalsi.map((v) => `${v.nazev} za ${kc(v.cena)}`),
      ...(a.priplatky ?? []).map((p) => `${p.nazev}: příplatek ${kc(p.cena)}`),
    ],
    prihlaska: a.prihlasovani && a.otevreno ? a.kod : undefined,
  };
});

/** Do lepicí lišty se dlouhý název nevejde: „Velikonoční pobyt s výukou jízdy
    na koni" zkrátíme na „Velikonoční pobyt". */
const kratkyNazev = (t: string) => t.split(/\s+s[e]?\s+/)[0]!;

const images = page.images
  .map((name) => photo(name))
  .filter((img): img is NonNullable<typeof img> => Boolean(img));
---

<PageLayout
  title={page.seo.title}
  heading={page.hero.heading}
  description={page.seo.description}
  lead={page.hero.lead}
  image={heroImg}
  imageAlt={page.hero.imageAlt}
  crumbs={[{ label: 'Jezdectví' }, { label: 'Pobyty s výukou' }]}
  nav={[
    ...stays.map((s) => ({ id: s.slug, label: kratkyNazev(s.title) })),
    { id: 'prihlaseni', label: 'Jak se přihlásit' },
  ]}
>
  <Section tone="paper" space="lg">
    <SectionHead
      title={page.sekce.dvaTerminyMimoPrazdniny.title}
      lead={page.sekce.dvaTerminyMimoPrazdniny.lead}
    />

    {
      stays.length === 0 && (
        <p class="mt-9 border border-ink/12 bg-white p-8 text-ink-3">
          Další pobyty právě plánujeme. Napište nám na{' '}
          <a href={`mailto:${site.email}`} class="link-underline text-brass-700">
            {site.email}
          </a>{' '}
          a dáme vědět, až budou termíny.
        </p>
      )
    }

    <div class="mt-9 space-y-10">
      {
        stays.map((s, i) => (
          <article
            id={s.slug}
            class="grid gap-10 lg:grid-cols-12 lg:gap-16"
            data-reveal
          >
            <div class={i % 2 === 0 ? 'lg:col-span-5' : 'lg:order-2 lg:col-span-5'}>
              <div class="overflow-hidden">
                <Image
                  src={images[i % images.length]!}
                  alt={`Ilustrační foto k pobytu ${s.title}`}
                  widths={[400, 800, 1200, 1600]}
                  sizes="(min-width: 1024px) 38vw, 100vw"
                  class="aspect-[3/2] w-full object-cover"
                />
              </div>
            </div>

            <div class={i % 2 === 0 ? 'lg:col-span-7' : 'lg:order-1 lg:col-span-7'}>
              <h2 class="t-2">{s.title}</h2>
              <p class="mt-5 font-display text-[1.5rem] text-brass-700">{s.dateLabel}</p>

              <p class="prose-manon mt-6">{s.description}</p>

              <dl class="mt-10 grid gap-x-10 gap-y-5 sm:grid-cols-2">
                {s.radky.map((row) => (
                  <div class="flex items-start gap-4 border-t border-ink/12 pt-4">
                    <Icon name={row.icon} class="mt-0.5 h-5 w-5 shrink-0 text-brass-600" />
                    <div>
                      <dt class="text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-ink-3/70">
                        {row.k}
                      </dt>
                      <dd class="mt-1 text-[0.9375rem] text-ink">{row.v}</dd>
                    </div>
                  </div>
                ))}
              </dl>

              <div class="mt-10 flex flex-col gap-6 border-t border-ink/12 pt-8 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-ink-3/70">
                    Cena
                  </p>
                  <p class="mt-1.5 font-display text-[1.5rem] leading-none">{s.price || 'Na dotaz'}</p>
                  <ul class="mt-4 space-y-1.5">
                    {s.priceNotes.map((n) => (
                      <li class="flex gap-3 text-[0.875rem] text-ink-3">
                        <span class="mt-2.5 h-px w-3 shrink-0 bg-brass-600" />
                        {n}
                      </li>
                    ))}
                  </ul>
                </div>

                <a
                  href={
                    s.prihlaska
                      ? `/prihlaska/${s.prihlaska}`
                      : `mailto:${site.email}?subject=${encodeURIComponent(s.title)}`
                  }
                  class="btn btn-primary shrink-0"
                >
                  {s.prihlaska ? 'Vyplnit přihlášku' : 'Zeptat se na volná místa'}
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  <Section tone="loden" space="md" id="prihlaseni">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <h2 class="t-2 text-white">{page.cta.heading}</h2>
        <p class="lead mt-5 text-white/70">{page.cta.lead}</p>
      </div>
      <div class="flex flex-wrap gap-3 lg:col-span-5 lg:justify-end">
        <a href={`mailto:${site.email}`} class="btn btn-brass">
          <Icon name="mail" class="h-4 w-4" />
          {site.email}
        </a>
        <a href="/kurzy" class="btn btn-ghost-light">{page.cta.secondaryLabel}</a>
      </div>
    </div>
  </Section>
</PageLayout>
