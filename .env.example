# Kam odesílá kontaktní formulář.
#
# Nevyplněno = použije se /kontakt-odeslat.php, tedy PHP skript v public/.
# To je varianta pro cílový hosting stáje.
#
# Na Vercelu / Netlify PHP neběží — nastavte adresu formulářové služby.
# Příklad pro Web3Forms (zdarma, klíč získáte na web3forms.com):
#
# PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
# PUBLIC_FORM_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

PUBLIC_FORM_ENDPOINT=
PUBLIC_FORM_ACCESS_KEY=
