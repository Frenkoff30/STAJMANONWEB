# ---------------------------------------------------------------- formulář
#
# Kontaktní formulář posílá zprávy přes Resend — stejný klíč a odesílatel
# jako e-maily k přihláškám (RESEND_API_KEY, PRIHLASKY_EMAIL_OD níže).
# Zprávy chodí na PRIHLASKY_EMAIL_STAJ (nevyplněno = e-mail stáje z nastavení).

# -------------------------------------------------------- redakční systém
#
# Lokálně (npm run dev) se nic z toho nevyplňuje — administrace na
# http://localhost:4321/keystatic zapisuje rovnou na disk.
#
# Na produkci se přihlašuje přes GitHub. Hodnoty vygeneruje průvodce na
# https://www.stajmanon.cz/keystatic/setup — ten založí GitHub App a vypíše,
# co nastavit ve Vercelu v Settings → Environment Variables.

KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# ------------------------------------------------------- rezervace jízdáren
#
# Databáze a přihlašování běží na Supabase (supabase.com, zdarma).
# Hodnoty najdete v projektu: Settings → API.
#
# Bez nich se stránka /rezervace jen omluví, že se systém spouští.
# Zbytek webu funguje dál.
#
# SUPABASE_URL      = Project URL, např. https://abcdefgh.supabase.co
# SUPABASE_ANON_KEY = klíč „anon / public" (je určený k veřejnému použití,
#                     co s ním kdo smí, hlídají pravidla v supabase/schema.sql)

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Servisní klíč (Settings → API → service_role). Obchází všechna pravidla RLS,
# proto ho nastavte JEN ve Vercelu a nikdy nikam nekopírujte — do prohlížeče se
# nesmí dostat. Potřebný je k jediné věci: úplnému smazání člena v administraci
# rezervací (smaže účet i s jeho rezervacemi).
#
# Nevyplněno = tlačítko „Smazat" se v administraci vůbec neukáže, pozastavení
# členů funguje dál.

SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------- přihlášky na tábory
#
# Samostatný systém, databáze je v supabase/prihlasky.sql.
#
# Nevyplněno = přihlášky použijí stejný projekt Supabase jako rezervace
# (SUPABASE_URL a SUPABASE_ANON_KEY výše). Vyplňte jen tehdy, když mají
# běžet v jiném projektu.

PRIHLASKY_SUPABASE_URL=
PRIHLASKY_SUPABASE_ANON_KEY=

# E-maily rodičům a stáji posílá Resend (resend.com, pro tenhle objem zdarma).
# Bez klíče se přihlášky ukládají dál, jen se místo odeslání ukáže ukázka
# e-mailu. Adresa odesílatele musí být na doméně ověřené v Resendu.
#
# PRIHLASKY_EMAIL_OD    = Stáj Manon <prihlasky@stajmanon.cz>
# PRIHLASKY_EMAIL_STAJ  = kam chodí upozornění na nové přihlášky a kam
#                         rodiče odpovídají (nevyplněno = e-mail z nastavení webu)

RESEND_API_KEY=
PRIHLASKY_EMAIL_OD=
PRIHLASKY_EMAIL_STAJ=
